#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cd "$root"
case ${1:-} in
  help|--help|-h) printf '%s\n' 'usage: sh sync [plan|doctor|links|tools NAME...|list|bridge|uninstall|check|check-parallel|layers]'; exit 0 ;;
esac

home=${HOME:?HOME is required}
state=${DL_OWNED_FILE:-${XDG_STATE_HOME:-$home/.local/state}/sync/dl-owned}
legacy=${XDG_STATE_HOME:-$home/.local/state}/make/dl-owned
case ${1:-} in
  plan|doctor|check|check-parallel|layers) ;;
  *)
    if [ -z "${DL_OWNED_FILE:-}" ] && [ ! -e "$state" ] && [ -f "$legacy" ]; then
      mkdir -p "$(dirname -- "$state")"
      mv "$legacy" "$state"
    fi
    ;;
esac

python=$home/.local/bin/python3
if [ ! -x "$python" ]; then
  python=$(command -v python3 || :)
fi
case $(uname -s) in
  Darwin)
    case ${1:-} in
      plan|doctor|check|check-parallel|layers|uninstall|links|list) ;;
      *)
        if [ ! -x "$home/.local/bin/python3" ]; then
          mkdir -p "$(dirname -- "$state")" "$root/.work/tmp"
          DL_OWNED_FILE="$state" sh "$root/tools/sync/bootstrap.sh" jaq
          DL_OWNED_FILE="$state" sh "$root/tools/sync/bootstrap.sh" python3
          python=$home/.local/bin/python3
        fi
        ;;
    esac
    ;;
esac
[ -n "$python" ] && [ -x "$python" ] || {
  printf '%s\n' 'sync: Python 3.9+ is required. macOS bootstraps python-build automatically; Alpine bootstrap is deferred (USR-24).' >&2
  exit 1
}
exec "$python" -I "$root/tools/sync/main.py" "$@"
