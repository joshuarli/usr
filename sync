#!/bin/sh
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cd "$root"
show_help() {
  cat <<'EOF'
Usage: sh sync [COMMAND] [OPTIONS]
Reconcile the home configuration and managed tools; omitting COMMAND runs apply.

Commands:
  sh sync apply [--all] [--json]
    Reconcile the full home (also the default with no command).
  sh sync plan [--all] [--json]
    Preview the full reconciliation and conflicts.
  sh sync doctor [--all] [--json]
    Inspect task postconditions and environment diagnostics.
  sh sync links [--all] [--json]
    Reconcile layer links only.
  sh sync tools [NAME...] [--all] [--json]
    Install or update named tools and prerequisites; no names selects defaults.
    NAME...  Optional, repeated tool names; see list for the defaults.
  sh sync bridge [--all] [--json]
    Reconcile bridge registrations and their prerequisites.
  sh sync list
    List default tools for this host and profile.
  sh sync launchers [NAME...]
    List executable names for each optional, repeated tool name.
  sh sync uninstall
    Remove sync-managed installations and registrations.
  sh sync check [--plan|--changed] [--json] [--base REV]
    Run the check suite, or select checks for changed files.
    --plan     Show selected checks without running them.
    --changed  Run selected checks for changed files.
    --json     Output the selected plan or results as JSON (requires a mode).
    --base REV Include changes since revision REV (requires a mode).
  sh sync check docs [--check]
    Generate the development checks table; --check verifies it instead.
  sh sync check-parallel
    Run the Python checks in parallel.
  sh sync layers
    Check the active layers for duplicate link owners.
  sh sync hosts [pull|plan|doctor|apply] [HOST...] [--all]
    Run a fleet operation on hosts in the tailnet policy; default is plan.
    HOST...  Optional, repeated host names; default is all policy hosts.
    --all    Show all tasks in host results.
  sh sync hosts pull [HOST...] [--all]
    Fetch and fast-forward each selected host's main branch.
  sh sync hosts plan [HOST...] [--all]
    Fetch and preview reconciliation on selected hosts.
  sh sync hosts doctor [HOST...] [--all]
    Fetch and inspect selected hosts.
  sh sync hosts apply [HOST...] [--all]
    Update and reconcile selected hosts.

Options for apply, plan, doctor, links, tools, and bridge:
  --all   Show every task, including up-to-date tasks.
  --json  Output one machine-readable JSON object.
  -h, --help  Show this reference; also available after a command.

Environment:
  HOME            Required absolute home directory for tools and default target.
  TARGET          Absolute link destination; defaults to HOME. Apply, tools,
                  bridge, and uninstall require it to equal HOME.
  XDG_STATE_HOME  State directory; defaults to HOME/.local/state.
  DL_OWNED_FILE   Override the ownership record path.
  DL_PROFILE      Select the host profile; defaults to /etc/home/install-mode.
  SYNC_JOBS       Maximum concurrent tasks; defaults to the CPU count.
  NO_COLOR        Disable terminal color.

Examples:
  sh sync apply --all
  sh sync plan --json
  sh sync doctor
  sh sync links
  sh sync tools python3
  sh sync bridge
  sh sync list
  sh sync launchers nodejs
  sh sync uninstall
  sh sync check
  sh sync check --plan --base HEAD
  sh sync check --changed --json
  sh sync check docs --check
  sh sync check-parallel
  sh sync layers
  sh sync hosts
  sh sync hosts pull
  sh sync hosts plan --all
  sh sync hosts doctor
  sh sync hosts apply
EOF
}
case ${1:-} in
  help|--help|-h) show_help; exit 0 ;;
  apply|plan|doctor|links|tools|bridge|list|launchers|uninstall|check|check-parallel|layers|hosts)
    for arg do
      case $arg in -h|--help) show_help; exit 0 ;; esac
    done
    ;;
esac

home=${HOME:?HOME is required}
state=${DL_OWNED_FILE:-${XDG_STATE_HOME:-$home/.local/state}/sync/dl-owned}
legacy=${XDG_STATE_HOME:-$home/.local/state}/make/dl-owned
case ${1:-} in
  plan|doctor|check|check-parallel|layers|hosts) ;;
  *)
    if [ -z "${DL_OWNED_FILE:-}" ] && [ ! -e "$state" ] && [ -f "$legacy" ]; then
      mkdir -p "$(dirname -- "$state")"
      mv "$legacy" "$state"
    fi
    ;;
esac

# The smoke test runs a subprocess: a python-build release built for a newer
# macOS starts, but crashes in os.pipe on the first subprocess it spawns.
# Importing the executor rejects interpreters that lack APIs it needs.
smoke='import sqlite3, ssl, subprocess, sys; subprocess.run(["/bin/sh", "-c", ":"], check=True); sys.path.insert(0, sys.argv[1]); import main'
choose_python() {
  for candidate in "$home/.local/bin/python3" "$(command -v python3 || :)" /usr/bin/python3; do
    if [ -n "$candidate" ] && [ -x "$candidate" ] && "$candidate" -I -c "$smoke" "$root/tools/sync" >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return
    fi
  done
}
python=$(choose_python)
case $(uname -s) in
  Darwin)
    case ${1:-} in
      plan|doctor|check|check-parallel|layers|uninstall|links|list|hosts) ;;
      *)
        if [ ! -x "$home/.local/bin/python3" ]; then
          mkdir -p "$(dirname -- "$state")" "$root/.work/tmp"
          DL_OWNED_FILE="$state" sh "$root/tools/sync/bootstrap.sh" jaq
          DL_OWNED_FILE="$state" sh "$root/tools/sync/bootstrap.sh" python3 || :
          python=$(choose_python)
        fi
        ;;
    esac
    ;;
  Linux)
    case ${1:-} in
      plan|doctor|check|check-parallel|layers|uninstall|links|list|hosts) ;;
      *)
        if [ ! -x "$home/.local/bin/python3" ] && [ -z "$python" ] \
          && awk -F= '$1 == "ID" { gsub(/^"/, "", $2); gsub(/"$/, "", $2); print $2; exit }' /etc/os-release 2>/dev/null | grep -qx alpine; then
          mkdir -p "$(dirname -- "$state")" "$root/.work/tmp"
          DL_OWNED_FILE="$state" sh "$root/tools/sync/bootstrap.sh" python3 || :
          python=$(choose_python)
        fi
        ;;
    esac
    ;;
esac
[ -n "$python" ] && [ -x "$python" ] || {
  printf '%s\n' 'sync: no working Python 3.9+ that can import tools/sync/main.py found. macOS and Alpine bootstrap the pinned python-build automatically, but it needs a host OS at least as new as the one it was built for; otherwise provide an existing Python 3.9+ (Debian or Ubuntu: apt-get install python3).' >&2
  exit 1
}
exec "$python" -I "$root/tools/sync/main.py" "$@"
