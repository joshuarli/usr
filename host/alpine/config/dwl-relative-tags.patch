+void
+viewrelative(const Arg *arg)
+{
+	uint32_t tags;
+	int i;
+
+	if (!selmon)
+		return;
+	tags = selmon->tagset[selmon->seltags] & TAGMASK;
+	for (i = 0; i < TAGCOUNT; i++)
+		if (tags & (1u << i))
+			break;
+	if (i == TAGCOUNT)
+		return;
+	i = ((i + arg->i) % TAGCOUNT + TAGCOUNT) % TAGCOUNT;
+	view(&(Arg){.ui = 1u << i});
 }
 
