#!/bin/sh
# setup-macos - provision a Mac: Homebrew, packages, Touch ID for sudo, a local DNS cache.
#
# Safe to rerun. Every step reads the current state and changes only what differs.
#
# usage: setup-macos [-n] [STEP...]
#   -n      report what would change and change nothing
#   STEP    brew        install Homebrew if missing
#           packages    install the packages listed in macos/Brewfile
#           touchid     Touch ID for sudo, working inside tmux
#           dns         unbound as a local caching resolver, and point the system at it
#                       To undo: networksetup -setdnsservers SERVICE Empty
#   With no STEP the default is: brew packages touchid dns, in that order. Packages come
#   first because touchid and dns use what they install, and touchid comes before dns so
#   that later sudo prompts accept a fingerprint.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
dry=false

info() { printf '\033[1;32m==> \033[0m%s\n' "$*"; }
warn() { printf '\033[1;33mwarn:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31merr:\033[0m %s\n' "$*" >&2; exit 1; }

# act CMD...  Run a command, or in a dry run only say so.
act() {
    if $dry; then printf '   would run: %s\n' "$*"; else "$@"; fi
}

# need_sudo  Ask for the password once, up front, before a step that needs it.
need_sudo() {
    $dry || sudo -v
}

# ── steps ─────────────────────────────────────────────────────────────────────
find_brew() {
    for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$b" ]; then eval "$("$b" shellenv)"; return 0; fi
    done
    return 1
}

step_brew() {
    if find_brew; then
        info "Homebrew is installed"
        return
    fi
    info "Installing Homebrew (the official installer; it asks for your password)"
    if $dry; then
        printf '   would run: Homebrew install.sh\n'
        return
    fi
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    find_brew || die "Homebrew installed but brew was not found"
}

step_packages() {
    find_brew || die "Homebrew is missing; run: setup-macos brew"
    if brew bundle check --file="$here/Brewfile" >/dev/null 2>&1; then
        info "Packages are installed"
        return
    fi
    info "Installing packages"
    if $dry; then
        brew bundle check --file="$here/Brewfile" --verbose 2>&1 | sed 's/^/   /' || true
        return
    fi
    brew bundle --file="$here/Brewfile"
}

# The module is copied out of Homebrew's tree because root's sudo loads it, and everything
# under /opt/homebrew is writable by the user: whoever could replace the module could get
# root. Every directory above /usr/local/libexec is root-owned.
pam_dir=/usr/local/libexec/pam
pam_module=$pam_dir/pam_reattach.so
sudo_local=/etc/pam.d/sudo_local

pam_tid_module() {
    for module in /usr/lib/pam/pam_tid.so /usr/lib/pam/pam_tid.so.2; do
        if [ -f "$module" ]; then printf '%s' "$module"; return 0; fi
    done
    return 1
}

sudo_local_wanted() {
    printf 'auth       optional       %s\n' "$pam_module"
    printf 'auth       sufficient     %s\n' "$tid_module"
}

# sudo_local_state  Print ok, absent, or a foreign line we refuse to overwrite.
sudo_local_state() {
    [ -f "$sudo_local" ] || { printf 'absent'; return; }
    active=$(grep -Ev '^[[:space:]]*(#|$)' "$sudo_local" || true)
    foreign=$(printf '%s\n' "$active" | grep -Ev 'pam_reattach\.so|pam_tid\.so' || true)
    if [ -n "$foreign" ]; then printf 'foreign: %s' "$foreign"; return; fi
    if [ "$active" = "$(sudo_local_wanted)" ]; then printf 'ok'; else printf 'stale'; fi
}

step_touchid() {
    find_brew || die "Homebrew is missing; run: setup-macos brew"
    tid_module=$(pam_tid_module) || die "Touch ID PAM module not found in /usr/lib/pam"
    src="$(brew --prefix)/lib/pam/pam_reattach.so"
    [ -f "$src" ] || die "$src not found; run: setup-macos packages"

    if [ "$(stat -f '%Su:%Sg %Lp' "$pam_module" 2>/dev/null)" = "root:wheel 755" ] && cmp -s "$src" "$pam_module"; then
        info "pam_reattach is installed at $pam_module"
    else
        info "Installing pam_reattach at $pam_module (root-owned)"
        need_sudo
        act sudo install -d -o root -g wheel -m 755 "$pam_dir"
        act sudo install -o root -g wheel -m 755 "$src" "$pam_module"
    fi

    case $(sudo_local_state) in
        ok) info "Touch ID for sudo is configured" ;;
        foreign:*) die "$sudo_local has lines this script does not manage; merge by hand: $(sudo_local_state)" ;;
        *)
            info "Writing $sudo_local"
            need_sudo
            if $dry; then
                printf '   would write:\n'; sudo_local_wanted | sed 's/^/     /'
            else
                sudo_local_wanted | sudo tee "$sudo_local" >/dev/null
            fi
            ;;
    esac
}

resolver_answers() {
    [ -n "$(dig +time=2 +tries=1 +short @127.0.0.1 example.com 2>/dev/null)" ]
}

# network_services  Print the names of the enabled network services, one per line.
network_services() {
    networksetup -listallnetworkservices | tail -n +2 | grep -v '^\*' || true
}

# dns_servers SERVICE  Print the service's DNS servers on one line, or Empty.
dns_servers() {
    out=$(networksetup -getdnsservers "$1")
    case $out in
        *"aren't any"*) printf 'Empty' ;;
        *) printf '%s' "$out" | tr '\n' ' ' | sed 's/ $//' ;;
    esac
}

dns_wanted='127.0.0.1'

ensure_macos_unbound_account() {
    user=$1
    case $user in
        ''|*[!A-Za-z0-9_-]*) die "invalid Unbound account name: $user" ;;
    esac

    uid=$(dscl . -list /Users UniqueID | awk -v account="$user" '$1 == account { print $2; exit }')
    if [ -n "$uid" ]; then
        shell=$(dscl . -read "/Users/$user" UserShell | sed 's/^UserShell: //')
        case $uid in *[!0-9]*) die "invalid uid for Unbound account $user" ;; esac
        [ "$uid" -gt 0 ] && [ "$uid" -lt 500 ] && [ "$shell" = /usr/bin/false ] \
            || die "existing account $user is not an unprivileged service account"
        return
    fi

    if $dry; then
        account_will_be_created=true
        info "Would create the Unbound service account $user"
        return
    fi

    uid=$(dscl . -list /Users UniqueID | awk '$2 ~ /^[0-9]+$/ { used[$2] = 1 } END { for (candidate = 300; candidate < 500; candidate++) if (!(candidate in used)) { print candidate; exit } }')
    [ -n "$uid" ] || die "no free macOS service uid between 300 and 499"
    info "Creating the Unbound service account $user"
    sudo /bin/sh -c '
        set -eu
        user=$1
        uid=$2
        /usr/bin/dscl . -create "/Users/$user"
        /usr/bin/dscl . -create "/Users/$user" RealName "Unbound DNS"
        /usr/bin/dscl . -create "/Users/$user" UniqueID "$uid"
        /usr/bin/dscl . -create "/Users/$user" PrimaryGroupID 1
        /usr/bin/dscl . -create "/Users/$user" NFSHomeDirectory /var/empty
        /usr/bin/dscl . -create "/Users/$user" UserShell /usr/bin/false
        /usr/bin/dscl . -create "/Users/$user" Password "*"
        /usr/bin/dscl . -create "/Users/$user" IsHidden 1
    ' setup-macos "$user" "$uid"
    [ "$(id -u "$user")" = "$uid" ] || die "failed to create the Unbound account $user"
}

step_dns() {
    find_brew || die "Homebrew is missing; run: setup-macos brew"
    conf_dir="$(brew --prefix)/etc/unbound"
    conf=$conf_dir/unbound.conf
    [ -d "$conf_dir" ] || die "$conf_dir not found; run: setup-macos packages"
    conf_source=$here/../dns/unbound.conf
    [ -f "$conf_source" ] || die "shared Unbound config is missing: $conf_source"

    new=$(mktemp "${TMPDIR:-/tmp}/unbound.conf.XXXXXX")
    trap 'rm -f "$new"' 0
    cp "$conf_source" "$new"
    unbound_user=$(unbound-checkconf -o username "$new")
    [ -n "$unbound_user" ] || die "Unbound has no privilege-drop account configured"
    account_will_be_created=false
    ensure_macos_unbound_account "$unbound_user"
    if $account_will_be_created; then
        info "Would validate the config after creating $unbound_user"
    else
        unbound-checkconf "$new"
    fi
    unbound_chroot=$(unbound-checkconf -o chroot "$new")
    if [ -n "$unbound_chroot" ]; then
        info "Unbound will run as $unbound_user with chroot $unbound_chroot"
    else
        info "Unbound will run as $unbound_user without a package chroot"
    fi

    changed=false
    if cmp -s "$new" "$conf"; then
        info "unbound.conf is up to date"
    else
        changed=true
        info "Writing $conf"
        act cp "$new" "$conf"
    fi

    if $changed || ! resolver_answers; then
        info "Restarting unbound"
        need_sudo
        act sudo brew services restart unbound
        if ! $dry; then
            tries=0
            until resolver_answers; do
                tries=$((tries + 1))
                [ "$tries" -lt 10 ] || die "unbound is not answering on 127.0.0.1; check: sudo brew services list"
                sleep 1
            done
        fi
    else
        info "unbound is running and answering"
    fi

    services_to_update=$(network_services | while IFS= read -r svc; do
        have=$(dns_servers "$svc")
        [ "$have" = "$dns_wanted" ] || printf '%s\n' "$svc"
    done; :)
    [ -n "$services_to_update" ] || return

    if $dry; then
        printf '%s\n' "$services_to_update" | while IFS= read -r svc; do
            [ -n "$svc" ] || continue
            have=$(dns_servers "$svc")
            [ "$have" = "$dns_wanted" ] && continue
            info "DNS for $svc: $have -> $dns_wanted"
            act sudo networksetup -setdnsservers "$svc" "$dns_wanted"
        done
    else
        printf '%s\n' "$services_to_update" | sudo /bin/sh -c '
            set -eu
            dns_wanted=$1
            while IFS= read -r svc; do
                [ -n "$svc" ] || continue
                out=$(networksetup -getdnsservers "$svc")
                case $out in
                    *"any DNS Servers set on"*) have=Empty ;;
                    *) have=$(printf "%s" "$out" | tr "\n" " " | sed "s/ $//") ;;
                esac
                [ "$have" = "$dns_wanted" ] && continue
                printf "\\033[1;32m==> \\033[0mDNS for %s: %s -> %s\\n" "$svc" "$have" "$dns_wanted"
                networksetup -setdnsservers "$svc" "$dns_wanted"
            done
        ' setup-macos "$dns_wanted"
    fi
}

# ── main ──────────────────────────────────────────────────────────────────────
[ "$(uname -s)" = Darwin ] || die "macOS only"

if [ "${1:-}" = -n ]; then dry=true; shift; fi

if [ $# -eq 0 ]; then
    set -- brew packages touchid dns
fi

for step in "$@"; do
    case $step in
        brew|packages|touchid|dns) ;;
        *) die "unknown step: $step (see the usage at the top of this script)" ;;
    esac
done

while [ $# -gt 0 ]; do
    step=$1; shift
    case $step in
        brew)       step_brew ;;
        packages)   step_packages ;;
        touchid)    step_touchid ;;
        dns)        step_dns ;;
    esac
done
