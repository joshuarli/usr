install_codex() {
    if installed codex && ! codex_launcher_is_legacy_dl; then
        printf '%s\n' 'codex is installed'
        return
    fi
    if ! jaq_available; then
        install_jaq
        if ! jaq_available; then return; fi
    fi
    case "$OS:$ARCH" in
        Darwin:x86_64) target=x86_64-apple-darwin ;;
        Darwin:aarch64) target=aarch64-apple-darwin ;;
        Linux:x86_64) target=x86_64-unknown-linux-musl ;;
        Linux:aarch64) target=aarch64-unknown-linux-musl ;;
        *) skip codex "no upstream binary for ${OS}/${ARCH}"; return ;;
    esac
    release_json=$(curl -fsSL https://releases.openai.com/codex/channels/latest 2>/dev/null) || release_json=
    tag=$(printf '%s\n' "$release_json" | run_jaq -r '.tag_name // empty' 2>/dev/null) || tag=
    case "$tag" in
        rust-v*) version=${tag#rust-v} ;;
        *) unchecked codex "no release found"; return ;;
    esac
    printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$' \
        || { unchecked codex "no release found"; return; }
    asset="codex-package-${target}.tar.gz"
    asset_json=$(printf '%s\n' "$release_json" \
        | run_jaq -c --arg asset "$asset" ".assets[] | select(.name == \$asset)" 2>/dev/null) || asset_json=
    url=$(printf '%s\n' "$asset_json" | run_jaq -r '.browser_download_url // empty' 2>/dev/null) || url=
    digest=$(printf '%s\n' "$asset_json" | run_jaq -r '.digest // empty' 2>/dev/null) || digest=
    expected_sha256=${digest#sha256:}
    case "$expected_sha256" in
        *[!0-9a-f]*|'') unchecked codex "$asset is missing a SHA-256 digest"; return ;;
    esac
    [ "${#expected_sha256}" -eq 64 ] || {
        unchecked codex "$asset is missing a SHA-256 digest"
        return
    }
    case "$url" in
        https://releases.openai.com/codex/releases/*|https://github.com/openai/codex/releases/download/*) ;;
        *) unchecked codex "$asset is missing a SHA-256 digest"; return ;;
    esac
    codex_root="${CODEX_HOME}/packages/standalone"
    if [ -d "${DEST}/codex" ] && [ ! -L "${DEST}/codex" ]; then
        skip codex "${DEST}/codex is a directory"
        return
    fi
    releases="${codex_root}/releases"
    if [ -L "$releases" ] || { [ -e "$releases" ] && [ ! -d "$releases" ]; }; then
        skip codex "$releases is not a directory"
        return
    fi
    id=$(asset_id "$url")
    if [ -z "$id" ]; then
        unchecked codex "$asset is unavailable"
        return
    fi
    if ! codex_launcher_is_legacy_dl && is_current codex "$id"; then
        codex_target=$(readlink "${DEST}/codex") || codex_target=
        if own_codex_release_target "$codex_target"; then
            codex_mode_target=$(readlink "${DEST}/codex-code-mode-host" 2>/dev/null || :)
            codex_release=${codex_target%/bin/codex}
            if [ "$codex_mode_target" = "${codex_release}/bin/codex-code-mode-host" ]; then
                own_file "${DEST}/codex-code-mode-host"
            fi
        fi
        printf '%s\n' "codex is current (${version})"
        return
    fi
    release_dir="${releases}/${version}-${target}"
    if [ -e "$release_dir" ] || [ -L "$release_dir" ]; then
        skip codex "$release_dir already exists"
        return
    fi
    own_missing_dirs "$releases"
    mkdir -p "$releases"
    tmpzip=$(mktemp)
    if ! curl -fsSL -o "$tmpzip" "$url"; then
        rm -f "$tmpzip"
        tmpzip=
        skip codex "$asset download failed"
        return
    fi
    actual_sha256=$(sha256_file "$tmpzip")
    if [ "$actual_sha256" != "$expected_sha256" ]; then
        rm -f "$tmpzip"
        tmpzip=
        skip codex "$asset checksum mismatch"
        return
    fi
    if ! tar -tzf "$tmpzip" | awk '
        BEGIN { bad = 0 }
        /^\// { bad = 1 }
        {
            count = split($0, path, "/")
            for (component = 1; component <= count; component++) {
                if (path[component] == "..") bad = 1
            }
        }
        END { exit bad }
    '; then
        rm -f "$tmpzip"
        tmpzip=
        skip codex "$asset contains an invalid path"
        return
    fi
    tmpbundle=$(mktemp -d "${releases}/.codex.XXXXXX")
    if ! tar -xzf "$tmpzip" -C "$tmpbundle"; then
        rm -f "$tmpzip"
        tmpzip=
        skip codex "$asset could not be extracted"
        return
    fi
    rm -f "$tmpzip"
    tmpzip=
    if [ ! -f "${tmpbundle}/codex-package.json" ] \
        || [ ! -x "${tmpbundle}/bin/codex" ] \
        || [ ! -x "${tmpbundle}/bin/codex-code-mode-host" ] \
        || [ ! -x "${tmpbundle}/codex-path/rg" ]; then
        skip codex "$asset is missing required package files"
        return
    fi
    mv "$tmpbundle" "$release_dir"
    tmpbundle=
    own_dir "$release_dir"
    tmpbinlink=$(mktemp "${DEST}/.codex.XXXXXX")
    rm -f "$tmpbinlink"
    ln -s "${release_dir}/bin/codex" "$tmpbinlink"
    mv -f "$tmpbinlink" "${DEST}/codex"
    tmpbinlink=
    own_file "${DEST}/codex"
    if [ "$OS" = Darwin ]; then
        tmpbinlink=$(mktemp "${DEST}/.codex-code-mode-host.XXXXXX")
        rm -f "$tmpbinlink"
        ln -s "${release_dir}/bin/codex-code-mode-host" "$tmpbinlink"
        mv -f "$tmpbinlink" "${DEST}/codex-code-mode-host"
        tmpbinlink=
        own_file "${DEST}/codex-code-mode-host"
    fi
    printf '%s\n' "$id" > "${STATE}/codex"
    own_file "${STATE}/codex"
    changed=true
    printf '%s\n' "Installed ${DEST}/codex"
}

install_opencode2() {
    if installed opencode2 && ! opencode2_launcher_is_legacy_dl; then
        if [ -f "${DEST}/opencode2" ] && [ ! -L "${DEST}/opencode2" ] \
            && [ -s "${STATE}/opencode2" ] && ! command -v file >/dev/null 2>&1; then
            printf '%s\n' 'Warning: file is required to identify the existing OpenCode 2 launcher; keeping it' >&2
        fi
        printf '%s\n' 'opencode2 is installed'
        return
    fi
    case "$OS:$ARCH" in
        Darwin:x86_64) asset=opencode-darwin-x64.zip ;;
        Darwin:aarch64) asset=opencode-darwin-arm64.zip ;;
        Linux:x86_64) asset=opencode-linux-x64.tar.gz ;;
        Linux:aarch64) asset=opencode-linux-arm64.tar.gz ;;
        *) skip opencode2 "no upstream binary for ${OS}/${ARCH}"; return ;;
    esac
    if [ "$OS" = Linux ] && { [ -f /etc/alpine-release ] \
        || { command -v ldd >/dev/null 2>&1 && ldd --version 2>&1 | grep -qi musl; }; }; then
        case "$asset" in
            opencode-linux-*) asset=${asset%.tar.gz}-musl.tar.gz ;;
        esac
    fi
    url="https://opencode.ai/update/api/latest/cli/opencode/$asset"
    id=$(asset_id "$url")
    if [ -z "$id" ]; then
        unchecked opencode2 "$asset is unavailable"
        return
    fi
    if ! opencode2_launcher_is_legacy_dl && is_current opencode2 "$id"; then
        if [ "$(readlink "${DEST}/opencode2" 2>/dev/null || :)" = "${OPENCODE2_HOME}/bin/opencode2" ]; then
            own_file "${OPENCODE2_HOME}/bin/opencode2"
            own_file "${OPENCODE2_HOME}/bin/opencode"
        fi
        printf '%s\n' "opencode2 is current"
        return
    fi
    opencode2_bin_dir="${OPENCODE2_HOME}/bin"
    opencode2_binary="${opencode2_bin_dir}/opencode"
    if [ -e "$opencode2_binary" ] || [ -L "$opencode2_binary" ]; then
        skip opencode2 "$opencode2_binary already exists"
        return
    fi
    own_missing_dirs "$opencode2_bin_dir"
    mkdir -p "$opencode2_bin_dir"
    printf '%s\n' "Downloading opencode2 ..."
    tmpzip=$(mktemp)
    if ! curl -fsSL -o "$tmpzip" "$url"; then
        rm -f "$tmpzip"
        tmpzip=
        skip opencode2 "download failed"
        return
    fi
    tmpbin=$(mktemp "${opencode2_bin_dir}/.opencode2.XXXXXX")
    case "$asset" in
        *.zip) unzip -p "$tmpzip" opencode > "$tmpbin" ;;
        *.tar.gz) tar -xOzf "$tmpzip" opencode > "$tmpbin" ;;
    esac
    if [ ! -s "$tmpbin" ]; then
        skip opencode2 "$asset is missing the opencode binary"
        return
    fi
    rm -f "$tmpzip"
    tmpzip=
    if [ "$OS" = Darwin ]; then
        xattr -d com.apple.quarantine "$tmpbin" 2>/dev/null || true
        codesign -fs - "$tmpbin"
    fi
    chmod +x "$tmpbin"
    mv -f "$tmpbin" "$opencode2_binary"
    tmpbin=
    own_file "$opencode2_binary"
    tmpbinlink=$(mktemp "${opencode2_bin_dir}/.opencode2-shim.XXXXXX")
    cat > "$tmpbinlink" <<'EOF'
#!/bin/sh
exec "${HOME}/.opencode/bin/opencode" "$@"
EOF
    chmod +x "$tmpbinlink"
    mv -f "$tmpbinlink" "${opencode2_bin_dir}/opencode2"
    tmpbinlink=
    own_file "${opencode2_bin_dir}/opencode2"
    tmpbinlink=$(mktemp "${DEST}/.opencode2.XXXXXX")
    rm -f "$tmpbinlink"
    ln -s "${opencode2_bin_dir}/opencode2" "$tmpbinlink"
    mv -f "$tmpbinlink" "${DEST}/opencode2"
    tmpbinlink=
    own_file "${DEST}/opencode2"
    printf '%s\n' "$id" > "${STATE}/opencode2"
    own_file "${STATE}/opencode2"
    changed=true
    printf '%s\n' "Installed ${DEST}/opencode2"
}

wait_for_workers() {
    group_failed=false
    for worker_pid in $worker_pids; do
        case "$worker_progs" in
            *' '*)
                worker_prog=${worker_progs%% *}
                worker_progs=${worker_progs#* }
                ;;
            *)
                worker_prog=$worker_progs
                worker_progs=
                ;;
        esac
        if wait "$worker_pid"; then :; else
            group_failed=true
            worker_failed_progs="${worker_failed_progs}${worker_failed_progs:+ }$worker_prog"
        fi
        worker_pids=${worker_pids#"$worker_pid"}
        worker_pids=${worker_pids# }
    done
    worker_count=0
    worker_progs=
    if $group_failed; then return 1; fi
    return 0
}

run_parallel_wave() {
    max_workers=$#
    parallel_failed=false
    worker_pids=
    worker_progs=
    worker_failed_progs=
    worker_count=0
    if [ ! -r "$script_path" ]; then
        printf '%s\n' "dl: cannot start parallel workers: cannot read '$script_path' (invoked as '$0')" >&2
        printf '%s\n' "dl: check the invocation path and retry" >&2
        return 1
    fi
    if ! log_dir=$(mktemp -d); then
        printf '%s\n' "Could not create a directory for worker output" >&2
        return 1
    fi
    log_count=0
    for prog in "$@"; do
        log_count=$((log_count + 1))
        DL_INTERNAL_WORKER=true sh "$script_path" "$prog" \
            > "${log_dir}/${log_count}.stdout" \
            2> "${log_dir}/${log_count}.stderr" &
        worker_pid=$!
        worker_pids="${worker_pids}${worker_pids:+ }${worker_pid}"
        worker_progs="${worker_progs}${worker_progs:+ }${prog}"
        worker_count=$((worker_count + 1))
        if [ "$worker_count" -ge "$max_workers" ]; then
            if ! wait_for_workers; then parallel_failed=true; fi
        fi
    done
    if [ "$worker_count" -gt 0 ]; then
        if ! wait_for_workers; then parallel_failed=true; fi
    fi
    if ! replay_worker_logs; then parallel_failed=true; fi
    if [ -n "$log_dir" ]; then
        rm -rf "$log_dir" || parallel_failed=true
        log_dir=
    fi
    if $parallel_failed; then
        if [ -n "$worker_failed_progs" ]; then
            printf '%s\n' "dl: parallel install failed for: $worker_failed_progs" >&2
        fi
        return 1
    fi
    return 0
}

run_parallel() {
    run_failed=false
    while [ "$#" -gt 0 ]; do
        wave_tools=
        deferred_tools=
        for prog in "$@"; do
            case " $wave_tools " in
                *" $prog "*) deferred_tools="${deferred_tools}${deferred_tools:+ }${prog}" ;;
                *) wave_tools="${wave_tools}${wave_tools:+ }${prog}" ;;
            esac
        done
        # shellcheck disable=SC2086
        if ! run_parallel_wave $wave_tools; then run_failed=true; fi
        # shellcheck disable=SC2086
        set -- $deferred_tools
    done
    if $run_failed; then return 1; fi
    return 0
}

record_managed_binary() {
    record_prog=$1
    if [ -f "${STATE}/${record_prog}" ]; then
        own_file "${STATE}/${record_prog}"
        if installed "$record_prog"; then own_file "${DEST}/${record_prog}"; fi
    fi
}

record_managed_installs() {
    for record_prog in fd rg pinact jactionlint jaq fastermod tm ish e fz fdu fs srv mactop vault gh mold srt; do
        record_managed_binary "$record_prog"
    done
    if [ -s "${STATE}/mold" ] && [ "$(readlink "${DEST}/ld.mold" 2>/dev/null || :)" = mold ]; then
        own_file "${DEST}/ld.mold"
    fi
    if [ -s "${STATE}/python3" ]; then
        python3_target=$(readlink "${DEST}/python3" 2>/dev/null || :)
        case "$python3_target" in
            "${PYTHON_BUILD_ROOT}/"*/python/bin/python3.15)
                own_dir "${python3_target%/python/bin/python3.15}"
                own_file "${DEST}/python3"
                own_file "${STATE}/python3"
                if [ "$(readlink "${DEST}/python3.15" 2>/dev/null || :)" = "$python3_target" ]; then
                    own_file "${DEST}/python3.15"
                fi
                ;;
        esac
    fi
    if [ -s "${STATE}/claude" ]; then
        claude_target=$(readlink "${DEST}/claude" 2>/dev/null || :)
        case "/${claude_target}/" in *"/../"*) claude_target= ;; esac
        case "$claude_target" in
            "${HOME}/.claude/"*|"${CLAUDE_VERSIONS}/"*) own_file "$claude_target" ;;
        esac
    fi
    record_managed_binary grok
    if [ -s "${STATE}/grok" ] && [ "$(readlink "${DEST}/grok" 2>/dev/null || :)" = "${GROK_HOME}/bin/grok" ]; then
        own_file "${GROK_HOME}/bin/grok"
        grok_target=$(readlink "${GROK_HOME}/bin/grok" 2>/dev/null || :)
        own_grok_target "$grok_target"
    fi
    record_managed_binary codex
    if [ -s "${STATE}/codex" ]; then
        codex_target=$(readlink "${DEST}/codex" 2>/dev/null || :)
        if own_codex_release_target "$codex_target"; then
            codex_mode_target=$(readlink "${DEST}/codex-code-mode-host" 2>/dev/null || :)
            codex_release=${codex_target%/bin/codex}
            if [ "$codex_mode_target" = "${codex_release}/bin/codex-code-mode-host" ]; then
                own_file "${DEST}/codex-code-mode-host"
            fi
        fi
    fi
    if [ -s "${STATE}/cmd" ]; then
        own_file "${STATE}/cmd"
        if [ -d "$CMD_INSTALL_ROOT" ] && [ ! -L "$CMD_INSTALL_ROOT" ] \
            && [ -x "${CMD_INSTALL_ROOT}/bin/cmd" ] \
            && [ "$(readlink "${DEST}/cmd" 2>/dev/null || :)" = "${CMD_INSTALL_ROOT}/bin/cmd" ]; then
            own_dir "$CMD_INSTALL_ROOT"
            own_file "${DEST}/cmd"
        fi
    fi
    record_managed_binary opencode2
    if [ -s "${STATE}/opencode2" ] \
        && [ "$(readlink "${DEST}/opencode2" 2>/dev/null || :)" = "${OPENCODE2_HOME}/bin/opencode2" ]; then
        own_file "${OPENCODE2_HOME}/bin/opencode2"
        own_file "${OPENCODE2_HOME}/bin/opencode"
    fi
    for record_prog in dsh dsh-tui; do
        if [ -f "${STATE}/${record_prog}" ]; then own_file "${STATE}/${record_prog}"; fi
    done
    if [ -s "${STATE}/dsh" ] || [ -s "${STATE}/dsh-tui" ]; then
        if [ -d "$DSH_INSTALL_ROOT" ]; then own_dir "$DSH_INSTALL_ROOT"; fi
    fi
    if [ -s "${STATE}/mactop" ]; then
        if [ -d /Applications/mactop.app ]; then own_dir /Applications/mactop.app; fi
        agent="${HOME}/Library/LaunchAgents/com.mactop.plist"
        if [ -f "$agent" ]; then own_file "$agent"; fi
    fi
}

report_unowned_launcher() {
    report_prog=$1
    report_path="${DEST}/${report_prog}"
    if installed "$report_prog" && { [ ! -f "$DL_OWNED_FILE" ] \
        || ! awk -F '\t' -v path="$report_path" \
            '$1 == "F" && $2 == path { found = 1 } END { exit !found }' "$DL_OWNED_FILE"; }; then
        printf '%s\n' "Leaving untracked launcher: $report_path" >&2
        if [ -L "$report_path" ]; then
            report_target=$(readlink "$report_path" 2>/dev/null || :)
            if [ -n "$report_target" ]; then printf '%s\n' "Its target is also untracked: $report_target" >&2; fi
        fi
    fi
}

if [ "$DL_RECORD_OWNED" = true ]; then
    [ -n "$DL_OWNED_FILE" ] || { printf '%s\n' 'DL_OWNED_FILE is required to record installed paths' >&2; exit 1; }
    record_managed_installs
    for report_prog in agy muse claude; do report_unowned_launcher "$report_prog"; done
    exit 0
fi

if [ $# -eq 0 ]; then
    set -- fd rg pinact jactionlint jaq codex claude opencode2 fastermod tm ish e fz fdu fs srv srt python3
    if [ "$OS" = Darwin ]; then set -- "$@" mactop vault gh; fi
    if [ "${OS}:${ARCH}" = Linux:x86_64 ]; then set -- "$@" mold; fi
fi

needs_jaq=false
for prog in "$@"; do
    case "$prog" in
        codex)
            if ! installed codex || codex_launcher_is_legacy_dl; then needs_jaq=true; fi
            ;;
    esac
done
if $needs_jaq && ! jaq_available; then
    requested_tools=
    for prog in "$@"; do
        if [ "$prog" != jaq ]; then
            requested_tools="${requested_tools}${requested_tools:+ }${prog}"
        fi
    done
    # shellcheck disable=SC2086
    set -- $requested_tools
fi

if [ "$#" -gt 1 ] && [ "$_dl_worker_mode" != true ]; then
    if ! run_parallel "$@"; then failed=true; fi
    if $failed; then exit 1; fi
    printf '%s\n' "Done."
    exit 0
fi

for prog in "$@"; do
    changed=false
    case "$prog" in
        fd|rg) install_fd_or_rg "$prog" ;;
        pinact) install_pinact ;;
        jactionlint) install_jactionlint ;;
        grok) install_grok ;;
        dsh) install_dsh ;;
        cmd) install_cmd ;;
        antigravity|agy) install_antigravity ;;
        muse) install_muse ;;
        claude) install_claude ;;
        codex) install_codex ;;
        opencode2) install_opencode2 ;;
        vault) install_release vault ;;
        jaq) install_jaq ;;
        mold) install_mold ;;
        python3) install_python3 ;;
        gh) install_release gh ;;
        *)
            install_release "$prog"
            if [ "$prog" = mactop ] && [ "$OS" = Darwin ] && [ -x "${DEST}/mactop" ] \
                && { $changed || [ ! -d /Applications/mactop.app ]; }; then
                install_mactop_app
            fi ;;
    esac
done

if $failed; then exit 1; fi
if [ "$_dl_worker_mode" != true ]; then printf '%s\n' "Done."; fi
