        return
    fi
    if [ -e "$DSH_INSTALL_ROOT" ] || [ -L "$DSH_INSTALL_ROOT" ]; then
        if [ ! -s "${STATE}/dsh" ] || [ ! -s "${STATE}/dsh-tui" ]; then
            skip dsh "$DSH_INSTALL_ROOT already exists without dl install records"
            return
        fi
    else
        own_parent=${DSH_INSTALL_ROOT%/*}
        own_missing_dirs "$own_parent"
        own_dir "$DSH_INSTALL_ROOT"
    fi
    printf '%s\n' "Installing dsh (${version}) and dsh-tui (${tui_version}) ..."
    if ! npm install --global --prefix "$DSH_INSTALL_ROOT" \
        "@deepseek-ai/dsh@${version}" "@deepseek-harness-tui/dsh-tui@${tui_version}"; then
        skip dsh "npm install failed"
        return
    fi
    if [ ! -x "${DSH_INSTALL_ROOT}/bin/dsh" ] || [ ! -x "${DSH_INSTALL_ROOT}/bin/dsh-tui" ]; then
        skip dsh "npm packages did not install the dsh and dsh-tui commands"
        return
    fi
    if ! repair_dsh_tui_patch || ! remove_legacy_dsh; then return; fi
    printf '%s\n' "$version" > "${STATE}/dsh"
    printf '%s\n' "$tui_version" > "${STATE}/dsh-tui"
    own_file "${STATE}/dsh"
    own_file "${STATE}/dsh-tui"
    changed=true
    printf '%s\n' "Installed dsh and dsh-tui under ${DSH_INSTALL_ROOT}"
}

