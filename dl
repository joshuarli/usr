    fi
    mv "$tmpbundle" "$release_dir"
    tmpbundle=
    own_dir "$release_dir"
    tmpbinlink=$(mktemp "${DEST}/.python3.XXXXXX")
    rm -f "$tmpbinlink"
    ln -s "${release_dir}/python/bin/python3.15" "$tmpbinlink"
