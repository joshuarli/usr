#!/bin/sh
set -eu

ARCH=$(uname -m | sed 's/arm64/aarch64/')
OS=$(uname -s)
case "$OS" in
    Darwin) TARGET="${ARCH}-apple-darwin" ;;
    Linux)  TARGET="${ARCH}-unknown-linux-gnu" ;;
    *)      printf '%s\n' "Unsupported OS: ${OS}" >&2; exit 1 ;;
esac
DEST="${HOME}/usr/bin"
mkdir -p "$DEST"

for prog in fd rg fastermod tm ish e fs srv cargo wild tea; do
    case "$prog" in
        fd|rg|fastermod|tm|fs|cargo|wild|tea) owner="laputa-systems" ;;
        ish|e|srv) owner="joshuarli" ;;
    esac
    # The release workflows publish prereleases, which GitHub's /latest endpoint
    # intentionally excludes. The releases collection is newest-first, so its
    # first tag is the artifact set produced by the most recent dispatch.
    tag=$(curl -fsSL "https://api.github.com/repos/${owner}/${prog}/releases?per_page=1" \
        | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n 1) || true
    if [ -z "$tag" ]; then
        printf '%s\n' "Skipping ${prog}: no release found"
        continue
    fi
    case "${OS}:${prog}" in
        Linux:e|Linux:ish) artifact_target="${ARCH}-unknown-linux-musl" ;;
        Linux:*) artifact_target="${ARCH}-unknown-linux-gnu" ;;
        *) artifact_target="${ARCH}-apple-darwin" ;;
    esac
    asset="${prog}-${artifact_target}"
    zip="${asset}.zip"
    url="https://github.com/${owner}/${prog}/releases/download/${tag}/${zip}"
    printf '%s\n' "Downloading ${zip} ..."
    tmpzip=$(mktemp)
    if ! curl -fsSL -o "$tmpzip" "$url"; then
        rm -f "$tmpzip"
        printf '%s\n' "Skipping ${prog}: ${zip} is not available in ${tag}" >&2
        continue
    fi
    tmpbin=$(mktemp "${DEST}/.${prog}.XXXXXX")
    if ! unzip -p "$tmpzip" "$asset" > "$tmpbin"; then
        rm -f "$tmpzip"
        rm -f "$tmpbin"
        printf '%s\n' "Skipping ${prog}: ${zip} does not contain ${asset}" >&2
        continue
    fi
    rm -f "$tmpzip"
    mv "$tmpbin" "${DEST}/${prog}"
    if [ "$OS" = Darwin ]; then
        xattr -d com.apple.quarantine "${DEST}/${prog}" 2>/dev/null || true
    fi
    chmod +x "${DEST}/${prog}"
    if [ "$OS" = Darwin ]; then
        codesign -fs - "${DEST}/${prog}"
    fi
    printf '%s\n' "Installed ${DEST}/${prog}"
done

install_direct_macos_binary() {
    name="$1"
    url="$2"
    printf '%s\n' "Downloading ${name} ..."
    tmpbin=$(mktemp "${DEST}/.${name}.XXXXXX")
    if ! curl -fsSL -o "$tmpbin" "$url"; then
        rm -f "$tmpbin"
        printf '%s\n' "Failed to download ${name}" >&2
        return 1
    fi
    mv "$tmpbin" "${DEST}/${name}"
    xattr -d com.apple.quarantine "${DEST}/${name}" 2>/dev/null || true
    chmod +x "${DEST}/${name}"
    codesign -fs - "${DEST}/${name}"
    printf '%s\n' "Installed ${DEST}/${name}"
}

if [ "$OS" = Darwin ]; then
    install_direct_macos_binary vault \
        "https://github.com/joshuarli/vault-swift/releases/download/release-23530d9d8a6321a35d02eddda3c7f6392dacc791/vault"
    install_direct_macos_binary gh \
        "https://github.com/joshuarli/gh/releases/download/debloat/gh-macos-arm"
fi

if [ "$TARGET" = "aarch64-apple-darwin" ]; then
    for app in tty.app play; do
        case "$app" in
            tty.app) repo="tty.app"; zip="tty.app.zip"; appdir="tty.app" ;;
            play)    repo="play";    zip="Play.app.zip"; appdir="Play.app" ;;
        esac
        tag=$(curl -fsSL "https://api.github.com/repos/joshuarli/${repo}/releases/latest" \
            | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p') || true
        if [ -z "$tag" ]; then
            printf '%s\n' "Skipping ${app}: no release found"
            continue
        fi
        url="https://github.com/joshuarli/${repo}/releases/download/${tag}/${zip}"
        printf '%s\n' "Downloading ${zip} (${tag}) ..."
        tmpdir=$(mktemp -d)
        curl -fsSL -o "${tmpdir}/${zip}" "${url}"
        unzip -qo "${tmpdir}/${zip}" -d "${tmpdir}"
        xattr -rd com.apple.quarantine "${tmpdir}/${appdir}" 2>/dev/null || true
        rm -rf "/Applications/${appdir}"
        mv "${tmpdir}/${appdir}" /Applications/
        rm -rf "$tmpdir"
        printf '%s\n' "Installed ${appdir} to /Applications"
    done
fi

printf '%s\n' "Done."
