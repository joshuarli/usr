#!/bin/sh
# dl - install or update my binaries from their newest GitHub release into ~/.local/bin.
# usage: dl [TOOL...]    with no TOOL, every tool below
# Distinct tools are handled concurrently, up to the number requested.
# Idempotent: a tool is downloaded only when its newest asset differs from the one
# installed last time. If the newest asset cannot be checked (offline, rate limited)
# and the tool is already installed, it warns and keeps the installed one.
set -eu

_dl_worker_mode=false
if [ "${DL_INTERNAL_WORKER:-false}" = true ]; then _dl_worker_mode=true; fi
unset DL_INTERNAL_WORKER

script_path=$0
case "$script_path" in
    */*) ;;
    *) script_path=$(command -v "$script_path" || printf './%s\n' "$script_path") ;;
esac

ARCH=$(uname -m | sed 's/arm64/aarch64/')
OS=$(uname -s)
case "$OS" in
    Darwin|Linux) ;;
    *) printf '%s\n' "Unsupported OS: ${OS}" >&2; exit 1 ;;
esac
DEST="${HOME}/.local/bin"
mkdir -p "$DEST"

# One file per tool holds the ETag of the asset last installed. The binary itself
# cannot say which release it came from, and ad-hoc signing changes its bytes, so
# comparing it with a fresh download would never match on macOS.
STATE="${XDG_STATE_HOME:-${HOME}/.local/state}/dl"
mkdir -p "$STATE"

failed=false
changed=false
tmpzip=
tmpbin=
tmpbundle=
worker_pids=
worker_count=0
log_dir=
log_count=0
if [ "$_dl_worker_mode" = true ]; then
    worker_pids=
    worker_count=0
    log_dir=
    log_count=0
fi
skip() { printf '%s\n' "Skipping $1: $2" >&2; failed=true; }

# Remove only temporary paths created by this invocation. Keep cleanup failures
# visible without replacing the install or signal failure that caused cleanup.
cleanup_temporary_files() {
    if [ -n "$tmpzip" ]; then
        rm -f "$tmpzip" || printf '%s\n' "Warning: could not remove $tmpzip" >&2
        tmpzip=
    fi
    if [ -n "$tmpbin" ]; then
        rm -f "$tmpbin" || printf '%s\n' "Warning: could not remove $tmpbin" >&2
        tmpbin=
    fi
    if [ -n "$tmpbundle" ]; then
        rm -rf "$tmpbundle" || printf '%s\n' "Warning: could not remove $tmpbundle" >&2
        tmpbundle=
    fi
    if [ -n "$log_dir" ]; then
        rm -rf "$log_dir" || printf '%s\n' "Warning: could not remove $log_dir" >&2
        log_dir=
    fi
    return 0
}

# Replay worker output only after all writers have closed their logs.
replay_worker_logs() {
    log_index=1
    while [ "$log_index" -le "$log_count" ]; do
        stdout_log="${log_dir}/${log_index}.stdout"
        stderr_log="${log_dir}/${log_index}.stderr"
        if [ -f "$stdout_log" ]; then cat "$stdout_log" || return 1; fi
        if [ -f "$stderr_log" ]; then cat "$stderr_log" >&2 || return 1; fi
        log_index=$((log_index + 1))
    done
}

# A parent owns every worker it starts and stops them if it is interrupted.
terminate_workers() {
    for worker_pid in $worker_pids; do
        kill "$worker_pid" 2>/dev/null || :
    done
    for worker_pid in $worker_pids; do
        wait "$worker_pid" 2>/dev/null || :
    done
}

on_signal() {
    signal_status=$1
    trap '' HUP INT TERM
    terminate_workers
    replay_worker_logs || :
    cleanup_temporary_files
    exit "$signal_status"
}

trap 'cleanup_temporary_files' 0
trap 'on_signal 129' HUP
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

# unchecked PROG REASON  Keep an installed tool we could not check; fail if there is none.
unchecked() {
    if [ -x "${DEST}/$1" ]; then
        printf '%s\n' "Warning: could not check $1 ($2); keeping the installed one" >&2
    else
        skip "$1" "$2"
    fi
}

# asset_id URL  Print the ETag of the asset URL finally serves, or nothing if unreachable.
# A one-byte ranged GET, because release URLs redirect to signed storage URLs that reject HEAD.
asset_id() {
    curl -fsSL -r 0-0 -D - -o /dev/null "$1" 2>/dev/null \
        | tr -d '\r' | sed -n 's/^[Ee][Tt][Aa][Gg]: *//p' | tail -n 1
}

# is_current PROG ID  True when PROG is installed from the asset with this ID.
is_current() {
    [ -x "${DEST}/$1" ] && [ "$(cat "${STATE}/$1" 2>/dev/null)" = "$2" ]
}

# install_binary PROG FILE ID
# Strip quarantine and ad-hoc sign on macOS, make executable, and move into place.
# Signing happens before the move so a failure never leaves an unsigned binary installed.
# The ID is recorded last, so an interrupted install is retried on the next run.
install_binary() {
    if [ "$OS" = Darwin ]; then
        xattr -d com.apple.quarantine "$2" 2>/dev/null || true
        codesign -fs - "$2"
    fi
    chmod +x "$2"
    mv "$2" "${DEST}/$1"
    printf '%s\n' "$3" > "${STATE}/$1"
    changed=true
    printf '%s\n' "Installed ${DEST}/$1"
}

install_release() {
    prog=$1
    case "$prog" in
        e|fz|fd|rg|fdu|fastermod|tm|fs|srv|diff-pretty) owner="laputa-systems" ;;
        ish|mactop) owner="joshuarli" ;;
        *) skip "$prog" "unknown tool"; return ;;
    esac
    # The release workflows publish prereleases, which GitHub's /latest endpoint
    # intentionally excludes. The releases feed is newest-first and includes them, so
    # its first tag is the artifact set produced by the most recent dispatch. Unlike
    # the API, the feed is not rate limited, which matters for a command run often.
    tag=$(curl -fsSL "https://github.com/${owner}/${prog}/releases.atom" \
        | sed -n 's|.*<link[^>]*releases/tag/\([^"]*\)".*|\1|p' | head -n 1) || tag=
    if [ -z "$tag" ]; then
        unchecked "$prog" "no release found"
        return
    fi
    case "${OS}:${prog}" in
        Linux:e|Linux:ish|Linux:fz|Linux:fdu) artifact_target="${ARCH}-unknown-linux-musl" ;;
        Linux:*) artifact_target="${ARCH}-unknown-linux-gnu" ;;
        *) artifact_target="${ARCH}-apple-darwin" ;;
    esac
    asset="${prog}-${artifact_target}"
    url="https://github.com/${owner}/${prog}/releases/download/${tag}/${asset}.zip"
    id=$(asset_id "$url")
    if [ -z "$id" ]; then
        unchecked "$prog" "${asset}.zip is not available in ${tag}"
        return
    fi
    if is_current "$prog" "$id"; then
        printf '%s\n' "${prog} is current (${tag})"
        return
    fi
    printf '%s\n' "Downloading ${asset}.zip ..."
    tmpzip=$(mktemp)
    if ! curl -fsSL -o "$tmpzip" "$url"; then
        rm -f "$tmpzip"
        tmpzip=
        skip "$prog" "${asset}.zip is not available in ${tag}"
        return
    fi
    tmpbin=$(mktemp "${DEST}/.${prog}.XXXXXX")
    if ! unzip -p "$tmpzip" "$asset" > "$tmpbin"; then
        rm -f "$tmpzip" "$tmpbin"
        tmpzip=
        tmpbin=
        skip "$prog" "${asset}.zip does not contain ${asset}"
        return
    fi
    rm -f "$tmpzip"
    tmpzip=
    install_binary "$prog" "$tmpbin" "$id"
    tmpbin=
}

# install_mold  Install mold from the newest musl prerelease of joshuarli/mold.
# The release is a tarball, and only x86_64 Linux is published (no macOS yet). ld.mold
# is a link to mold, which is what `-fuse-ld=mold` looks for.
install_mold() {
    if [ "${OS}:${ARCH}" != Linux:x86_64 ]; then
        skip mold "only x86_64 Linux is published"
        return
    fi
    tag=$(curl -fsSL "https://github.com/joshuarli/mold/releases.atom" \
        | sed -n 's|.*<link[^>]*releases/tag/\(mold-musl-[^"]*\)".*|\1|p' | head -n 1) || tag=
    if [ -z "$tag" ]; then
        unchecked mold "no release found"
        return
    fi
    # The tag is mold-musl-<version>-<commit>; the asset names carry the version.
    version=${tag#mold-musl-}
    version=${version%-*}
    asset="mold-${version}-x86_64-linux-musl"
    url="https://github.com/joshuarli/mold/releases/download/${tag}/${asset}.tar.gz"
    id=$(asset_id "$url")
    if [ -z "$id" ]; then
        unchecked mold "${asset}.tar.gz is not available in ${tag}"
        return
    fi
    if is_current mold "$id" && [ -L "${DEST}/ld.mold" ]; then
        printf '%s\n' "mold is current (${tag})"
        return
    fi
    printf '%s\n' "Downloading ${asset}.tar.gz ..."
    tmpzip=$(mktemp)
    if ! curl -fsSL -o "$tmpzip" "$url"; then
        rm -f "$tmpzip"
        tmpzip=
        skip mold "${asset}.tar.gz is not available in ${tag}"
        return
    fi
    tmpbin=$(mktemp "${DEST}/.mold.XXXXXX")
    if ! tar -xzOf "$tmpzip" "${asset}/bin/mold" > "$tmpbin"; then
        rm -f "$tmpzip" "$tmpbin"
        tmpzip=
        tmpbin=
        skip mold "${asset}.tar.gz does not contain bin/mold"
        return
    fi
    rm -f "$tmpzip"
    tmpzip=
    install_binary mold "$tmpbin" "$id"
    tmpbin=
    ln -sf mold "${DEST}/ld.mold"
}

# mactop is a menu-bar app: mirror `make install` from joshuarli/mactop
# (app bundle in /Applications plus LaunchAgent) on top of the installed binary.
install_mactop_app() {
    app="/Applications/mactop.app"
    printf '%s\n' "Installing ${app} ..."
    tmpbundle=$(mktemp -d "/Applications/.mactop.XXXXXX")
    bundle=$tmpbundle
    mkdir -p "$bundle/Contents/MacOS"
    cp "${DEST}/mactop" "$bundle/Contents/MacOS/mactop"
    cat > "$bundle/Contents/Info.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>mactop</string>
	<key>CFBundleDisplayName</key>
	<string>mactop</string>
	<key>CFBundleIdentifier</key>
	<string>com.mactop</string>
	<key>CFBundleExecutable</key>
	<string>mactop</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
</dict>
</plist>
EOF
    codesign --force --sign - "$bundle"
    xattr -dr com.apple.quarantine "$bundle" 2>/dev/null || true
    rm -rf "$app"
    mv "$bundle" "$app"
    tmpbundle=
    printf '%s\n' "Installed ${app}"
    agent="${HOME}/Library/LaunchAgents/com.mactop.plist"
    mkdir -p "${HOME}/Library/LaunchAgents"
    printf '%s\n' \
      '<?xml version="1.0" encoding="UTF-8"?>' \
      '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"' \
      '  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
      '<plist version="1.0">' \
      '<dict>' \
      '  <key>Label</key>' \
      '  <string>com.mactop</string>' \
      '  <key>ProgramArguments</key>' \
      '  <array>' \
      "    <string>${DEST}/mactop</string>" \
      '  </array>' \
      '  <key>RunAtLoad</key>' \
      '  <true/>' \
      '</dict>' \
      '</plist>' > "$agent"
    launchctl bootout "gui/$(id -u)" "$agent" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$agent"
    launchctl kickstart -k "gui/$(id -u)/com.mactop"
    printf '%s\n' "Loaded ${agent}"
}

# install_direct NAME URL  Download one binary from a fixed URL.
install_direct() {
    id=$(asset_id "$2")
    if [ -z "$id" ]; then
        unchecked "$1" "$2 is unreachable"
        return
    fi
    if is_current "$1" "$id"; then
        printf '%s\n' "$1 is current"
        return
    fi
    printf '%s\n' "Downloading $1 ..."
    tmpbin=$(mktemp "${DEST}/.$1.XXXXXX")
    if ! curl -fsSL -o "$tmpbin" "$2"; then
        rm -f "$tmpbin"
        tmpbin=
        skip "$1" "download failed"
        return
    fi
    install_binary "$1" "$tmpbin" "$id"
    tmpbin=
}

# Repeated tools share a binary and state file, so keep those requests serial.
has_duplicate_tools() {
    for prog in "$@"; do
        matches=0
        for candidate in "$@"; do
            if [ "$prog" = "$candidate" ]; then
                matches=$((matches + 1))
            fi
        done
        if [ "$matches" -gt 1 ]; then return 0; fi
    done
    return 1
}

wait_for_workers() {
    group_failed=false
    for worker_pid in $worker_pids; do
        if wait "$worker_pid"; then :; else group_failed=true; fi
        worker_pids=${worker_pids#"$worker_pid"}
        worker_pids=${worker_pids# }
    done
    worker_count=0
    if $group_failed; then return 1; fi
    return 0
}

# Each child handles one tool, so its result and failure state stay independent.
run_parallel() {
    max_workers=$#
    parallel_failed=false
    worker_pids=
    worker_count=0
    if ! log_dir=$(mktemp -d); then
        printf '%s\n' "Could not create a directory for worker output" >&2
        return 1
    fi
    log_count=0
    for prog in "$@"; do
        log_count=$((log_count + 1))
        DL_INTERNAL_WORKER=true "$script_path" "$prog" \
            > "${log_dir}/${log_count}.stdout" \
            2> "${log_dir}/${log_count}.stderr" &
        worker_pid=$!
        worker_pids="${worker_pids}${worker_pids:+ }${worker_pid}"
        worker_count=$((worker_count + 1))
        if [ "$worker_count" -ge "$max_workers" ]; then
            if ! wait_for_workers; then parallel_failed=true; fi
        fi
    done
    if [ "$worker_count" -gt 0 ]; then
        if ! wait_for_workers; then parallel_failed=true; fi
    fi
    if ! replay_worker_logs; then parallel_failed=true; fi
    if $parallel_failed; then return 1; fi
    return 0
}

if [ $# -eq 0 ]; then
    set -- fd rg jaq fastermod tm ish e fz fdu fs srv mactop
    if [ "$OS" = Darwin ]; then set -- "$@" vault gh; fi
    if [ "${OS}:${ARCH}" = Linux:x86_64 ]; then set -- "$@" mold; fi
fi

if [ "$#" -gt 1 ] && [ "$_dl_worker_mode" != true ] \
    && ! has_duplicate_tools "$@"; then
    if ! run_parallel "$@"; then failed=true; fi
    if $failed; then exit 1; fi
    printf '%s\n' "Done."
    exit 0
fi

for prog in "$@"; do
    changed=false
    case "$prog" in
        vault)
            install_direct vault \
                "https://github.com/joshuarli/vault-swift/releases/download/release-23530d9d8a6321a35d02eddda3c7f6392dacc791/vault" ;;
        jaq)
            # Upstream publishes bare binaries, not zips, and musl only for x86_64.
            case "${OS}:${ARCH}" in
                Linux:x86_64) jaq_target="x86_64-unknown-linux-musl" ;;
                Linux:*) jaq_target="${ARCH}-unknown-linux-gnu" ;;
                *) jaq_target="${ARCH}-apple-darwin" ;;
            esac
            install_direct jaq \
                "https://github.com/01mf02/jaq/releases/latest/download/jaq-${jaq_target}" ;;
        mold) install_mold ;;
        gh)
            install_direct gh \
                "https://github.com/joshuarli/gh/releases/download/debloat/gh-macos-arm" ;;
        *)
            install_release "$prog"
            # The app and LaunchAgent are rebuilt only for a new binary or a missing app.
            if [ "$prog" = mactop ] && [ "$OS" = Darwin ] && [ -x "${DEST}/mactop" ] \
                && { $changed || [ ! -d /Applications/mactop.app ]; }; then
                install_mactop_app
            fi ;;
    esac
done

if $failed; then exit 1; fi
if [ "$_dl_worker_mode" != true ]; then printf '%s\n' "Done."; fi
