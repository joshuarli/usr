#!/bin/sh
set -eu

ARCH=$(uname -m | sed 's/arm64/aarch64/')
OS=$(uname -s)
case "$OS" in
    Darwin) TARGET="${ARCH}-apple-darwin" ;;
    Linux)  TARGET="${ARCH}-unknown-linux-gnu" ;;
    *)      printf '%s\n' "Unsupported OS: ${OS}" >&2; exit 1 ;;
esac
DEST="${HOME}/usr/bin"
mkdir -p "$DEST"

for prog in fd rg fastermod tm ish e fz fdu fs srv mactop; do
    case "$prog" in
        e|fd|rg|fdu|fastermod|tm|fs|srv) owner="laputa-systems" ;;
        ish|mactop|fz) owner="joshuarli" ;;
    esac
    # The release workflows publish prereleases, which GitHub's /latest endpoint
    # intentionally excludes. The releases collection is newest-first, so its
    # first tag is the artifact set produced by the most recent dispatch.
    tag=$(curl -fsSL "https://api.github.com/repos/${owner}/${prog}/releases?per_page=1" \
        | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n 1) || true
    if [ -z "$tag" ]; then
        printf '%s\n' "Skipping ${prog}: no release found"
        continue
    fi
    case "${OS}:${prog}" in
        Linux:e|Linux:ish|Linux:fz|Linux:fdu) artifact_target="${ARCH}-unknown-linux-musl" ;;
        Linux:*) artifact_target="${ARCH}-unknown-linux-gnu" ;;
        *) artifact_target="${ARCH}-apple-darwin" ;;
    esac
    asset="${prog}-${artifact_target}"
    zip="${asset}.zip"
    url="https://github.com/${owner}/${prog}/releases/download/${tag}/${zip}"
    printf '%s\n' "Downloading ${zip} ..."
    tmpzip=$(mktemp)
    if ! curl -fsSL -o "$tmpzip" "$url"; then
        rm -f "$tmpzip"
        printf '%s\n' "Skipping ${prog}: ${zip} is not available in ${tag}" >&2
        continue
    fi
    tmpbin=$(mktemp "${DEST}/.${prog}.XXXXXX")
    if ! unzip -p "$tmpzip" "$asset" > "$tmpbin"; then
        rm -f "$tmpzip"
        rm -f "$tmpbin"
        printf '%s\n' "Skipping ${prog}: ${zip} does not contain ${asset}" >&2
        continue
    fi
    rm -f "$tmpzip"
    mv "$tmpbin" "${DEST}/${prog}"
    if [ "$OS" = Darwin ]; then
        xattr -d com.apple.quarantine "${DEST}/${prog}" 2>/dev/null || true
    fi
    chmod +x "${DEST}/${prog}"
    if [ "$OS" = Darwin ]; then
        codesign -fs - "${DEST}/${prog}"
    fi
    printf '%s\n' "Installed ${DEST}/${prog}"
done

# mactop is a menu-bar app: mirror `make install` from joshuarli/mactop
# (app bundle in /Applications plus LaunchAgent) on top of the
# binary installed by the loop above.
if [ "$OS" = Darwin ] && [ -x "${DEST}/mactop" ]; then
    app="/Applications/mactop.app"
    printf '%s\n' "Installing ${app} ..."
    rm -rf "$app"
    mkdir -p "$app/Contents/MacOS"
    cp "${DEST}/mactop" "$app/Contents/MacOS/mactop"
    cat > "$app/Contents/Info.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>mactop</string>
	<key>CFBundleDisplayName</key>
	<string>mactop</string>
	<key>CFBundleIdentifier</key>
	<string>com.mactop</string>
	<key>CFBundleExecutable</key>
	<string>mactop</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleVersion</key>
	<string>0.1.0</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
</dict>
</plist>
EOF
    codesign --force --sign - "$app"
    xattr -dr com.apple.quarantine "$app" 2>/dev/null || true
    printf '%s\n' "Installed ${app}"
    agent="${HOME}/Library/LaunchAgents/com.mactop.plist"
    mkdir -p "${HOME}/Library/LaunchAgents"
    printf '%s\n' \
      '<?xml version="1.0" encoding="UTF-8"?>' \
      '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"' \
      '  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' \
      '<plist version="1.0">' \
      '<dict>' \
      '  <key>Label</key>' \
      '  <string>com.mactop</string>' \
      '  <key>ProgramArguments</key>' \
      '  <array>' \
      "    <string>${DEST}/mactop</string>" \
      '  </array>' \
      '  <key>RunAtLoad</key>' \
      '  <true/>' \
      '</dict>' \
      '</plist>' > "$agent"
    launchctl bootout "gui/$(id -u)" "$agent" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$agent"
    launchctl kickstart -k "gui/$(id -u)/com.mactop"
    printf '%s\n' "Loaded ${agent}"
fi

install_direct_macos_binary() {
    name="$1"
    url="$2"
    printf '%s\n' "Downloading ${name} ..."
    tmpbin=$(mktemp "${DEST}/.${name}.XXXXXX")
    if ! curl -fsSL -o "$tmpbin" "$url"; then
        rm -f "$tmpbin"
        printf '%s\n' "Failed to download ${name}" >&2
        return 1
    fi
    mv "$tmpbin" "${DEST}/${name}"
    xattr -d com.apple.quarantine "${DEST}/${name}" 2>/dev/null || true
    chmod +x "${DEST}/${name}"
    codesign -fs - "${DEST}/${name}"
    printf '%s\n' "Installed ${DEST}/${name}"
}

if [ "$OS" = Darwin ]; then
    install_direct_macos_binary vault \
        "https://github.com/joshuarli/vault-swift/releases/download/release-23530d9d8a6321a35d02eddda3c7f6392dacc791/vault"
    install_direct_macos_binary gh \
        "https://github.com/joshuarli/gh/releases/download/debloat/gh-macos-arm"
fi

printf '%s\n' "Done."
