#!/bin/sh
set -eu

_dl_worker_mode=false
if [ "${DL_INTERNAL_WORKER:-false}" = true ]; then _dl_worker_mode=true; fi
unset DL_INTERNAL_WORKER

script_path=$0
case "$script_path" in
    */*) ;;
    *) script_path=$(command -v "$script_path" || printf './%s\n' "$script_path") ;;
esac

ARCH=$(uname -m | sed 's/arm64/aarch64/')
OS=$(uname -s)
case "$OS" in
    Darwin|Linux) ;;
    *) printf '%s\n' "Unsupported OS: ${OS}" >&2; exit 1 ;;
esac
DEST="${HOME}/.local/bin"
CLAUDE_VERSIONS="${XDG_DATA_HOME:-${HOME}/.local/share}/claude/versions"
DSH_INSTALL_ROOT="${XDG_DATA_HOME:-${HOME}/.local/share}/dsh"
CODEX_HOME="${CODEX_HOME:-${HOME}/.codex}"
CODEX_LEGACY_ROOT="${XDG_DATA_HOME:-${HOME}/.local/share}/codex"
GROK_HOME="${HOME}/.grok"
MUSE_LAUNCHER_URL=https://dev.meta.ai/install.sh
OPENCODE2_HOME="${HOME}/.opencode"
CMD_INSTALL_ROOT="${XDG_DATA_HOME:-${HOME}/.local/share}/command-code"
PYTHON_BUILD_ROOT="${XDG_DATA_HOME:-${HOME}/.local/share}/python-build"

STATE="${XDG_STATE_HOME:-${HOME}/.local/state}/dl"
DL_OWNED_FILE=${DL_OWNED_FILE:-}
DL_RECORD_OWNED=${DL_RECORD_OWNED:-false}

failed=false
changed=false
tmpzip=
tmpbin=
tmpoutput=
tmpbundle=
tmpbinlink=
worker_pids=
worker_count=0
log_dir=
log_count=0
if [ "$_dl_worker_mode" = true ]; then
    worker_pids=
    worker_count=0
    log_dir=
    log_count=0
fi
skip() { printf '%s\n' "Skipping $1: $2" >&2; failed=true; }
own_file() {
    if [ -n "$DL_OWNED_FILE" ] && { [ ! -f "$DL_OWNED_FILE" ] \
        || ! awk -F '\t' -v path="$1" '$1 == "F" && $2 == path { found = 1 } END { exit !found }' "$DL_OWNED_FILE"; }; then
        printf 'F\t%s\n' "$1" >> "$DL_OWNED_FILE"
    fi
}
own_dir() {
    if [ -n "$DL_OWNED_FILE" ] && { [ ! -f "$DL_OWNED_FILE" ] \
        || ! awk -F '\t' -v path="$1" '$1 == "D" && $2 == path { found = 1 } END { exit !found }' "$DL_OWNED_FILE"; }; then
        printf 'D\t%s\n' "$1" >> "$DL_OWNED_FILE"
    fi
}
own_empty_dir() {
    if [ -n "$DL_OWNED_FILE" ] && { [ ! -f "$DL_OWNED_FILE" ] \
        || ! awk -F '\t' -v path="$1" '$1 == "E" && $2 == path { found = 1 } END { exit !found }' "$DL_OWNED_FILE"; }; then
        printf 'E\t%s\n' "$1" >> "$DL_OWNED_FILE"
    fi
}
own_missing_dirs() {
    [ ! -d "$1" ] || return 0
    own_empty_dir "$1"
    missing_parent=${1%/*}
    [ -n "$missing_parent" ] || missing_parent=/
    [ "$missing_parent" = "$1" ] || own_missing_dirs "$missing_parent"
}

own_grok_target() {
    case "$1" in
        ../downloads/grok-macos-x86_64|../downloads/grok-macos-aarch64|../downloads/grok-linux-x86_64|../downloads/grok-linux-aarch64)
            own_file "${GROK_HOME}/downloads/${1##*/}"
            ;;
    esac
}

own_codex_release_target() {
    codex_release_prefix="${CODEX_HOME}/packages/standalone/releases/"
    case "$1" in
        "${codex_release_prefix}"*/bin/codex) ;;
        *) return 1 ;;
    esac
    codex_release_name=${1#"$codex_release_prefix"}
    codex_release_name=${codex_release_name%/bin/codex}
    case "$codex_release_name" in
        ''|*/*|.|..) return 1 ;;
    esac
    own_dir "${codex_release_prefix}${codex_release_name}"
}

own_missing_dirs "$DEST"
mkdir -p "$DEST"
own_missing_dirs "$STATE"
mkdir -p "$STATE"

cleanup_temporary_files() {
    if [ -n "$tmpzip" ]; then
        rm -f "$tmpzip" || printf '%s\n' "Warning: could not remove $tmpzip" >&2
        tmpzip=
    fi
    if [ -n "$tmpbin" ]; then
        rm -f "$tmpbin" || printf '%s\n' "Warning: could not remove $tmpbin" >&2
        tmpbin=
    fi
    if [ -n "$tmpoutput" ]; then
        rm -f "$tmpoutput" || printf '%s\n' "Warning: could not remove $tmpoutput" >&2
        tmpoutput=
    fi
    if [ -n "$tmpbundle" ]; then
        rm -rf "$tmpbundle" || printf '%s\n' "Warning: could not remove $tmpbundle" >&2
        tmpbundle=
    fi
    if [ -n "$tmpbinlink" ]; then
        rm -f "$tmpbinlink" || printf '%s\n' "Warning: could not remove $tmpbinlink" >&2
        tmpbinlink=
    fi
    if [ -n "$log_dir" ]; then
        rm -rf "$log_dir" || printf '%s\n' "Warning: could not remove $log_dir" >&2
        log_dir=
    fi
    return 0
}

replay_worker_logs() {
    log_index=1
    while [ "$log_index" -le "$log_count" ]; do
        stdout_log="${log_dir}/${log_index}.stdout"
        stderr_log="${log_dir}/${log_index}.stderr"
        if [ -f "$stdout_log" ]; then cat "$stdout_log" || return 1; fi
        if [ -f "$stderr_log" ]; then cat "$stderr_log" >&2 || return 1; fi
        log_index=$((log_index + 1))
    done
}

terminate_workers() {
    for worker_pid in $worker_pids; do
        kill "$worker_pid" 2>/dev/null || :
    done
    for worker_pid in $worker_pids; do
        wait "$worker_pid" 2>/dev/null || :
    done
}

on_signal() {
    signal_status=$1
    trap '' HUP INT TERM
    terminate_workers
    replay_worker_logs || :
    cleanup_temporary_files
    exit "$signal_status"
}

trap 'cleanup_temporary_files' 0
trap 'on_signal 129' HUP
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

unchecked() {
    if [ -x "${DEST}/$1" ]; then
        printf '%s\n' "Warning: could not check $1 ($2); keeping the installed one" >&2
    else
        skip "$1" "$2"
    fi
}

# A one-byte ranged GET, because release URLs redirect to signed storage URLs that reject HEAD.
asset_id() {
    curl -fsSL -r 0-0 -D - -o /dev/null "$1" 2>/dev/null \
        | tr -d '\r' | sed -n 's/^[Ee][Tt][Aa][Gg]: *//p' | tail -n 1
}

is_current() {
    if [ -x "${DEST}/$1" ] && [ "$(cat "${STATE}/$1" 2>/dev/null)" = "$2" ]; then
        own_file "${DEST}/$1"
        own_file "${STATE}/$1"
        return 0
    fi
    return 1
}

installed() {
    [ -x "${DEST}/$1" ] && [ ! -d "${DEST}/$1" ]
}

keep_installed() {
    if installed "$1"; then
        printf '%s\n' "$1 is installed"
        return 0
    fi
    return 1
}

codex_launcher_is_legacy_dl() {
    [ -L "${DEST}/codex" ] || return 1
    [ -s "${STATE}/codex" ] || return 1
    codex_launcher_target=$(readlink "${DEST}/codex") || return 1
    [ "$codex_launcher_target" = "${CODEX_LEGACY_ROOT}/current/bin/codex" ] \
        && [ -x "${DEST}/codex" ]
}

grok_launcher_is_legacy_dl() {
    [ -f "${DEST}/grok" ] && [ ! -L "${DEST}/grok" ] \
        && [ -s "${STATE}/grok" ] || return 1
    command -v file >/dev/null 2>&1 || return 1
    grok_file_type=$(file -b "${DEST}/grok" 2>/dev/null) || return 1
    case "$grok_file_type" in
        'Mach-O '*|'ELF '*) return 0 ;;
        *) return 1 ;;
    esac
}

muse_launcher_is_legacy_dl() {
    [ -f "${DEST}/muse" ] && [ ! -L "${DEST}/muse" ] \
        && [ -s "${STATE}/muse" ] || return 1
    command -v file >/dev/null 2>&1 || return 1
    muse_file_type=$(file -b "${DEST}/muse" 2>/dev/null) || return 1
    case "$muse_file_type" in
        'Mach-O '*|'ELF '*) return 0 ;;
        *) return 1 ;;
    esac
}

opencode2_launcher_is_legacy_dl() {
    [ -f "${DEST}/opencode2" ] && [ ! -L "${DEST}/opencode2" ] \
        && [ -s "${STATE}/opencode2" ] || return 1
    command -v file >/dev/null 2>&1 || return 1
    opencode2_file_type=$(file -b "${DEST}/opencode2" 2>/dev/null) || return 1
    case "$opencode2_file_type" in
        'Mach-O '*|'ELF '*) return 0 ;;
        *) return 1 ;;
    esac
}

claude_launcher_is_legacy_dl() {
    [ -s "${STATE}/claude" ] || return 1
    if claude_launcher_is_legacy_direct; then
        claude_launcher_is_dl_binary
        return
    fi
    [ -L "${DEST}/claude" ] || return 1
    claude_launcher_target=$(readlink "${DEST}/claude") || return 1
    case "$claude_launcher_target" in
        "${CLAUDE_VERSIONS}/"*) [ -x "${DEST}/claude" ] ;;
        *) return 1 ;;
    esac
}

claude_launcher_is_legacy_direct() {
    [ -f "${DEST}/claude" ] && [ ! -L "${DEST}/claude" ] \
        && [ -s "${STATE}/claude" ]
}

claude_launcher_is_dl_binary() {
    claude_launcher_is_legacy_direct || return 1
    command -v file >/dev/null 2>&1 || return 1
    claude_file_type=$(file -b "${DEST}/claude" 2>/dev/null) || return 1
    case "$claude_file_type" in
        'Mach-O '*|'ELF '*) return 0 ;;
        *) return 1 ;;
    esac
}

claude_keep_installed() {
    if claude_launcher_is_legacy_dl; then return 1; fi
    if installed claude; then
        printf '%s\n' 'claude is installed'
        return 0
    fi
    return 1
}

install_binary() {
    if [ "$OS" = Darwin ]; then
        xattr -d com.apple.quarantine "$2" 2>/dev/null || true
        codesign -fs - "$2"
    fi
    chmod +x "$2"
    mv "$2" "${DEST}/$1"
    own_file "${DEST}/$1"
    printf '%s\n' "$3" > "${STATE}/$1"
    own_file "${STATE}/$1"
    changed=true
    printf '%s\n' "Installed ${DEST}/$1"
}

install_release() {
    prog=$1
    repo=$prog
    case "$prog" in
        e|fz|fdu|fastermod|tm|fs|srv|diff-pretty|vault) owner="laputa-systems" ;;
        ish|mactop|gh) owner="joshuarli" ;;
        srt) owner="joshuarli"; repo="sandbox-runtime" ;;
        *) skip "$prog" "unknown tool"; return ;;
    esac
    tag_prefix=
    case "$prog" in
        srt|vault) tag_prefix=release- ;;
    esac
    tag=$(curl -fsSL "https://github.com/${owner}/${repo}/releases.atom" \
        | awk -v prefix="$tag_prefix" '
            /<entry>/ { in_entry = 1; updated = ""; tag = "" }
            in_entry && /<updated>/ {
                updated = $0
                sub(/^.*<updated>/, "", updated)
                sub(/<.*/, "", updated)
            }
            in_entry && /<link[^>]*releases\/tag\// {
                tag = $0
                sub(/^.*releases\/tag\//, "", tag)
                sub(/".*/, "", tag)
                if (prefix != "" && index(tag, prefix) != 1) tag = ""
            }
            /<\/entry>/ {
                if (updated > newest_updated && tag != "") {
                    newest_updated = updated
                    newest_tag = tag
                }
                in_entry = 0
            }
            END { print newest_tag }
        ') || tag=
    if [ -z "$tag" ]; then
        unchecked "$prog" "no release found"
        return
    fi
    case "${OS}:${prog}" in
        Linux:e|Linux:ish|Linux:fz|Linux:fdu|Linux:fastermod|Linux:tm|Linux:fs|Linux:srv|Linux:diff-pretty|Linux:srt|Linux:vault) artifact_target="${ARCH}-unknown-linux-musl" ;;
        Linux:*) artifact_target="${ARCH}-unknown-linux-gnu" ;;
        *) artifact_target="${ARCH}-apple-darwin" ;;
    esac
    asset="${prog}-${artifact_target}"
    url="https://github.com/${owner}/${repo}/releases/download/${tag}/${asset}.zip"
    id=$(asset_id "$url")
    if [ -z "$id" ]; then
        unchecked "$prog" "${asset}.zip is not available in ${tag}"
        return
    fi
    if is_current "$prog" "$id"; then
        printf '%s\n' "${prog} is current (${tag})"
        return
    fi
    printf '%s\n' "Downloading ${asset}.zip ..."
    tmpzip=$(mktemp)
    if ! curl -fsSL -o "$tmpzip" "$url"; then
        rm -f "$tmpzip"
        tmpzip=
        skip "$prog" "${asset}.zip is not available in ${tag}"
        return
    fi
    tmpbin=$(mktemp "${DEST}/.${prog}.XXXXXX")
    if ! unzip -p "$tmpzip" "$asset" > "$tmpbin"; then
        rm -f "$tmpzip" "$tmpbin"
        tmpzip=
        tmpbin=
        skip "$prog" "${asset}.zip does not contain ${asset}"
        return
    fi
    rm -f "$tmpzip"
    tmpzip=
    install_binary "$prog" "$tmpbin" "$id"
    tmpbin=
}

install_fd_or_rg() {
    prog=$1
    case "$prog" in
        fd) owner=sharkdp; project=fd ;;
        rg) owner=BurntSushi; project=ripgrep ;;
    esac
    case "${OS}:${ARCH}" in
        Linux:x86_64|Linux:aarch64) artifact_target="${ARCH}-unknown-linux-musl" ;;
        Darwin:x86_64|Darwin:aarch64) artifact_target="${ARCH}-apple-darwin" ;;
        *) skip "$prog" "no upstream release for ${OS}/${ARCH}"; return ;;
    esac
    latest_url=$(curl -fsSL -o /dev/null -w '%{url_effective}' \
        "https://github.com/${owner}/${project}/releases/latest") || latest_url=
    tag=$(printf '%s\n' "$latest_url" \
        | sed -n 's|.*/releases/tag/\([^/]*\)$|\1|p')
    if [ -z "$tag" ]; then
        unchecked "$prog" "no upstream release found"
        return
    fi
    case "$prog" in
        fd) asset="fd-${tag}-${artifact_target}" ;;
        rg) asset="ripgrep-${tag}-${artifact_target}" ;;
    esac
    url="https://github.com/${owner}/${project}/releases/download/${tag}/${asset}.tar.gz"
    id=$(asset_id "$url")
    if [ -z "$id" ]; then
        unchecked "$prog" "${asset}.tar.gz is not available in ${tag}"
        return
    fi
    if is_current "$prog" "$id"; then
        printf '%s\n' "${prog} is current (${tag})"
        return
    fi
    printf '%s\n' "Downloading ${asset}.tar.gz ..."
    tmpzip=$(mktemp)
    if ! curl -fsSL -o "$tmpzip" "$url"; then
        rm -f "$tmpzip"
        tmpzip=
        skip "$prog" "${asset}.tar.gz is not available in ${tag}"
        return
    fi
    tmpbin=$(mktemp "${DEST}/.${prog}.XXXXXX")
    if ! tar -xzOf "$tmpzip" "${asset}/${prog}" > "$tmpbin"; then
        rm -f "$tmpzip" "$tmpbin"
        tmpzip=
        tmpbin=
        skip "$prog" "${asset}.tar.gz does not contain ${prog}"
        return
    fi
    rm -f "$tmpzip"
    tmpzip=
    install_binary "$prog" "$tmpbin" "$id"
    tmpbin=
}

install_github_archive() {
    archive_prog=$1
    archive_version=$2
    archive_url=$3
    archive_name=${archive_url##*/}
    id=$(asset_id "$archive_url")
    if [ -z "$id" ]; then
        unchecked "$archive_prog" "${archive_name} is not available in ${archive_version}"
        return
    fi
    if is_current "$archive_prog" "$id"; then
        printf '%s\n' "${archive_prog} is current (${archive_version})"
        return
    fi
    printf '%s\n' "Downloading ${archive_name} ..."
    tmpzip=$(mktemp)
    if ! curl -fsSL -o "$tmpzip" "$archive_url"; then
        rm -f "$tmpzip"
        tmpzip=
        skip "$archive_prog" "${archive_name} is not available in ${archive_version}"
        return
    fi
    tmpbin=$(mktemp "${DEST}/.${archive_prog}.XXXXXX")
    if ! tar -xzOf "$tmpzip" "$archive_prog" > "$tmpbin"; then
        rm -f "$tmpzip" "$tmpbin"
        tmpzip=
        tmpbin=
        skip "$archive_prog" "${archive_name} does not contain ${archive_prog}"
        return
    fi
    rm -f "$tmpzip"
    tmpzip=
    install_binary "$archive_prog" "$tmpbin" "$id"
    tmpbin=
}

install_pinact() {
    case "${OS}:${ARCH}" in
        Darwin:x86_64) pinact_target=darwin_amd64 ;;
        Darwin:aarch64) pinact_target=darwin_arm64 ;;
        Linux:x86_64) pinact_target=linux_amd64 ;;
        Linux:aarch64) pinact_target=linux_arm64 ;;
        *) skip pinact "no upstream release for ${OS}/${ARCH}"; return ;;
    esac
    latest_url=$(curl -fsSL -o /dev/null -w '%{url_effective}' \
        "https://github.com/suzuki-shunsuke/pinact/releases/latest") || latest_url=
    tag=$(printf '%s\n' "$latest_url" \
        | sed -n 's|.*/releases/tag/\([^/]*\)$|\1|p')
    if [ -z "$tag" ]; then
        unchecked pinact "no upstream release found"
        return
    fi
    install_github_archive pinact "$tag" \
        "https://github.com/suzuki-shunsuke/pinact/releases/download/${tag}/pinact_${pinact_target}.tar.gz"
}

install_jactionlint() {
    case "${OS}:${ARCH}" in
        Darwin:x86_64) jactionlint_target=darwin_amd64 ;;
        Darwin:aarch64) jactionlint_target=darwin_arm64 ;;
        Linux:x86_64) jactionlint_target=linux_amd64 ;;
        Linux:aarch64) jactionlint_target=linux_arm64 ;;
        *) skip jactionlint "no upstream release for ${OS}/${ARCH}"; return ;;
    esac
    latest_url=$(curl -fsSL -o /dev/null -w '%{url_effective}' \
        "https://github.com/jdx/jactionlint/releases/latest") || latest_url=
    tag=$(printf '%s\n' "$latest_url" \
        | sed -n 's|.*/releases/tag/\([^/]*\)$|\1|p')
    if [ -z "$tag" ]; then
        unchecked jactionlint "no upstream release found"
        return
    fi
    install_github_archive jactionlint "$tag" \
        "https://github.com/jdx/jactionlint/releases/download/${tag}/jactionlint_${tag#v}_${jactionlint_target}.tar.gz"
}

install_mold() {
    if [ "${OS}:${ARCH}" != Linux:x86_64 ]; then
        skip mold "only x86_64 Linux is published"
        return
    fi
    tag=$(curl -fsSL "https://github.com/joshuarli/mold/releases.atom" \
        | sed -n 's|.*<link[^>]*releases/tag/\(mold-musl-[^"]*\)".*|\1|p' | head -n 1) || tag=
    if [ -z "$tag" ]; then
        unchecked mold "no release found"
        return
    fi
    version=${tag#mold-musl-}
    version=${version%-*}
    asset="mold-${version}-x86_64-linux-musl"
    url="https://github.com/joshuarli/mold/releases/download/${tag}/${asset}.tar.gz"
    id=$(asset_id "$url")
    if [ -z "$id" ]; then
        unchecked mold "${asset}.tar.gz is not available in ${tag}"
        return
    fi
    if is_current mold "$id" && [ "$(readlink "${DEST}/ld.mold" 2>/dev/null || :)" = mold ]; then
        own_file "${DEST}/ld.mold"
        printf '%s\n' "mold is current (${tag})"
        return
    fi
    printf '%s\n' "Downloading ${asset}.tar.gz ..."
    tmpzip=$(mktemp)
    if ! curl -fsSL -o "$tmpzip" "$url"; then
        rm -f "$tmpzip"
        tmpzip=
        skip mold "${asset}.tar.gz is not available in ${tag}"
        return
    fi
    tmpbin=$(mktemp "${DEST}/.mold.XXXXXX")
    if ! tar -xzOf "$tmpzip" "${asset}/bin/mold" > "$tmpbin"; then
        rm -f "$tmpzip" "$tmpbin"
        tmpzip=
        tmpbin=
        skip mold "${asset}.tar.gz does not contain bin/mold"
        return
    fi
    rm -f "$tmpzip"
    tmpzip=
    install_binary mold "$tmpbin" "$id"
    tmpbin=
    ln -sf mold "${DEST}/ld.mold"
    own_file "${DEST}/ld.mold"
}

install_python3() {
    case "$OS:$ARCH" in
        Darwin:aarch64) triple=aarch64-apple-darwin ;;
        Linux:x86_64) triple=x86_64-unknown-linux-musl ;;
        Linux:aarch64) triple=aarch64-unknown-linux-musl ;;
        *) skip python3 "no python-build release for ${OS}/${ARCH}"; return ;;
    esac
    if ! jaq_available; then
        install_jaq
        if ! jaq_available; then
            unchecked python3 "jaq is required to find the python-build release"
            return
        fi
    fi
    tag=$(curl -fsSL "https://github.com/joshuarli/python-build/releases.atom" \
        | awk '
            /<entry>/ { in_entry = 1; updated = ""; tag = "" }
            in_entry && /<updated>/ {
                updated = $0
                sub(/^.*<updated>/, "", updated)
                sub(/<.*/, "", updated)
            }
            in_entry && /<link[^>]*releases\/tag\// {
                tag = $0
                sub(/^.*releases\/tag\//, "", tag)
                sub(/".*/, "", tag)
                if (tag ~ /^research-/) tag = ""
            }
            /<\/entry>/ {
                if (updated > newest_updated && tag != "") {
                    newest_updated = updated
                    newest_tag = tag
                }
                in_entry = 0
            }
            END { print newest_tag }
        ') || tag=
    if [ -z "$tag" ]; then
        unchecked python3 "no release found"
        return
    fi
    release_json=$(curl -fsSL "https://api.github.com/repos/joshuarli/python-build/releases/tags/${tag}") || release_json=
    asset_url=$(printf '%s\n' "$release_json" \
        | run_jaq -r --arg triple "$triple" \
            '[.assets[] | select(.name | endswith("-\($triple)-install_only_stripped.tar.gz"))][0].browser_download_url // empty' 2>/dev/null) || asset_url=
    sums_url=$(printf '%s\n' "$release_json" \
        | run_jaq -r '[.assets[] | select(.name == "SHA256SUMS")][0].browser_download_url // empty' 2>/dev/null) || sums_url=
    if [ -z "$asset_url" ] || [ -z "$sums_url" ]; then
        unchecked python3 "${tag} has no ${triple} release asset"
        return
    fi
    id=$(asset_id "$asset_url")
    if [ -z "$id" ]; then
        unchecked python3 "release asset is unreachable"
        return
    fi
    if is_current python3 "$id"; then
        printf '%s\n' "python3 is current (${tag})"
        return
    fi
    release_dir="${PYTHON_BUILD_ROOT}/${tag}"
    if [ -e "$release_dir" ] || [ -L "$release_dir" ]; then
        skip python3 "$release_dir already exists"
        return
    fi
    printf '%s\n' "Downloading python-build ${tag} (${triple}) ..."
    tmpzip=$(mktemp)
    if ! curl -fsSL -o "$tmpzip" "$asset_url"; then
        rm -f "$tmpzip"
        tmpzip=
        skip python3 "download failed"
        return
    fi
    tmpoutput=$(mktemp)
    if ! curl -fsSL -o "$tmpoutput" "$sums_url"; then
        rm -f "$tmpzip" "$tmpoutput"
        tmpzip=
        tmpoutput=
        skip python3 "SHA256SUMS download failed"
        return
    fi
    asset_name=${asset_url##*/}
    expected_sha256=$(grep -F "  ${asset_name}" "$tmpoutput" | awk '{print $1}')
    rm -f "$tmpoutput"
    tmpoutput=
    if [ "${#expected_sha256}" -ne 64 ] || [ "$(sha256_file "$tmpzip")" != "$expected_sha256" ]; then
        rm -f "$tmpzip"
        tmpzip=
        skip python3 "checksum mismatch"
        return
    fi
    if ! tar -tzf "$tmpzip" | awk '
        BEGIN { bad = 0 }
        /^\// { bad = 1 }
        {
            count = split($0, path, "/")
            for (component = 1; component <= count; component++) {
                if (path[component] == "..") bad = 1
            }
        }
        END { exit bad }
    '; then
        rm -f "$tmpzip"
        tmpzip=
        skip python3 "archive contains an invalid path"
