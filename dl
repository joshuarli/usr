repair_dsh_tui_patch() {
    patch_file="${DSH_INSTALL_ROOT}/lib/node_modules/@deepseek-harness-tui/dsh-tui/cordis.patch.yml"
    if [ ! -f "$patch_file" ] || [ -L "$patch_file" ]; then
        skip dsh "dsh-tui patch is missing or is a symlink"
        return 1
    fi
    patch_result=$(python3 - "$patch_file" <<'PY'
import os
import stat
import sys

patch_path = sys.argv[1]
patch_directory, patch_name = os.path.split(patch_path)
directory_fd = os.open(patch_directory, os.O_RDONLY | os.O_DIRECTORY)
temporary_name = None
try:
    patch_fd = os.open(patch_name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=directory_fd)
    patch_info = os.fstat(patch_fd)
    if not stat.S_ISREG(patch_info.st_mode):
        raise ValueError("patch is not a regular file")
    with os.fdopen(patch_fd, "rb") as patch:
        contents = patch.read()
    if b"tool-ralph" not in contents:
        print("current")
        sys.exit(0)
    stale_row = b"- id: tool-ralph\n  disabled: true\n"
    if contents.count(stale_row) != 1:
        raise ValueError("unexpected tool-ralph row")
    temporary_name = f".{patch_name}.{os.getpid()}.tmp"
    temporary_fd = os.open(
        temporary_name,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        stat.S_IMODE(patch_info.st_mode),
        dir_fd=directory_fd,
    )
    with os.fdopen(temporary_fd, "wb") as replacement:
        replacement.write(contents.replace(stale_row, b"", 1))
        replacement.flush()
        os.fchmod(replacement.fileno(), stat.S_IMODE(patch_info.st_mode))
        os.fsync(replacement.fileno())
    os.replace(temporary_name, patch_name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
    temporary_name = None
    print("updated")
except (OSError, ValueError) as error:
    if temporary_name is not None:
        try:
            os.unlink(temporary_name, dir_fd=directory_fd)
        except FileNotFoundError:
            pass
    print(f"cannot repair dsh-tui patch: {error}", file=sys.stderr)
    sys.exit(1)
finally:
    os.close(directory_fd)
PY
) || {
        skip dsh "cannot repair the dsh-tui compatibility patch"
        return 1
    }
    if [ "$patch_result" = updated ]; then
        changed=true
        printf '%s\n' "Removed dsh-tui's stale tool-ralph patch row"
    fi
}

remove_legacy_dsh() {
    legacy_root="${HOME}/.local"
    legacy_package="${legacy_root}/lib/node_modules/@deepseek-ai/dsh"
    legacy_bin="${legacy_root}/bin/dsh"
    [ -d "$legacy_package" ] || return 0
    if [ -L "$legacy_bin" ]; then
        legacy_bin_target=$(readlink "$legacy_bin") || {
            skip dsh "could not inspect the previous global dsh launcher"
            return 1
        }
        case "$legacy_bin_target" in
            ../lib/node_modules/@deepseek-ai/dsh/lib/bin.js|"$legacy_package/lib/bin.js") ;;
            *)
                printf '%s\n' "Keeping existing dsh launcher at $legacy_bin; leaving the previous npm package installed"
                return 0
                ;;
        esac
    elif [ -e "$legacy_bin" ]; then
        printf '%s\n' "Keeping existing dsh launcher at $legacy_bin; leaving the previous npm package installed"
        return 0
    fi
    if ! npm uninstall --global --prefix "$legacy_root" @deepseek-ai/dsh; then
        skip dsh "could not remove the previous global dsh installation"
        return 1
    fi
}

install_cmd() {
    command -v npm >/dev/null 2>&1 || { unchecked cmd "npm is required"; return; }
    node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null) || node_major=
    case "$node_major" in
        ''|*[!0-9]*) unchecked cmd "Node.js 22 or newer is required"; return ;;
    esac
    if [ "$node_major" -lt 22 ]; then
        unchecked cmd "Node.js 22 or newer is required"
        return
    fi
    version=$(npm view command-code@latest version 2>/dev/null) || version=
    printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$' \
        || { unchecked cmd "no npm release found"; return; }
    if [ -e "${DEST}/cmd" ] || [ -L "${DEST}/cmd" ]; then
        if [ "$(readlink "${DEST}/cmd" 2>/dev/null || :)" != "${CMD_INSTALL_ROOT}/bin/cmd" ] \
            || [ ! -s "${STATE}/cmd" ]; then
            skip cmd "${DEST}/cmd already exists outside dl management"
            return
        fi
    fi
    if [ -e "$CMD_INSTALL_ROOT" ] || [ -L "$CMD_INSTALL_ROOT" ]; then
        if [ ! -d "$CMD_INSTALL_ROOT" ] || [ -L "$CMD_INSTALL_ROOT" ] \
            || [ ! -s "${STATE}/cmd" ]; then
            skip cmd "$CMD_INSTALL_ROOT already exists without dl install records"
            return
        fi
    fi
    if [ "$(cat "${STATE}/cmd" 2>/dev/null)" = "$version" ] \
        && [ -x "${CMD_INSTALL_ROOT}/bin/cmd" ] \
        && [ "$(readlink "${DEST}/cmd" 2>/dev/null || :)" = "${CMD_INSTALL_ROOT}/bin/cmd" ]; then
        own_dir "$CMD_INSTALL_ROOT"
        own_file "${DEST}/cmd"
        own_file "${STATE}/cmd"
        printf '%s\n' "cmd is current (${version})"
        return
    fi
    own_parent=${CMD_INSTALL_ROOT%/*}
    own_missing_dirs "$own_parent"
    mkdir -p "$own_parent"
    install_prefix=$CMD_INSTALL_ROOT
    if [ ! -d "$CMD_INSTALL_ROOT" ]; then
        tmpbundle=$(mktemp -d "${CMD_INSTALL_ROOT}.XXXXXX")
        install_prefix=$tmpbundle
    fi
    printf '%s\n' "Installing Command Code (${version}) ..."
    if ! npm install --global --prefix "$install_prefix" "command-code@${version}"; then
        skip cmd "npm install failed"
        return
    fi
    if [ ! -x "${install_prefix}/bin/cmd" ]; then
        skip cmd "npm did not install ${install_prefix}/bin/cmd"
        return
    fi
    if [ "$install_prefix" != "$CMD_INSTALL_ROOT" ]; then
        if [ -e "$CMD_INSTALL_ROOT" ] || [ -L "$CMD_INSTALL_ROOT" ]; then
            skip cmd "$CMD_INSTALL_ROOT appeared during install"
            return
        fi
        mv "$install_prefix" "$CMD_INSTALL_ROOT"
        tmpbundle=
    fi
    own_dir "$CMD_INSTALL_ROOT"
    tmpbinlink=$(mktemp "${DEST}/.cmd.XXXXXX")
    rm -f "$tmpbinlink"
    ln -s "${CMD_INSTALL_ROOT}/bin/cmd" "$tmpbinlink"
    mv -f "$tmpbinlink" "${DEST}/cmd"
    tmpbinlink=
    printf '%s\n' "$version" > "${STATE}/cmd"
    own_file "${DEST}/cmd"
    own_file "${STATE}/cmd"
    changed=true
    printf '%s\n' "Installed ${DEST}/cmd"
}

install_dsh() {
    command -v npm >/dev/null 2>&1 || { unchecked dsh "npm is required"; return; }
    version=$(npm view @deepseek-ai/dsh@next version 2>/dev/null) || version=
    printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$' \
        || { unchecked dsh "no npm release found"; return; }
    tui_version=$(npm view @deepseek-harness-tui/dsh-tui version 2>/dev/null) || tui_version=
    printf '%s\n' "$tui_version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9.-]+)?$' \
        || { unchecked dsh "no dsh-tui release found"; return; }
    command -v pnpm >/dev/null 2>&1 || { skip dsh "pnpm is required by dsh-tui"; return; }
    if [ "$(cat "${STATE}/dsh" 2>/dev/null)" = "$version" ] \
        && [ "$(cat "${STATE}/dsh-tui" 2>/dev/null)" = "$tui_version" ] \
        && [ -x "${DSH_INSTALL_ROOT}/bin/dsh" ] \
        && [ -x "${DSH_INSTALL_ROOT}/bin/dsh-tui" ]; then
        if ! repair_dsh_tui_patch || ! remove_legacy_dsh; then return; fi
        own_dir "$DSH_INSTALL_ROOT"
        own_file "${STATE}/dsh"
        own_file "${STATE}/dsh-tui"
