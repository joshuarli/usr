Include ~/.orbstack/ssh/config

Host github.com
  User git
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/github

Host ghe
  User git
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/github-e
  HostName github.com
  IdentitiesOnly yes

Host *
  # Reuse connections: first ssh opens a socket, subsequent ones multiplex over it.
  # Makes scp/rsync/tab-completion near-instant to already-connected hosts.
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist yes

  # Fast connection setup
  AddKeysToAgent yes
  IdentitiesOnly yes
  ConnectTimeout 5
  ServerAliveInterval 60
  ServerAliveCountMax 3

  PreferredAuthentications publickey
