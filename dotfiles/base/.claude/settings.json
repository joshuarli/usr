{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "64",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "3"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-sound"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "worktree-create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "worktree-remove"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "agent-tier-gate"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "enableArtifact": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "jaq -r '(.model.display_name // \"Unknown\") as $m | (.effort.level // \"n/a\") as $e | (.context_window.used_percentage // 0) as $pct | \"\\($m) \\($e) \\($pct)% ctx\"'"
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": false
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    }
  },
  "emojiCompletionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "autoCompactEnabled": true,
  "disableDeepLinkRegistration": "disable"
}
