{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "64"
  },
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(env git *push*)",
      "Bash(command git *push*)",
      "Bash(sh -c *git *push*)",
      "Bash(bash -c *git *push*)",
      "Bash(cargo fmt)",
      "Bash(cargo fmt *)",
      "Bash(cargo * fmt)",
      "Bash(cargo * fmt *)",
      "Bash(go fmt*)",
      "Bash(npx prettier*)",
      "Bash(uvx ruff format*)",
      "Bash(rustfmt)",
      "Bash(rustfmt *)",
      "Bash(deno fmt)",
      "Bash(deno fmt *)",
      "Bash(prettier)",
      "Bash(prettier *)",
      "Bash(gofmt)",
      "Bash(gofmt *)",
      "Bash(black)",
      "Bash(black *)",
      "Bash(ruff format)",
      "Bash(ruff format *)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-sound"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "worktree-create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "worktree-remove"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "jaq -r '(.model.display_name // \"Unknown\") as $m | (.effort.level // \"n/a\") as $e | (.context_window.used_percentage // 0) as $pct | \"\\($m) \\($e) \\($pct)% ctx\"'"
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-haiku-5-5": {
      "effortLevel": "high"
    }
  },
  "emojiCompletionEnabled": false,
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "autoCompactEnabled": true,
  "disableDeepLinkRegistration": "disable"
}
