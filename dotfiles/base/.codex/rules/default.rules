# Enforces the AGENTS.md workflow rules, which are advice until a rule blocks them.
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing is outward-facing; confirm with the user.",
)
prefix_rule(pattern = ["env", "git", "push"], decision = "prompt", justification = "Pushing is outward-facing; confirm with the user.")
prefix_rule(pattern = ["command", "git", "push"], decision = "prompt", justification = "Pushing is outward-facing; confirm with the user.")

# Formatters: do not run them.
prefix_rule(pattern = ["go", "fmt"], decision = "forbidden", justification = "Do not run formatters.")
prefix_rule(pattern = ["npx", "prettier"], decision = "forbidden", justification = "Do not run formatters.")
prefix_rule(pattern = ["uvx", "ruff", "format"], decision = "forbidden", justification = "Do not run formatters.")
prefix_rule(pattern = ["cargo", "+nightly", "fmt"], decision = "forbidden", justification = "Do not run formatters.")
prefix_rule(pattern = ["cargo", "fmt"], decision = "forbidden", justification = "Do not run formatters.")
prefix_rule(pattern = ["rustfmt"], decision = "forbidden", justification = "Do not run formatters.")
prefix_rule(pattern = ["deno", "fmt"], decision = "forbidden", justification = "Do not run formatters.")
prefix_rule(pattern = ["prettier"], decision = "forbidden", justification = "Do not run formatters.")
prefix_rule(pattern = ["gofmt"], decision = "forbidden", justification = "Do not run formatters.")
prefix_rule(pattern = ["black"], decision = "forbidden", justification = "Do not run formatters.")
prefix_rule(pattern = ["ruff", "format"], decision = "forbidden", justification = "Do not run formatters.")
