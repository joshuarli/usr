{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash#max",
  "shell": "/bin/bash",
  "compaction": {
    "buffer": 600000
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "pi-subagent-bridge": {
        "type": "local",
        "command": [
          "/Users/josh/.local/share/nodejs/current/bin/node",
          "--experimental-strip-types",
          "/Users/josh/usr/tools/pi-subagent-bridge/src/server.ts"
        ],
        "codemode": false
      }
    }
  }
}
