{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/hy4-flash-free",
  "shell": "/bin/bash",
  "compaction": {
    "buffer": 600000
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pi-subagent-bridge",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "pi-subagent-bridge *",
      "effect": "deny"
    }
  ],
  "agents": {
    "scout": {
      "description": "Read-only codebase scout: search and summarize, never edit",
      "mode": "subagent",
      "model": "opencode/hy4-flash-free#high",
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "mechanic": {
      "description": "Applies well-specified mechanical changes across files",
      "mode": "subagent",
      "model": "opencode/hy4-flash-free#high"
    },
    "worker": {
      "description": "Implements coherent, well-specified component-sized slices",
      "mode": "subagent",
      "model": "opencode/hy4-flash-free#high"
    },
    "expert": {
      "description": "Deep reasoning for hard, ambiguous, or high-risk slices",
      "mode": "subagent",
      "model": "opencode/hy4-flash-free#high"
    }
  }
}
