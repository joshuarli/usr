{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": false
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "permissions": "autoaccept"
  },
  "animations": false,
  "keybinds": {
    "prompt.editor": "ctrl+g",
    "session.first": "home,alt+home"
  },
  "tabs": {
    "mode": "auto"
  }
}
