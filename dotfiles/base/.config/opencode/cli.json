{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word"
  },
  "terminal": {
    "title": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "keybinds": {
    "prompt.editor": "ctrl+g",
    "session.first": "home,alt+home"
  }
}
