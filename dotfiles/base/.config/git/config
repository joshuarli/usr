#	signingkey = /Users/josh/.ssh/github.pub

[url "git@github.com:"]
    insteadOf = https://github.com/

[core]
    # Filesystem case behavior is detected separately for each repository.
    # pager = builtin:diff-pretty

    # commit-graph for fast traversal
    commitGraph = true

    # cache untracked dir mtimes to avoid rescanning unchanged dirs
    untrackedCache = true

    # Enable per repository after the built-in daemon starts successfully.
    #fsmonitor = true
    #fsmonitorHookVersion = 2
    #splitIndex = true

    # parallel index stat() calls
    preloadIndex = true

    # multi-pack-index for faster object lookup across packs
    multiPackIndex = true

[alias]
    amend = commit --amend -v
    b = blame -c --date=short
    c = checkout
    d = diff
    dc = diff --cached
    s = show
    l = log
    unstage = reset --

[push]
    default = current
    autoSetupRemote = true

[branch]
    autoSetupMerge = always

[pull]
    rebase = true

[rebase]
    autoStash = true

[diff]
    algorithm = histogram

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled = true

[transfer]
    fsckObjects = true

[gc]
    writeCommitGraph = true

[fetch]
    writeCommitGraph = true
    negotiationAlgorithm = skipping
    # Concurrency for eligible multi-remote and submodule fetches.
    parallel = 0

[commitGraph]
    changedPaths = true
    changedPathsVersion = 2

[feature]
    manyFiles = true

[index]
    version = 4
    threads = true

[pack]
    threads = 0
    writeBitmapHashCache = true
    allowPackReuse = multi
    writeBitmapLookupTable = true

[repack]
    writeBitmaps = true

[checkout]
    workers = 0

[protocol]
    version = 2

