{
  "schema_version": 1,
  "provider": "meta",
  "model": "muse-spark-1.3",
  "reasoning_effort": "high",
  "model_reasoning_efforts": {
    "muse-spark-1.3": "high",
    "muse-wonder-1.0": "high"
  },
  "tui": {
    "foreign_context_notice_shown": true
  },
  "mcpServers": {
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    }
  },
  "contributor_mode_enabled": true,
  "contributor_mode_disclosure_acknowledged": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-sound",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "notify-sound",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "schema_version": 1,
    "default_profile": ":unrestricted"
  },
  "telemetry": {
    "enabled": false
  }
}