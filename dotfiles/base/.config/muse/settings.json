{
  "schema_version": 1,
  "model": "muse-spark-1.3",
  "reasoning_effort": "high",
  "telemetry": {
    "enabled": false
  },
  "permissions": {
    "defaultMode": "allowAll",
    "deny": [
      "Bash(cargo fmt)",
      "Bash(cargo fmt *)",
      "Bash(cargo * fmt)",
      "Bash(cargo * fmt *)",
      "Bash(go fmt*)",
      "Bash(npx prettier*)",
      "Bash(uvx ruff format*)",
      "Bash(rustfmt)",
      "Bash(rustfmt *)",
      "Bash(deno fmt)",
      "Bash(deno fmt *)",
      "Bash(prettier)",
      "Bash(prettier *)",
      "Bash(gofmt)",
      "Bash(gofmt *)",
      "Bash(black)",
      "Bash(black *)",
      "Bash(ruff format)",
      "Bash(ruff format *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git * push)",
      "Bash(git * push *)",
      "Bash(env git *push*)",
      "Bash(command git *push*)",
      "Bash(sh -c *git *push*)",
      "Bash(bash -c *git *push*)"
    ]
  },
  "mcpServers": {
    "sentry": {
      "url": "https://mcp.sentry.dev/mcp"
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    }
  }
}
