#!/bin/sh
jemalloc=/usr/lib/libjemalloc.so.2
for loader in /lib/ld-musl-*.so.1; do
    [ -e "$loader" ] || break
    [ -r "$jemalloc" ] || { echo "rustc: musl host without $jemalloc; run make sync" >&2; exit 127; }
    case ":${LD_PRELOAD:-}:" in
        *":$jemalloc:"*) ;;
        *) LD_PRELOAD="$jemalloc${LD_PRELOAD:+:$LD_PRELOAD}"; export LD_PRELOAD ;;
    esac
    break
done
exec rustc "$@"
