#!/bin/sh
# worker-campaign - wait on every pi-subagent-bridge lane in one or more repos.
#
# Usage:
#   worker-campaign wait [--timeout DURATION] [ROOT...]
#   worker-campaign ack ID...
#   worker-campaign list [ROOT...]
#
# Sessions are discovered from each ROOT's .work/worker-bridge/usrw_*.json, so
# no lane table is registered by hand. ROOTs come from the arguments or, when
# none are given, from $WORKER_CAMPAIGN_ROOTS (colon-separated). wait blocks in
# the background and prints "<id> <state> <cwd> <title>" once for every terminal
# session that has not been acknowledged, exiting 0; with --timeout DURATION it
# prints a one-line tick with the running count and exits 2 instead. Acks are
# stored one ID per line under ${XDG_STATE_HOME:-$HOME/.local/state}/worker-campaign/acked.
# Terminal state comes from worker-watch's own evidence: a Command Code result
# record and its subtype, a Command Code process gone without one, or a Pi SDK
# child record.

set -u

prog=${0##*/}

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }
usage() {
    printf 'usage: %s wait [--timeout DURATION] [ROOT...]\n       %s ack ID...\n       %s list [ROOT...]\n' "$prog" "$prog" "$prog" >&2
    exit 1
}

command -v jaq >/dev/null 2>&1 || die "jaq is required"

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P) ||
    die "cannot resolve the worker-campaign directory"
if [ -f "$script_dir/worker-watch" ]; then
    watch="$script_dir/worker-watch"
else
    watch=$(command -v worker-watch) || die "worker-watch not found beside $prog or in PATH"
fi

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
acked_file="$state_home/worker-campaign/acked"

newline='
'
tab=$(printf '\t')

parse_duration() {
    case $1 in
        '' | *[!0-9smh]*) return 1 ;;
    esac
    case $1 in
        *s) seconds=${1%s} ;;
        *m) seconds=${1%m} ;;
        *h) seconds=${1%h} ;;
        *) seconds=$1 ;;
    esac
    case $seconds in '' | *[!0-9]*) return 1 ;; esac
    case $1 in
        *m) seconds=$((seconds * 60)) ;;
        *h) seconds=$((seconds * 3600)) ;;
    esac
}

human_age() {
    if [ "$1" -lt 60 ]; then
        printf '%ss' "$1"
    elif [ "$1" -lt 3600 ]; then
        printf '%sm' "$(($1 / 60))"
    elif [ "$1" -lt 86400 ]; then
        printf '%sh%sm' "$(($1 / 3600))" "$(($1 % 3600 / 60))"
    else
        printf '%sd%sh' "$(($1 / 86400))" "$(($1 % 86400 / 3600))"
    fi
}

mtime() {
    stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || date +%s
}

is_acked() {
    [ -f "$acked_file" ] && grep -Fxq "$1" "$acked_file"
}

roots=
add_root() {
    [ -n "$1" ] || return 0
    absolute=$(CDPATH='' cd -- "$1" 2>/dev/null && pwd -P) || die "no such root: $1"
    old_ifs=$IFS
    IFS=$newline
    for existing in $roots; do
        if [ "$existing" = "$absolute" ]; then
            IFS=$old_ifs
            return 0
        fi
    done
    IFS=$old_ifs
    roots="$roots$absolute$newline"
}

use_env_roots() {
    rest=${WORKER_CAMPAIGN_ROOTS:-}
    while [ -n "$rest" ]; do
        root=${rest%%:*}
        case $rest in
            *:*) rest=${rest#*:} ;;
            *) rest= ;;
        esac
        add_root "$root"
    done
}

sessions() {
    seen=
    old_ifs=$IFS
    IFS=$newline
    for root in $roots; do
        [ -n "$root" ] || continue
        for record in "$root"/.work/worker-bridge/usrw_*.json; do
            [ -f "$record" ] || continue
            id=$(jaq -r '.id // empty' "$record" 2>/dev/null)
            [ -n "$id" ] || continue
            case " $seen " in
                *" $id "*) continue ;;
            esac
            seen="$seen $id"
            cwd=$(jaq -r '.cwd // empty' "$record" 2>/dev/null)
            [ -n "$cwd" ] || cwd=$root
            title=$(jaq -r '.title // "" | tostring | gsub("[\\t\\r\\n]+"; " ")' "$record" 2>/dev/null)
            continuations=$(jaq -r 'if .continuations == null then empty else .continuations end' "$record" 2>/dev/null)
            steers=$(jaq -r 'if .steers == null then empty else .steers end' "$record" 2>/dev/null)
            state=$(sh "$watch" --state "$root" "$id" 2>/dev/null)
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                "$id" "$state" "$cwd" "$title" "$record" "$continuations" "$steers"
        done
    done
    IFS=$old_ifs
}

budget_suffix() {
    suffix=
    [ -n "$1" ] && suffix="$suffix continuations=$1"
    [ -n "$2" ] && suffix="$suffix steers=$2"
    printf '%s' "$suffix"
}

cmd_list() {
    for arg in "$@"; do
        add_root "$arg"
    done
    [ -n "$roots" ] || use_env_roots
    [ -n "$roots" ] || die "no ROOT given and WORKER_CAMPAIGN_ROOTS is empty"
    now=$(date +%s)
    sessions | while IFS=$tab read -r id state cwd title record continuations steers; do
        [ -n "$id" ] || continue
        age=$(human_age $((now - $(mtime "$record"))))
        printf '%s %s %s %s%s\n' "$id" "$state" "$age" "$cwd" "$(budget_suffix "$continuations" "$steers")"
    done
}

cmd_ack() {
    [ "$#" -ge 1 ] || usage
    directory=$(dirname -- "$acked_file")
    mkdir -p "$directory" || die "cannot create $directory"
    chmod 700 "$directory" 2>/dev/null
    tmp="$acked_file.$$"
    {
        if [ -f "$acked_file" ]; then cat "$acked_file"; fi
        for id in "$@"; do
            [ -n "$id" ] && printf '%s\n' "$id"
        done
    } | sort -u > "$tmp" || die "cannot write $tmp"
    chmod 600 "$tmp" 2>/dev/null
    mv -f "$tmp" "$acked_file" || die "cannot replace $acked_file"
}

cmd_wait() {
    timeout=
    while [ "$#" -ge 1 ]; do
        case $1 in
            --timeout)
                [ "$#" -ge 2 ] || usage
                parse_duration "$2" || die "invalid duration: $2"
                timeout=$seconds
                shift 2
                ;;
            --timeout=*)
                parse_duration "${1#--timeout=}" || die "invalid duration: ${1#--timeout=}"
                timeout=$seconds
                shift
                ;;
            --)
                shift
                break
                ;;
            -*)
                usage
                ;;
            *)
                break
                ;;
        esac
    done
    for arg in "$@"; do
        add_root "$arg"
    done
    [ -n "$roots" ] || use_env_roots
    [ -n "$roots" ] || die "no ROOT given and WORKER_CAMPAIGN_ROOTS is empty"

    deadline=
    [ -n "$timeout" ] && deadline=$(( $(date +%s) + timeout ))
    while :; do
        polled=$(sessions | {
            report=
            terminal=0
            running=0
            while IFS=$tab read -r id state cwd title record continuations steers; do
                [ -n "$id" ] || continue
                is_acked "$id" && continue
                case $state in
                    (succeeded | failed | turn_limit | interrupted)
                        report="$report$id $state $cwd $title$newline"
                        terminal=$((terminal + 1))
                        ;;
                    (*)
                        running=$((running + 1))
                        ;;
                esac
            done
            printf '%s %s\n' "$terminal" "$running"
            printf '%s' "$report"
        })
        counts=$(printf '%s\n' "$polled" | head -n 1)
        terminal=${counts%% *}
        running=${counts##* }
        if [ "$terminal" -gt 0 ]; then
            printf '%s\n' "$polled" | tail -n +2
            exit 0
        fi
        if [ -n "$deadline" ]; then
            now=$(date +%s)
            if [ "$now" -ge "$deadline" ]; then
                printf 'tick: %s running\n' "$running"
                exit 2
            fi
            nap=$((deadline - now))
            [ "$nap" -gt 10 ] && nap=10
        else
            nap=10
        fi
        sleep "$nap"
    done
}

command=${1:-}
if [ "$#" -ge 1 ]; then shift; fi
case $command in
    wait) cmd_wait "$@" ;;
    ack) cmd_ack "$@" ;;
    list) cmd_list "$@" ;;
    *) usage ;;
esac
