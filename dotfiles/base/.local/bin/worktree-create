#!/bin/sh
# WorktreeCreate hook for Claude Code: put every worktree at <repo>/.work/wt/<name>.
# Claude's default is <repo>/.claude/worktrees; the working-files rule keeps all
# worktrees and state under .work, and nothing in /tmp. Reads the hook JSON on
# stdin and prints the worktree path as the last stdout line; git's own output
# goes to stderr so it cannot be mistaken for the path.
set -eu

input=$(cat)
name=$(printf '%s' "$input" | jaq -r .name)
cwd=$(printf '%s' "$input" | jaq -r .cwd)

case "$name" in
    ''|null|*/*|.*) printf '%s\n' "worktree-create: refusing worktree name '$name'" >&2; exit 1 ;;
esac

# --git-common-dir is the main repository's .git even when cwd is inside another
# worktree, so a worktree started from a lane still lands beside its siblings.
common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir)
root=$(dirname "$common")
dir="$root/.work/wt/$name"

# Ignore .work through the repo-local exclude file so no tracked file changes.
exclude=$(git -C "$root" rev-parse --path-format=absolute --git-path info/exclude)
mkdir -p "$(dirname "$exclude")"
grep -qxF '/.work/' "$exclude" 2>/dev/null || printf '%s\n' '/.work/' >> "$exclude"

# Branch from the checked-out commit, not the remote default branch, so a lane
# starts from the campaign branch it was launched from.
git -C "$root" worktree add --no-track -b "worktree-$name" "$dir" HEAD >&2
printf '%s\n' "$dir"
