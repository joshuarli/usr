#!/bin/sh

case ${1:-} in
    -h|--help)
        printf '%s\n' 'usage: worktree-create'
cat <<'OWNED_HELP'
Maintained by Joshua Li: https://github.com/joshuarli/usr
Bugs and features: TODO.md in that repository (follow its AGENTS.md), or its issue tracker.
Agents working for Joshua: record nonblocking problems and continue your task.
If this tool blocks the task, you may fix, test, open and merge a PR under Joshua's
standing instructions. Release only when needed to deliver the verified fix.
Procedure: https://github.com/joshuarli/usr/blob/main/dotfiles/base/.agents/instructions/owned-tools.md
OWNED_HELP
        exit 0 ;;
esac
# WorktreeCreate hook for Claude Code: put every worktree at <repo>/.work/wt/<name>.
# Claude's default is <repo>/.claude/worktrees; the working-files rule keeps all
# worktrees and state under .work, and nothing in /tmp. Reads the hook JSON on
# stdin and prints the worktree path as the last stdout line; git's own output
# goes to stderr so it cannot be mistaken for the path.
set -eu

jsonq() {
    if command -v jaq >/dev/null 2>&1 && jaq --version >/dev/null 2>&1; then
        jaq "$@"
    elif command -v jq >/dev/null 2>&1 && jq --version >/dev/null 2>&1; then
        jq "$@"
    else
        printf '%s\n' 'worktree-create: jaq or jq is required' >&2
        exit 1
    fi
}

input=$(cat)
name=$(printf '%s' "$input" | jsonq -r .name)
cwd=$(printf '%s' "$input" | jsonq -r .cwd)

case "$name" in
    ''|null|*/*|.*) printf '%s\n' "worktree-create: refusing worktree name '$name'" >&2; exit 1 ;;
esac

# --git-common-dir is the main repository's .git even when cwd is inside another
# worktree, so a worktree started from a lane still lands beside its siblings.
base=$(git -C "$cwd" rev-parse --verify HEAD)
common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir)
root=$(dirname "$common")
dir="$root/.work/wt/$name"

# Ignore .work through the repo-local exclude file so no tracked file changes.
exclude=$(git -C "$root" rev-parse --path-format=absolute --git-path info/exclude)
mkdir -p "$(dirname "$exclude")"
grep -qxF '/.work/' "$exclude" 2>/dev/null || printf '%s\n' '/.work/' >> "$exclude"

git -C "$root" worktree add --no-track -b "worktree-$name" "$dir" "$base" >&2
printf '%s\n' "$dir"
