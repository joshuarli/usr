#!/bin/sh
venv=${AGENT_MEMORY_VENV:-$HOME/d/agent-memory/.venv}
command="$venv/bin/agent-sessions-serve"
if [ ! -x "$command" ]; then
	>&2 printf 'agent-sessions-serve: %s is not installed; install agent-memory into %s (see its docs/install.md) or set AGENT_MEMORY_VENV\n' "$command" "$venv"
	exit 127
fi
exec "$command" "$@"
