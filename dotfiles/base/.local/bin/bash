#!/bin/sh
set -eu
name="bash"
config="${XDG_CONFIG_HOME:-${HOME:-}/.config}/sh/config.sh"
if [ -r "$config" ]; then
    # shellcheck disable=SC1090 # resolved from XDG_CONFIG_HOME or HOME at runtime
    . "$config"
else
    echo "$name: $config not readable, continuing without shared environment" >&2
fi
case "$0" in
    /*) self="$0" ;;
    */*) self="$PWD/$0" ;;
    *) self="$0" ;;
esac
find_real() {
    rest="${PATH:-/usr/bin:/bin}:"
    while [ -n "$rest" ]; do
        dir=${rest%%:*}
        rest=${rest#*:}
        [ -n "$dir" ] || dir=.
        candidate="$dir/$1"
        case "$candidate" in
            "${HOME:-}""/.local/bin/"*|"${self%/*}/"*) continue ;;
        esac
        if [ -x "$candidate" ] && [ ! -d "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}
real=$(find_real "$name") || real=""
if [ -z "$real" ]; then
    command_mode=false
    for arg in "$@"; do
        case "$arg" in
            --*) ;;
            -*c*) command_mode=true; break ;;
            -*) ;;
            *) break ;;
        esac
    done
    if [ "$command_mode" = true ]; then
        real=/bin/sh
        pending=$#
        rewriting=true
        while [ "$pending" -gt 0 ]; do
            arg=$1
            shift
            pending=$((pending - 1))
            if [ "$rewriting" = true ]; then
                case "$arg" in
                    -l|--login) continue ;;
                    -lc|-cl) arg=-c; rewriting=false ;;
                    -c) rewriting=false ;;
                    -*) ;;
                    *) rewriting=false ;;
                esac
            fi
            set -- "$@" "$arg"
        done
    fi
fi
if [ -z "$real" ]; then
    echo "$name: no system shell found" >&2
    exit 127
fi
exec "$real" "$@"
