#!/usr/bin/env python3
"""Pin GitHub Actions to immutable commits using git, without third-party packages."""

import os
import sys


def _source_root() -> str:
    here = os.path.dirname(os.path.realpath(__file__))
    root = os.path.dirname(os.path.dirname(os.path.dirname(os.path.dirname(here))))
    return os.path.join(root, "tools", "pinact", "src")


def main(argv: list[str] | None = None) -> int:
    if sys.version_info < (3, 11):
        print("pinact requires Python 3.11 or newer", file=sys.stderr)
        return 2
    root = _source_root()
    if root not in sys.path:
        sys.path.insert(0, root)
    from pinact.cli import main as run
    return run(argv)


if __name__ == "__main__":
    sys.exit(main())
