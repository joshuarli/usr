#!/usr/bin/env python3

import argparse
import json
import math
import os
import re
import socket
import ssl
import sys
import time
import urllib.error
import urllib.request
from dataclasses import dataclass


MAX_REQUEST_BYTES = 12_288
MAX_RESPONSE_BYTES = 65_536
MAX_JSON_DEPTH = 32
REQUEST_TIMEOUT_SECONDS = 10
CONTEXT_WINDOW_TOKENS = 24_576
MODELS = {
    "clef-flash": "@cf/cloudflare/clef-flash",
    "clef": "@cf/cloudflare/clef",
}
EVAL_TIERS = ("scout", "mechanic", "worker", "expert", "god")
EVAL_SPLITS = ("development", "held-out")
QUESTION_ID = re.compile(r"[A-Za-z0-9_.-]{1,100}\Z")
ACCOUNT_ID = re.compile(r"[A-Fa-f0-9]{32}\Z")


class InvalidInput(Exception):
    def __init__(self, reason="invalid_input"):
        self.reason = reason
        super().__init__(reason)


class InvalidProviderResponse(Exception):
    pass


@dataclass(frozen=True)
class HttpResponse:
    status: int
    body: bytes


def reject_constant(value):
    raise ValueError(value)


def parse_float(value):
    parsed = float(value)
    if not math.isfinite(parsed):
        raise ValueError("non-finite number")
    return parsed


def object_without_duplicates(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate object key")
        result[key] = value
    return result


def has_unpaired_surrogate(value):
    pending = [value]
    while pending:
        current = pending.pop()
        if isinstance(current, str):
            if any(0xD800 <= ord(character) <= 0xDFFF for character in current):
                return True
        elif isinstance(current, dict):
            pending.extend(current.keys())
            pending.extend(current.values())
        elif isinstance(current, list):
            pending.extend(current)
    return False


def parse_json_bytes(data):
    try:
        value = json.loads(
            data.decode("utf-8"),
            parse_constant=reject_constant,
            parse_float=parse_float,
            object_pairs_hook=object_without_duplicates,
        )
        if has_unpaired_surrogate(value):
            raise ValueError("invalid Unicode scalar")
        return value
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError, ValueError) as error:
        raise InvalidInput("invalid_json") from error


def validate_json_values(value):
    if has_unpaired_surrogate(value):
        raise InvalidInput("invalid_unicode")
    pending = [(value, 1)]
    while pending:
        current, depth = pending.pop()
        if isinstance(current, dict):
            if depth > MAX_JSON_DEPTH:
                raise InvalidInput("nesting_too_deep")
            pending.extend((child, depth + 1) for child in current.values())
        elif isinstance(current, list):
            if depth > MAX_JSON_DEPTH:
                raise InvalidInput("nesting_too_deep")
            pending.extend((child, depth + 1) for child in current)
        elif isinstance(current, float) and not math.isfinite(current):
            raise InvalidInput("invalid_input")


def parse_request_bytes(data):
    if len(data) > MAX_REQUEST_BYTES:
        raise InvalidInput("request_too_large")
    request = parse_json_bytes(data)
    validate_request(request)
    return request


def is_json_description(value, allow_null=False):
    return isinstance(value, (str, dict, list)) or (allow_null and value is None)


def validate_request(request):
    validate_json_values(request)
    if not isinstance(request, dict) or set(request) != {"state", "questions"}:
        raise InvalidInput()
    if not isinstance(request["state"], (str, dict, list)):
        raise InvalidInput()
    questions = request["questions"]
    if not isinstance(questions, dict) or not 1 <= len(questions) <= 64:
        raise InvalidInput()
    for question_id, question in questions.items():
        if not isinstance(question_id, str) or not QUESTION_ID.fullmatch(question_id):
            raise InvalidInput()
        if not isinstance(question, dict):
            raise InvalidInput()
        question_type = question.get("type")
        if not isinstance(question_type, str) or question_type not in {"noul", "choice", "score"}:
            raise InvalidInput()
        allowed_fields = {"type", "instructions", "criteria"}
        if set(question) - allowed_fields or "instructions" not in question:
            raise InvalidInput()
        instructions = question["instructions"]
        if isinstance(instructions, str):
            if not instructions.strip():
                raise InvalidInput()
        elif not isinstance(instructions, (dict, list)):
            raise InvalidInput()
        if question_type == "noul":
            if set(question) - {"type", "instructions", "criteria"}:
                raise InvalidInput()
            if "criteria" in question:
                criteria = question["criteria"]
                if not isinstance(criteria, dict) or set(criteria) - {"true", "false"}:
                    raise InvalidInput()
                if any(not is_json_description(value, allow_null=True) for value in criteria.values()):
                    raise InvalidInput()
        elif question_type == "choice":
            criteria = question.get("criteria")
            if not isinstance(criteria, dict) or not 2 <= len(criteria) <= 255:
                raise InvalidInput()
            if any(not isinstance(option, str) or not option for option in criteria):
                raise InvalidInput()
            if any(not is_json_description(value, allow_null=True) for value in criteria.values()):
                raise InvalidInput()
        else:
            criteria = question.get("criteria")
            if not isinstance(criteria, list) or not 2 <= len(criteria) <= 10:
                raise InvalidInput()
            if any(not is_json_description(value) for value in criteria):
                raise InvalidInput()
    return request


def parse_model(value):
    if not isinstance(value, str) or value not in MODELS:
        raise InvalidInput("invalid_model")
    return value


def endpoint(account_id, model):
    return f"https://api.cloudflare.com/client/v4/accounts/{account_id}/ai/run/{MODELS[model]}"


class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, response, code, message, headers, new_url):
        return None


def http_post(url, headers, body, timeout):
    request = urllib.request.Request(url, data=body, headers=headers, method="POST")
    opener = urllib.request.build_opener(NoRedirectHandler)
    try:
        with opener.open(request, timeout=timeout) as response:
            return HttpResponse(response.status, response.read(MAX_RESPONSE_BYTES + 1))
    except urllib.error.HTTPError as error:
        body = b"" if 300 <= error.code < 400 else error.read(MAX_RESPONSE_BYTES + 1)
        return HttpResponse(error.code, body)


def config_status(env):
    missing = [
        name
        for name in ("CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN")
        if not env.get(name, "").strip()
    ]
    if missing:
        return {"status": "unavailable", "reason": "missing_configuration", "missing": missing}
    if not ACCOUNT_ID.fullmatch(env["CLOUDFLARE_ACCOUNT_ID"].strip()):
        return {"status": "unavailable", "reason": "invalid_configuration"}
    token = env["CLOUDFLARE_API_TOKEN"]
    if any(character in token for character in "\r\n\x00"):
        return {"status": "unavailable", "reason": "invalid_configuration"}
    return {"status": "ok", "configured": True}


def numeric_probability(value):
    return finite_number(value) and 0 <= value <= 1


def finite_number(value):
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        return False
    try:
        return math.isfinite(value)
    except OverflowError:
        return False


def validate_probabilities(probabilities, expected_ids):
    if not isinstance(probabilities, dict) or set(probabilities) != set(expected_ids):
        raise InvalidProviderResponse()
    values = list(probabilities.values())
    if not all(numeric_probability(value) for value in values):
        raise InvalidProviderResponse()
    if abs(sum(values) - 1.0) > 0.01:
        raise InvalidProviderResponse()
    return probabilities


def validate_confidence(value):
    if not numeric_probability(value):
        raise InvalidProviderResponse()


def validate_result(request, model, result):
    try:
        model = parse_model(model)
    except InvalidInput as error:
        raise InvalidProviderResponse() from error
    if not isinstance(result, dict) or set(result) != {"model", "answers", "usage"}:
        raise InvalidProviderResponse()
    model_name = result["model"]
    if not isinstance(model_name, str) or model_name not in {model, MODELS[model]}:
        raise InvalidProviderResponse()
    answers = result["answers"]
    question_ids = set(request["questions"])
    if not isinstance(answers, dict) or set(answers) != question_ids:
        raise InvalidProviderResponse()
    for question_id, question in request["questions"].items():
        answer = answers[question_id]
        if not isinstance(answer, dict) or answer.get("type") != question["type"]:
            raise InvalidProviderResponse()
        question_type = question["type"]
        if question_type == "noul":
            if set(answer) != {"type", "noul"} or not numeric_probability(answer["noul"]):
                raise InvalidProviderResponse()
        elif question_type == "choice":
            if set(answer) != {"type", "choice", "probabilities", "confidence"}:
                raise InvalidProviderResponse()
            options = set(question["criteria"])
            probabilities = validate_probabilities(answer["probabilities"], options)
            if not isinstance(answer["choice"], str) or answer["choice"] not in options:
                raise InvalidProviderResponse()
            if probabilities[answer["choice"]] != max(probabilities.values()):
                raise InvalidProviderResponse()
            validate_confidence(answer["confidence"])
        else:
            if set(answer) != {"type", "score", "legend", "probabilities", "confidence"}:
                raise InvalidProviderResponse()
            indexes = {str(index) for index in range(len(question["criteria"]))}
            probabilities = validate_probabilities(answer["probabilities"], indexes)
            if not isinstance(answer["legend"], dict) or set(answer["legend"]) != indexes:
                raise InvalidProviderResponse()
            score = answer["score"]
            if (
                not finite_number(score)
                or not 0 <= score <= len(question["criteria"]) - 1
            ):
                raise InvalidProviderResponse()
            weighted_score = sum(int(index) * probability for index, probability in probabilities.items())
            if abs(score - weighted_score) > 0.01:
                raise InvalidProviderResponse()
            validate_confidence(answer["confidence"])
    usage = result["usage"]
    if not isinstance(usage, dict) or set(usage) != {"input_tokens", "output_tokens"}:
        raise InvalidProviderResponse()
    if any(
        not isinstance(usage[name], int) or isinstance(usage[name], bool) or usage[name] < 0
        for name in ("input_tokens", "output_tokens")
    ):
        raise InvalidProviderResponse()
    return result


def error_codes(body):
    if len(body) > MAX_RESPONSE_BYTES:
        return set()
    try:
        envelope = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError):
        return set()
    if not isinstance(envelope, dict) or not isinstance(envelope.get("errors"), list):
        return set()
    return {
        error["code"]
        for error in envelope["errors"]
        if isinstance(error, dict) and isinstance(error.get("code"), int)
    }


def provider_error_reason(response):
    codes = error_codes(response.body)
    if 3036 in codes:
        return "quota_exhausted"
    if 3040 in codes:
        return "capacity"
    if 5035 in codes:
        return "paid_plan_required"
    if response.status in {401, 403}:
        return "authentication"
    if response.status == 408 or 3007 in codes or 3008 in codes:
        return "timeout"
    if response.status == 429:
        return "rate_limited"
    if response.status >= 500:
        return "provider_failure"
    return "provider_failure"


def transport_error_reason(error):
    if isinstance(error, (TimeoutError, socket.timeout)):
        return "timeout"
    if isinstance(error, ssl.SSLError):
        return "tls_error"
    if isinstance(error, socket.gaierror):
        return "dns_error"
    if isinstance(error, urllib.error.URLError):
        reason = error.reason
        if isinstance(reason, (TimeoutError, socket.timeout)):
            return "timeout"
        if isinstance(reason, ssl.SSLError):
            return "tls_error"
        if isinstance(reason, socket.gaierror):
            return "dns_error"
        if isinstance(reason, OSError):
            return "network_error"
    if isinstance(error, OSError):
        return "network_error"
    raise error


def run_decision(request, model="clef-flash", env=None, transport=http_post, clock=time.monotonic):
    try:
        validate_request(request)
        model = parse_model(model)
        body = json.dumps(
            {"model": model, **request},
            ensure_ascii=False,
            allow_nan=False,
            separators=(",", ":"),
        ).encode("utf-8")
        if len(body) > MAX_REQUEST_BYTES:
            raise InvalidInput("request_too_large")
    except (InvalidInput, TypeError, ValueError) as error:
        reason = error.reason if isinstance(error, InvalidInput) else "invalid_input"
        return {"status": "invalid", "reason": reason}
    if env is None:
        env = os.environ
    configuration = config_status(env)
    if configuration["status"] != "ok":
        return configuration
    headers = {
        "Authorization": f"Bearer {env['CLOUDFLARE_API_TOKEN']}",
        "Content-Type": "application/json",
    }
    start = clock()
    try:
        response = transport(
            endpoint(env["CLOUDFLARE_ACCOUNT_ID"].strip(), model),
            headers,
            body,
            REQUEST_TIMEOUT_SECONDS,
        )
    except (TimeoutError, socket.timeout, ssl.SSLError, socket.gaierror, urllib.error.URLError, OSError) as error:
        return {"status": "unavailable", "reason": transport_error_reason(error)}
    elapsed_ms = round((clock() - start) * 1000, 3)
    if len(response.body) > MAX_RESPONSE_BYTES:
        return {"status": "unavailable", "reason": "invalid_provider_response"}
    if response.status != 200:
        return {"status": "unavailable", "reason": provider_error_reason(response)}
    try:
        envelope = parse_json_bytes(response.body)
        if (
            not isinstance(envelope, dict)
            or set(envelope) != {"success", "errors", "messages", "result"}
            or not isinstance(envelope["success"], bool)
            or not isinstance(envelope["errors"], list)
            or not isinstance(envelope["messages"], list)
        ):
            raise InvalidProviderResponse()
        if envelope["success"] is not True or envelope["errors"]:
            return {"status": "unavailable", "reason": provider_error_reason(response)}
        result = validate_result(request, model, envelope["result"])
        token_use = result["usage"]["input_tokens"] + result["usage"]["output_tokens"]
        if token_use >= CONTEXT_WINDOW_TOKENS:
            return {"status": "unavailable", "reason": "context_limit"}
        return {"status": "ok", "result": result, "elapsed_ms": elapsed_ms}
    except (InvalidInput, InvalidProviderResponse, TypeError, ValueError, RecursionError):
        return {"status": "unavailable", "reason": "invalid_provider_response"}


def doctor(env=None):
    if env is None:
        env = os.environ
    return config_status(env)


def validate_eval_options(live, max_calls):
    if live:
        if (
            not isinstance(max_calls, int)
            or isinstance(max_calls, bool)
            or not 1 <= max_calls <= 50
        ):
            raise InvalidInput("invalid_eval_options")
    elif max_calls is not None:
        raise InvalidInput("invalid_eval_options")


def validate_eval_tier(value):
    if not isinstance(value, str) or value not in EVAL_TIERS:
        raise InvalidInput("invalid_evaluation_case")
    return value


def validate_recorded_prediction(prediction, candidate_tiers):
    if not isinstance(prediction, dict) or "status" not in prediction:
        raise InvalidInput("invalid_evaluation_prediction")
    status = prediction["status"]
    if not isinstance(status, str):
        raise InvalidInput("invalid_evaluation_prediction")
    if status in {"abstain", "unavailable"}:
        if set(prediction) != {"status"}:
            raise InvalidInput("invalid_evaluation_prediction")
        return {"status": status}
    if status != "ok" or set(prediction) - {
        "status",
        "tier",
        "confidence",
        "input_tokens",
        "elapsed_ms",
        "model",
    }:
        raise InvalidInput("invalid_evaluation_prediction")
    tier = validate_eval_tier(prediction.get("tier"))
    if tier not in candidate_tiers:
        raise InvalidInput("invalid_evaluation_prediction")
    confidence = prediction.get("confidence")
    if confidence is not None and not numeric_probability(confidence):
        raise InvalidInput("invalid_evaluation_prediction")
    input_tokens = prediction.get("input_tokens")
    if input_tokens is not None and (
        not isinstance(input_tokens, int)
        or isinstance(input_tokens, bool)
        or input_tokens < 0
    ):
        raise InvalidInput("invalid_evaluation_prediction")
    elapsed_ms = prediction.get("elapsed_ms")
    if elapsed_ms is not None and (
        not finite_number(elapsed_ms) or elapsed_ms < 0
    ):
        raise InvalidInput("invalid_evaluation_prediction")
    model = prediction.get("model")
    if model is not None and (
        not isinstance(model, str)
        or model not in {*MODELS, *MODELS.values()}
    ):
        raise InvalidInput("invalid_evaluation_prediction")
    return {
        "status": "ok",
        "tier": tier,
        "confidence": confidence,
        "input_tokens": input_tokens,
        "elapsed_ms": elapsed_ms,
        "model": model,
    }


def parse_eval_case(value, live):
    required = {"case_id", "source_group", "state", "question"}
    optional = {"split", "existing_choice", "expected_tier", "acceptable_tiers", "prediction"}
    if not isinstance(value, dict) or required - set(value) or set(value) - required - optional:
        raise InvalidInput("invalid_evaluation_case")
    case_id = value["case_id"]
    source_group = value["source_group"]
    if (
        not isinstance(case_id, str)
        or not case_id.strip()
        or case_id.strip() != case_id
        or not isinstance(source_group, str)
        or not source_group.strip()
        or source_group.strip() != source_group
    ):
        raise InvalidInput("invalid_evaluation_case")
    split = value.get("split", "unassigned")
    if not isinstance(split, str) or split not in {*EVAL_SPLITS, "unassigned"}:
        raise InvalidInput("invalid_evaluation_case")
    question = value["question"]
    if not isinstance(question, dict) or question.get("type") != "choice":
        raise InvalidInput("invalid_evaluation_case")
    candidate_tiers = set(question.get("criteria", {})) if isinstance(question.get("criteria"), dict) else set()
    if len(candidate_tiers) < 2 or not candidate_tiers <= set(EVAL_TIERS):
        raise InvalidInput("invalid_evaluation_case")
    if ("expected_tier" in value) == ("acceptable_tiers" in value):
        raise InvalidInput("invalid_evaluation_case")
    if "expected_tier" in value:
        expected_tier = validate_eval_tier(value["expected_tier"])
        acceptable_tiers = (expected_tier,)
    else:
        tiers = value["acceptable_tiers"]
        if not isinstance(tiers, list) or not tiers:
            raise InvalidInput("invalid_evaluation_case")
        acceptable_tiers = tuple(validate_eval_tier(tier) for tier in tiers)
        if len(set(acceptable_tiers)) != len(acceptable_tiers):
            raise InvalidInput("invalid_evaluation_case")
        expected_tier = None
    if not set(acceptable_tiers) <= candidate_tiers:
        raise InvalidInput("invalid_evaluation_case")
    existing_choice = value.get("existing_choice")
    if existing_choice is not None:
        existing_choice = validate_eval_tier(existing_choice)
        if existing_choice not in candidate_tiers:
            raise InvalidInput("invalid_evaluation_case")
    request = {"state": value["state"], "questions": {"tier": question}}
    validate_request(request)
    request_body = json.dumps(
        {"model": "clef-flash", **request},
        ensure_ascii=False,
        allow_nan=False,
        separators=(",", ":"),
    ).encode("utf-8")
    if len(request_body) > MAX_REQUEST_BYTES:
        raise InvalidInput("request_too_large")
    if live:
        if "prediction" in value:
            raise InvalidInput("invalid_evaluation_prediction")
        prediction = None
    else:
        if "prediction" not in value:
            raise InvalidInput("recorded_prediction_required")
        prediction = validate_recorded_prediction(value["prediction"], candidate_tiers)
    return {
        "case_id": case_id,
        "source_group": source_group,
        "split": split,
        "request": request,
        "expected_tier": expected_tier,
        "acceptable_tiers": acceptable_tiers,
        "existing_choice": existing_choice,
        "prediction": prediction,
    }


def load_eval_cases(data, live=False, max_calls=None):
    validate_eval_options(live, max_calls)
    if not isinstance(data, bytes):
        raise InvalidInput("invalid_evaluation_dataset")
    cases = []
    case_ids = set()
    source_splits = {}
    for line in data.splitlines():
        if not line.strip():
            continue
        if len(line) > MAX_REQUEST_BYTES:
            raise InvalidInput("evaluation_case_too_large")
        case = parse_eval_case(parse_json_bytes(line), live)
        if case["case_id"] in case_ids:
            raise InvalidInput("duplicate_case_id")
        source_group = case["source_group"]
        split = case["split"]
        if source_group in source_splits and source_splits[source_group] != split:
            raise InvalidInput("source_group_split_leakage")
        case_ids.add(case["case_id"])
        source_splits[source_group] = split
        cases.append(case)
        if live and len(cases) > max_calls:
            raise InvalidInput("live_case_limit_exceeded")
    if not cases:
        raise InvalidInput("empty_evaluation_dataset")
    return cases


def agreement(correct, total):
    return {
        "correct": correct,
        "cases": total,
        "rate": round(correct / total, 3) if total else "unknown",
    }


def compare_routing_cases(cases, tier_ranks):
    cases_with_choice = [case for case in cases if case["existing_choice"] is not None]
    cases_without_choice = len(cases) - len(cases_with_choice)
    available = [
        case for case in cases_with_choice if case["prediction"]["status"] == "ok"
    ]

    def is_acceptable(case, tier):
        return tier in case["acceptable_tiers"]

    existing_correct = [
        is_acceptable(case, case["existing_choice"]) for case in cases_with_choice
    ]
    fallback_tiers = [
        case["prediction"]["tier"]
        if case["prediction"]["status"] == "ok"
        else case["existing_choice"]
        for case in cases_with_choice
    ]
    fallback_correct = [
        is_acceptable(case, tier) for case, tier in zip(cases_with_choice, fallback_tiers)
    ]
    existing_matched_correct = [
        is_acceptable(case, case["existing_choice"]) for case in available
    ]
    clef_matched_correct = [
        is_acceptable(case, case["prediction"]["tier"]) for case in available
    ]
    clef_correct_count = sum(clef_matched_correct)
    existing_correct_count = sum(existing_matched_correct)
    matched_count = len(available)
    down_tier = sum(
        tier_ranks[case["prediction"]["tier"]]
        < min(tier_ranks[tier] for tier in case["acceptable_tiers"])
        for case in available
    )
    unavailable_with_choice = sum(
        case["prediction"]["status"] == "unavailable" for case in cases_with_choice
    )
    unavailable_without_choice = sum(
        case["prediction"]["status"] == "unavailable"
        for case in cases
        if case["existing_choice"] is None
    )
    return {
        "cases_with_existing_choice": len(cases_with_choice),
        "cases_without_existing_choice": cases_without_choice,
        "unavailable_clef_decisions": {
            "with_existing_choice": unavailable_with_choice,
            "without_existing_choice": unavailable_without_choice,
        },
        "existing_policy_acceptable_agreement": agreement(
            sum(existing_correct), len(existing_correct)
        ),
        "standalone_clef": {
            "acceptable_tier_agreement": agreement(clef_correct_count, matched_count),
            "successful_cases": matched_count,
            "unavailable_cases": unavailable_with_choice,
            "wrong_down_tier_recommendations": down_tier,
        },
        "matched_successful_comparison": {
            "cases": matched_count,
            "existing_policy_acceptable_agreement": agreement(
                existing_correct_count, matched_count
            ),
            "clef_acceptable_tier_agreement": agreement(
                clef_correct_count, matched_count
            ),
            "correctness_delta": {
                "correct": clef_correct_count - existing_correct_count,
                "cases": matched_count,
                "rate": round(
                    (clef_correct_count - existing_correct_count) / matched_count, 3
                )
                if matched_count
                else "unknown",
            },
            "clef_improves_existing_policy": sum(
                clef and not existing
                for clef, existing in zip(clef_matched_correct, existing_matched_correct)
            ),
            "clef_makes_correct_existing_policy_worse": sum(
                existing and not clef
                for clef, existing in zip(clef_matched_correct, existing_matched_correct)
            ),
            "both_wrong": sum(
                not clef and not existing
                for clef, existing in zip(clef_matched_correct, existing_matched_correct)
            ),
            "wrong_down_tier_recommendations": down_tier,
        },
        "fallback_policy": {
            "acceptable_tier_agreement": agreement(
                sum(fallback_correct), len(fallback_correct)
            ),
            "cases": len(cases_with_choice),
            "used_existing_choice": len(cases_with_choice) - matched_count,
        },
    }


def summarize_eval_cases(cases, request_count):
    successful = [case for case in cases if case["prediction"]["status"] == "ok"]
    exact_cases = [case for case in cases if case["expected_tier"] is not None]
    exact_correct = sum(
        case["prediction"]["status"] == "ok"
        and case["prediction"]["tier"] == case["expected_tier"]
        for case in exact_cases
    )
    acceptable_correct = sum(
        case["prediction"]["status"] == "ok"
        and case["prediction"]["tier"] in case["acceptable_tiers"]
        for case in cases
    )
    confusion_rows = {}
    wrong_down_tier = 0
    unnecessary_escalations = 0
    confidence_groups = {
        group: {"correct": 0, "incorrect": 0}
        for group in ("low", "medium", "high", "unknown")
    }
    input_token_values = []
    models = set()
    unknown_model_cases = 0
    latency_values = []
    existing_comparison = {
        "cases": 0,
        "predicted_cases": 0,
        "lower": 0,
        "same": 0,
        "higher": 0,
    }
    prediction_columns = (*EVAL_TIERS, "abstain", "unavailable")
    tier_ranks = {tier: index for index, tier in enumerate(EVAL_TIERS)}
    for case in cases:
        prediction = case["prediction"]
        if prediction.get("model") is None:
            unknown_model_cases += 1
        else:
            models.add(prediction["model"])
        if case["expected_tier"] is None:
            label_tiers = tuple(sorted(case["acceptable_tiers"], key=tier_ranks.get))
        else:
            label_tiers = (case["expected_tier"],)
        row = confusion_rows.setdefault(
            label_tiers, {column: 0 for column in prediction_columns}
        )
        prediction_label = prediction["tier"] if prediction["status"] == "ok" else prediction["status"]
        row[prediction_label] += 1
        if prediction["status"] == "ok":
            rank = tier_ranks[prediction["tier"]]
            acceptable_ranks = [tier_ranks[tier] for tier in case["acceptable_tiers"]]
            if rank < min(acceptable_ranks):
                wrong_down_tier += 1
            if rank > max(acceptable_ranks):
                unnecessary_escalations += 1
            confidence = prediction["confidence"]
            if confidence is None:
                group = "unknown"
            elif confidence <= 0.5:
                group = "low"
            elif confidence <= 0.75:
                group = "medium"
            else:
                group = "high"
            correctness = "correct" if prediction["tier"] in case["acceptable_tiers"] else "incorrect"
            confidence_groups[group][correctness] += 1
            if prediction["input_tokens"] is not None:
                input_token_values.append(prediction["input_tokens"])
            if prediction["elapsed_ms"] is not None:
                latency_values.append(prediction["elapsed_ms"])
            if case["existing_choice"] is not None:
                existing_comparison["cases"] += 1
                existing_comparison["predicted_cases"] += 1
                comparison = tier_ranks[prediction["tier"]] - tier_ranks[case["existing_choice"]]
                existing_comparison["lower" if comparison < 0 else "higher" if comparison > 0 else "same"] += 1
        else:
            if case["existing_choice"] is not None:
                existing_comparison["cases"] += 1
    exact_agreement = agreement(exact_correct, len(exact_cases))
    acceptable_agreement = agreement(acceptable_correct, len(cases))
    all_input_tokens_known = len(input_token_values) == len(cases)
    known_latency_cases = len(latency_values)
    if len(successful) >= 20 and known_latency_cases == len(successful):
        ordered_latency = sorted(latency_values)
        middle = len(ordered_latency) // 2
        median = (
            ordered_latency[middle]
            if len(ordered_latency) % 2
            else (ordered_latency[middle - 1] + ordered_latency[middle]) / 2
        )
        p95 = ordered_latency[math.ceil(0.95 * len(ordered_latency)) - 1]
    else:
        median = "unknown"
        p95 = "unknown"
    return {
        "cases": len(cases),
        "successful_cases": len(successful),
        "exact_agreement": exact_agreement,
        "acceptable_agreement": acceptable_agreement,
        "confusion_matrix": [
            {"expected": list(labels), "predicted": counts}
            for labels, counts in sorted(
                confusion_rows.items(), key=lambda row: tuple(tier_ranks[tier] for tier in row[0])
            )
        ],
        "wrong_down_tier_choices": wrong_down_tier,
        "unnecessary_escalations": unnecessary_escalations,
        "abstentions": sum(case["prediction"]["status"] == "abstain" for case in cases),
        "unavailable": sum(case["prediction"]["status"] == "unavailable" for case in cases),
        "confidence_by_correctness": confidence_groups,
        "latency": {
            "successful_cases": len(successful),
            "timed_successful_cases": known_latency_cases,
            "median_ms": median,
            "p95_ms": p95,
        },
        "input_tokens": {
            "total": sum(input_token_values) if all_input_tokens_known else "unknown",
            "known_total": sum(input_token_values),
            "known_cases": len(input_token_values),
            "unknown_cases": len(cases) - len(input_token_values),
        },
        "cost": "unknown",
        "models": sorted(models),
        "unknown_model_cases": unknown_model_cases,
        "request_count": request_count,
        "existing_choice_comparison": existing_comparison,
        "policy_comparison": compare_routing_cases(cases, tier_ranks),
    }


def build_eval_report(cases, predictions, mode, request_count, request_counts_by_split):
    evaluated = [dict(case, prediction=prediction) for case, prediction in zip(cases, predictions)]
    report = {"mode": mode, **summarize_eval_cases(evaluated, request_count)}
    report["by_split"] = {
        split: summarize_eval_cases(
            [case for case in evaluated if case["split"] == split],
            request_counts_by_split.get(split, 0),
        )
        for split in sorted({case["split"] for case in evaluated})
    }
    return report


def evaluate_jsonl(
    data,
    live=False,
    max_calls=None,
    model="clef-flash",
    env=None,
    transport=http_post,
    clock=time.monotonic,
):
    cases = load_eval_cases(data, live, max_calls)
    model = parse_model(model)
    predictions = []
    request_count = 0
    request_counts_by_split = {}
    if live:
        def counted_transport(url, headers, body, timeout):
            nonlocal request_count
            request_count += 1
            return transport(url, headers, body, timeout)

        for case in cases:
            previous_request_count = request_count
            outcome = run_decision(
                case["request"], model, env, transport=counted_transport, clock=clock
            )
            if outcome["status"] == "ok":
                answer = outcome["result"]["answers"]["tier"]
                prediction = {
                    "status": "ok",
                    "tier": answer["choice"],
                    "confidence": answer["confidence"],
                    "input_tokens": outcome["result"]["usage"]["input_tokens"],
                    "elapsed_ms": outcome["elapsed_ms"],
                    "model": outcome["result"]["model"],
                }
            elif outcome["status"] == "unavailable":
                prediction = {"status": "unavailable"}
            else:
                raise InvalidInput("invalid_live_evaluation_request")
            predictions.append(prediction)
            if request_count > previous_request_count:
                request_counts_by_split[case["split"]] = (
                    request_counts_by_split.get(case["split"], 0) + 1
                )
        mode = "live"
    else:
        predictions = [case["prediction"] for case in cases]
        mode = "offline"
    return build_eval_report(cases, predictions, mode, request_count, request_counts_by_split)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="decide",
        description="Ask a bounded advisory decision question using Cloudflare Workers AI.",
    )
    parser.add_argument("--model", choices=tuple(MODELS), default="clef-flash")
    subcommands = parser.add_subparsers(dest="command")
    subcommands.add_parser("doctor", help="check local configuration without a request")
    eval_parser = subcommands.add_parser("eval", help="evaluate supplied labeled JSONL cases")
    eval_parser.add_argument("--live", action="store_true")
    eval_parser.add_argument("--max-calls", type=int)
    eval_parser.add_argument("path")
    return parser


def print_json(value, stream=sys.stdout):
    stream.write(json.dumps(value, ensure_ascii=False, allow_nan=False, separators=(",", ":")))
    stream.write("\n")


def main(argv=None, env=None, stdin=None, stdout=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if env is None:
        env = os.environ
    if stdin is None:
        stdin = sys.stdin.buffer
    if stdout is None:
        stdout = sys.stdout
    if args.command == "doctor":
        outcome = doctor(env)
        print_json(outcome, stdout)
        return 0 if outcome["status"] == "ok" else 1
    if args.command == "eval":
        try:
            with open(args.path, "rb") as source:
                data = source.read()
            report = evaluate_jsonl(
                data,
                live=args.live,
                max_calls=args.max_calls,
                model=args.model,
                env=env,
            )
        except OSError:
            print_json({"status": "invalid", "reason": "evaluation_file_unavailable"}, stdout)
            return 2
        except InvalidInput as error:
            print_json({"status": "invalid", "reason": error.reason}, stdout)
            return 2
        print_json(report, stdout)
        return 0
    try:
        request = parse_request_bytes(stdin.read(MAX_REQUEST_BYTES + 1))
    except InvalidInput as error:
        print_json({"status": "invalid", "reason": error.reason}, stdout)
        return 2
    outcome = run_decision(request, args.model, env)
    print_json(outcome, stdout)
    return 2 if outcome["status"] == "invalid" else 0


if __name__ == "__main__":
    raise SystemExit(main())
