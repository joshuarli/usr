#!/usr/bin/env python3

import argparse
import os
import shlex
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


IMAGE = "node:24-bookworm"
GUEST_RESOURCES = "/opt/agent-vm"
GUEST_BOOTSTRAP = r"""
set -eu
mkdir -p \
  "$HOME/.agents" "$HOME/.codex" "$HOME/.claude" "$HOME/.grok" \
  "$HOME/.config/opencode" "$HOME/.config/muse" \
  "$HOME/.gemini/config" "$HOME/.gemini/antigravity-cli" "$HOME/.dsh"
ln -s /opt/agent-vm/skills "$HOME/.agents/skills"
ln -s "$HOME/.agents/skills" "$HOME/.claude/skills"
ln -s "$HOME/.agents/skills" "$HOME/.gemini/antigravity-cli/skills"
cp /opt/agent-vm/codex/AGENTS.md "$HOME/.codex/AGENTS.md"
ln -s "$HOME/.codex/AGENTS.md" "$HOME/.claude/CLAUDE.md"
ln -s "$HOME/.codex/AGENTS.md" "$HOME/.claude/AGENTS.md"
ln -s "$HOME/.codex/AGENTS.md" "$HOME/.grok/AGENTS.md"
ln -s "$HOME/.codex/AGENTS.md" "$HOME/.config/opencode/AGENTS.md"
ln -s "$HOME/.codex/AGENTS.md" "$HOME/.config/muse/AGENTS.md"
ln -s "$HOME/.codex/AGENTS.md" "$HOME/.gemini/config/AGENTS.md"
ln -s "$HOME/.codex/AGENTS.md" "$HOME/.dsh/AGENTS.md"
ln -s /opt/agent-vm/claude-agents "$HOME/.claude/agents"
ln -s /opt/agent-vm/grok-agents "$HOME/.grok/agents"
if command -v git >/dev/null 2>&1; then
  git config --global --add safe.directory "$AGENT_VM_CWD"
fi
exec "$@"
""".strip()
GUEST_MINIMAL = r"""
set -eu
if command -v git >/dev/null 2>&1; then
  git config --global --add safe.directory "$AGENT_VM_CWD"
fi
exec "$@"
""".strip()


@dataclass(frozen=True)
class Mount:
    source: str
    guest: str
    readonly: bool

    def volume(self):
        return f"{self.source}:{self.guest}{':ro' if self.readonly else ''}"


class UsageError(Exception):
    pass


def is_within(path, directory):
    return os.path.commonpath((path, directory)) == directory


def logical_cwd(cwd, env):
    declared = env.get("PWD", "")
    if declared.startswith("/"):
        try:
            if os.path.samefile(declared, cwd):
                return os.path.normpath(declared)
        except OSError:
            pass
    return os.path.normpath(cwd)


def directory_mount(path, base, readonly):
    guest = os.path.abspath(os.path.join(base, os.path.expanduser(path)))
    source = os.path.realpath(guest)
    if not os.path.isdir(source):
        raise UsageError(f"not a directory: {path}")
    if ":" in source or ":" in guest:
        raise UsageError(f"smolvm volume paths cannot contain ':': {path}")
    return Mount(source, guest, readonly)


def check_exposure(mount, home):
    real_home = os.path.realpath(home)
    for path, root in ((mount.guest, home), (mount.source, real_home)):
        if is_within(root, path):
            raise UsageError(f"refusing a mount that contains HOME: {mount.guest}")
        for sensitive in ("Library", ".ssh", ".gnupg", ".aws", ".kube", ".docker", ".config", ".codex", ".claude", ".local", ".cache"):
            if is_within(path, os.path.join(root, sensitive)):
                raise UsageError(f"refusing a sensitive home directory: {mount.guest}")


def check_overlap(mounts):
    for index, first in enumerate(mounts):
        for second in mounts[index + 1 :]:
            if any(
                is_within(a, b) or is_within(b, a)
                for a, b in ((first.guest, second.guest), (first.source, second.source))
            ):
                raise UsageError(
                    f"overlapping mounts are unsafe: {first.guest} and {second.guest}"
                )


def resource_mounts(usr):
    root = Path(os.path.realpath(usr)) / "dotfiles" / "base"
    names = (
        (".agents/skills", "skills"),
        (".codex", "codex"),
        (".claude/agents", "claude-agents"),
        (".grok/agents", "grok-agents"),
    )
    mounts = []
    for source, target in names:
        path = root / source
        if not path.is_dir():
            raise UsageError(f"missing usr agent resources: {path} (use --no-config to skip)")
        resolved = os.path.realpath(path)
        if ":" in resolved:
            raise UsageError(f"smolvm volume paths cannot contain ':': {path}")
        mounts.append(Mount(resolved, f"{GUEST_RESOURCES}/{target}", True))
    if not (root / ".codex/AGENTS.md").is_file():
        raise UsageError(f"missing global instructions: {root / '.codex/AGENTS.md'}")
    for mount in mounts:
        if not is_within(mount.source, str(root)):
            raise UsageError(f"usr agent resource escapes the repository: {mount.source}")
    return mounts


def arguments():
    parser = argparse.ArgumentParser(
        description="Run a coding agent in a disposable smolvm with mirrored, explicit host mounts."
    )
    parser.add_argument("--ro", action="append", default=[], metavar="DIR", help="additional read-only directory, mirrored at the same path")
    parser.add_argument("--rw", action="append", default=[], metavar="DIR", help="additional read/write directory, mirrored at the same path")
    parser.add_argument("--image", default=IMAGE, metavar="OCI_IMAGE", help=f"guest OCI image (default: {IMAGE})")
    parser.add_argument("--usr", metavar="DIR", help="dotfiles repository (default: ~/usr)")
    parser.add_argument("--no-config", action="store_true", help="do not load shared skills, agent roles or global instructions")
    parser.add_argument("--offline", action="store_true", help="disable guest networking (otherwise public internet is available)")
    parser.add_argument("--allow-host", action="append", default=[], metavar="HOST", help="restrict guest egress to this hostname and its subdomains (repeatable)")
    parser.add_argument("--allow-host-pattern", action="append", default=[], metavar="PATTERN", help="restrict egress to this exact hostname or *.subdomains (repeatable)")
    parser.add_argument("--credential", action="append", default=[], metavar="BINDING", help="host-side smolvm credential binding (repeatable; no plaintext forwarded)")
    parser.add_argument("--dry-run", action="store_true", help="print the smolvm invocation without starting it")
    parser.add_argument("command", nargs=argparse.REMAINDER, help="guest command following -- (default: /bin/bash)")
    return parser


def command_for(args, cwd, env, interactive=False):
    home = os.path.normpath(env.get("HOME", ""))
    if not home.startswith("/") or not os.path.isdir(home):
        raise UsageError("HOME must name an existing absolute directory")
    if args.offline and (args.allow_host or args.allow_host_pattern or args.credential):
        raise UsageError("--offline cannot be combined with network permissions")

    current = directory_mount(logical_cwd(cwd, env), cwd, False)
    mounts = [current]
    mounts += [directory_mount(path, cwd, False) for path in args.rw]
    mounts += [directory_mount(path, cwd, True) for path in args.ro]
    for mount in mounts:
        check_exposure(mount, home)
    check_overlap(mounts)

    if not args.no_config:
        mounts += resource_mounts(args.usr or os.path.join(home, "usr"))

    command = args.command
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        command = ["/bin/bash"]

    argv = ["smolvm", "machine", "run", "--image", args.image]
    if interactive:
        argv.append("-it")
    if not args.offline:
        argv.extend(("--net", "--block-private"))
    for host in args.allow_host:
        argv.extend(("--allow-host", host))
    for host in args.allow_host_pattern:
        argv.extend(("--allow-host-pattern", host))
    for credential in args.credential:
        argv.extend(("--credential", credential))
    argv.extend(("--workdir", current.guest, "-e", f"HOME={home}", "-e", f"AGENT_VM_CWD={current.guest}", "-e", "IS_SANDBOX=1"))
    if env.get("TERM"):
        argv.extend(("-e", f"TERM={env['TERM']}"))
    for mount in mounts:
        argv.extend(("-v", mount.volume()))
    bootstrap = GUEST_MINIMAL if args.no_config else GUEST_BOOTSTRAP
    command = ["/bin/sh", "-c", bootstrap, "agent-vm", *command]
    argv.extend(("--", *command))
    return argv


def main(argv=None):
    parser = arguments()
    args = parser.parse_args(argv)
    try:
        command = command_for(args, os.getcwd(), os.environ, sys.stdin.isatty() and sys.stdout.isatty())
    except UsageError as error:
        parser.error(str(error))
    if args.dry_run:
        print(shlex.join(command))
        return 0
    if shutil.which("smolvm") is None:
        print("agent-vm: install smolvm (brew install smol-machines/tap/smolvm)", file=sys.stderr)
        return 127
    try:
        return subprocess.call(command)
    except OSError as error:
        print(f"agent-vm: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
