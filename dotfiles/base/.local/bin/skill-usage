#!/bin/sh
self="$0"
while [ -L "$self" ]; do
	link=$(readlink "$self") || break
	case "$link" in
		/*) self="$link" ;;
		*) self="$(dirname -- "$self")/$link" ;;
	esac
done
root=$(CDPATH='' cd -- "$(dirname -- "$self")/../../../.." && pwd) || exit 1
venv=${AGENT_MEMORY_VENV:-$HOME/d/agent-memory/.venv}
if [ ! -x "$venv/bin/python" ]; then
	>&2 printf 'skill-usage: %s/bin/python is not installed; install agent-memory into %s (see its docs/install.md) or set AGENT_MEMORY_VENV\n' "$venv" "$venv"
	exit 127
fi
exec "$venv/bin/python" -I "$root/tools/skill-usage/src/skill_usage.py" "$@"
