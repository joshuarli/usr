#!/bin/sh
exec uvx --refresh-package yt-dlp --from 'yt-dlp@git+https://github.com/yt-dlp/yt-dlp' yt-dlp --ignore-config --ignore-errors \
    --remote-components 'ejs:github' \
    --js-runtimes node:/opt/homebrew/bin/node \
    -f 'ba' \
    --add-metadata \
    -o '%(playlist_title)s/%(playlist_index)02d - %(title)s [%(id)s].%(ext)s' "$1"
