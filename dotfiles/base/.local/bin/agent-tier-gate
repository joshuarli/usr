#!/bin/sh
# PreToolUse: Claude root god only; Grok and other native subagents are blocked.
# Ordinary subagents use pi-subagent-bridge, including non-orchestrate requests.
set -eu

deny() {
    printf '%s\n' "agent-tier-gate: $1" >&2
    exit 2
}
if command -v jaq >/dev/null 2>&1 && jaq --version >/dev/null 2>&1; then
    json=jaq
elif command -v jq >/dev/null 2>&1 && jq --version >/dev/null 2>&1; then
    json=jq
else
    deny "neither jaq nor jq is installed"
fi
input=$(cat)
field() {
    printf '%s' "$input" | "$json" -r "$1" 2>/dev/null || deny "cannot parse hook input"
}
harness=$(field 'if has("tool_input") then "claude" elif has("toolInput") then "grok" else "unknown" end')
target=$(field '.tool_input.subagent_type // .toolInput.subagent_type // .toolInput.subagentType // ""')
caller=$(field '.agent_type // .subagentType // ""')
[ "$harness" = "claude" ] || deny "native subagents unavailable here; use pi-subagent-bridge"
[ -z "$caller" ] || deny "nested native subagents are forbidden"
[ "$target" = "god" ] || deny "only native Claude god is permitted; use pi-subagent-bridge for $target"
