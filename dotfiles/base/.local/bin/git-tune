#!/usr/bin/env bash
set -euo pipefail

readonly VERSION="2.0.0"
readonly MIN_GIT_VERSION="2.56.0"

if [[ -n "${GIT:-}" ]]; then
  GIT_BIN="$GIT"
elif [[ -x /opt/homebrew/bin/git ]]; then
  GIT_BIN=/opt/homebrew/bin/git
elif [[ -x /usr/local/bin/git ]]; then
  GIT_BIN=/usr/local/bin/git
else
  GIT_BIN=git
fi

if [[ -z "${NO_COLOR:-}" && -t 1 ]]; then
  readonly BOLD=$'\033[1m' DIM=$'\033[2m'
  readonly RED=$'\033[31m' GREEN=$'\033[32m' YELLOW=$'\033[33m' BLUE=$'\033[34m'
  readonly RESET=$'\033[0m'
else
  readonly BOLD="" DIM="" RED="" GREEN="" YELLOW="" BLUE="" RESET=""
fi

DRY_RUN=false
YES=false
VERIFY=false
CONFIGURE_ONLY=false
GLOBALS_ONLY=false
INCREMENTAL_MIDX=false
MODE=geometric
REPO_PATH=""
REPO_ROOT=""
IS_BARE=false
IS_SHALLOW=false
IS_PARTIAL=false
HAS_ALTERNATES=false
WORKTREE_CONFIG=false
IS_LINKED_WORKTREE=false
REPO_CONFIG_SCOPE=--local
HAS_COMMITS=false
MIDX_MODE=default

info()    { printf "\n%s==>%s %s%s\n" "$BLUE" "$BOLD" "$1" "$RESET"; }
success() { printf "  %s✓%s %s\n" "$GREEN" "$RESET" "$1"; }
warn()    { printf "  %s⚠%s %s\n" "$YELLOW" "$RESET" "$1" >&2; }
error()   { printf "%serror:%s %s\n" "$RED" "$RESET" "$1" >&2; }
dim()     { printf "  %s%s%s\n" "$DIM" "$1" "$RESET"; }
die()     { error "$1"; exit 1; }

resolve_git() {
  if [[ "$GIT_BIN" == */* ]]; then
    [[ -x "$GIT_BIN" ]] || die "Git executable not found: $GIT_BIN"
  else
    GIT_BIN=$(command -v "$GIT_BIN") || die "Git executable not found"
  fi
}

git_cmd() {
  if [[ -n "$REPO_PATH" ]]; then
    "$GIT_BIN" -C "$REPO_PATH" "$@"
  else
    "$GIT_BIN" "$@"
  fi
}

print_command() {
  local arg
  printf "  %s[dry-run]%s git" "$DIM" "$RESET"
  if [[ -n "$REPO_PATH" ]]; then printf " -C %q" "$REPO_PATH"; fi
  for arg in "$@"; do printf " %q" "$arg"; done
  printf "\n"
}

git_do() {
  if [[ "$DRY_RUN" == true ]]; then
    print_command "$@"
    return 0
  fi
  git_cmd "$@"
}

git_do_stdout_quiet() {
  if [[ "$DRY_RUN" == true ]]; then
    print_command "$@"
    return 0
  fi
  git_cmd "$@" >/dev/null
}

git_value() {
  git_cmd "$@" 2>/dev/null
}

config_value() {
  local scope="$1" key="$2"
  git_value config "$scope" --get "$key"
}

set_config() {
  local scope="$1" key="$2" value="$3" current
  current=$(config_value "$scope" "$key") || current=""
  if [[ "$current" == "$value" ]]; then
    success "$key = $value (already set)"
  else
    git_do config "$scope" --replace-all "$key" "$value"
    success "$key = $value"
  fi
}

check_git_version() {
  local raw version
  raw=$("$GIT_BIN" --version | awk '{print $3}')
  version=${raw%%[-+]*}
  local -a got want
  IFS=. read -r -a got <<< "$version"
  IFS=. read -r -a want <<< "$MIN_GIT_VERSION"
  local i g w
  for i in 0 1 2; do
    g=${got[$i]:-0}
    w=${want[$i]:-0}
    if (( g < w )); then
      die "Git $MIN_GIT_VERSION or newer is required (found $raw); upgrade with: brew upgrade git"
    elif (( g > w )); then
      break
    fi
  done
}

confirm() {
  if [[ "$YES" == true || "$DRY_RUN" == true ]]; then return 0; fi
  printf "\n  Proceed? [y/N] "
  local answer
  IFS= read -r answer
  [[ "$answer" =~ ^[Yy]$ ]] || { printf "Aborted.\n"; exit 0; }
}

usage() {
  cat <<'HELP'
git-tune — Configure Git for responsive daily use and maintain repository indexes

Usage: git-tune [-C REPO] [OPTIONS]

Repository modes:
  (default)          Apply repository-local settings and geometric repacking
  --full             Repack reachable objects and preserve unreachable objects in cruft packs
  --redelta          Full repack with fresh deltas at depth 50 and window 10
  --configure-only   Configure and warm working-tree caches without repacking

Other options:
  --verify           Run a full object check before work and verify written indexes
  --incremental-midx Write layered MIDX output during geometric repacks; existing chains are preserved
  --globals-only     Apply shared performance settings without repository maintenance
  --no-globals       Keep the run repository-local (the default)
  --dry-run          Print planned commands without changing files or starting daemons
  --yes              Skip the confirmation prompt
  -C, --directory    Repository to tune (default: current directory)
  -h, --help         Show this help message
  --version          Show version

The tuner does not expire reflogs, prune unreachable objects, delete branches,
prune remotes, or clean worktree and rerere records.
HELP
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -C|--directory)
        [[ $# -ge 2 ]] || die "$1 requires a repository path"
        REPO_PATH=$2
        shift 2
        ;;
      --dry-run) DRY_RUN=true; shift ;;
      --yes) YES=true; shift ;;
      --verify) VERIFY=true; shift ;;
      --full)
        [[ "$MODE" == geometric ]] || die "--full and --redelta cannot be combined"
        MODE=full
        shift
        ;;
      --redelta)
        [[ "$MODE" == geometric ]] || die "--full and --redelta cannot be combined"
        MODE=redelta
        shift
        ;;
      --configure-only) CONFIGURE_ONLY=true; shift ;;
      --incremental-midx) INCREMENTAL_MIDX=true; shift ;;
      --globals-only) GLOBALS_ONLY=true; shift ;;
      --no-globals) shift ;;
      --version) printf "git-tune %s\n" "$VERSION"; exit 0 ;;
      -h|--help) usage; exit 0 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
  if [[ "$GLOBALS_ONLY" == true && "$CONFIGURE_ONLY" == true ]]; then
    die "--globals-only and --configure-only cannot be combined"
  fi
  if [[ "$GLOBALS_ONLY" == true && "$MODE" != geometric ]]; then
    die "--full and --redelta require a repository"
  fi
  if [[ "$GLOBALS_ONLY" == true && "$INCREMENTAL_MIDX" == true ]]; then
    die "--incremental-midx requires a repository"
  fi
  if [[ "$GLOBALS_ONLY" == true && "$VERIFY" == true ]]; then
    die "--verify requires a repository"
  fi
  if [[ "$CONFIGURE_ONLY" == true && ( "$MODE" != geometric || "$INCREMENTAL_MIDX" == true ) ]]; then
    die "--configure-only cannot be combined with repack mode options"
  fi
  if [[ "$MODE" != geometric && "$INCREMENTAL_MIDX" == true ]]; then
    die "--incremental-midx is available with geometric repacks; --full and --redelta rebuild a flat MIDX"
  fi
}

load_repository_context() {
  git_cmd rev-parse --git-dir >/dev/null 2>&1 || die "No Git repository found; use -C REPO or --globals-only"

  local bare shallow partial refs alternates_path midx_chain git_dir common_dir
  bare=$(git_value rev-parse --is-bare-repository)
  [[ "$bare" == true ]] && IS_BARE=true
  git_dir=$(git_value rev-parse --path-format=absolute --git-dir)
  common_dir=$(git_value rev-parse --path-format=absolute --git-common-dir)
  if [[ "$git_dir" != "$common_dir" ]]; then
    IS_LINKED_WORKTREE=true
  fi
  if [[ "$IS_BARE" == true ]]; then
    REPO_ROOT=$git_dir
  else
    REPO_ROOT=$(git_value rev-parse --show-toplevel)
  fi

  shallow=$(git_value rev-parse --is-shallow-repository) || shallow=false
  [[ "$shallow" == true ]] && IS_SHALLOW=true
  partial=$(git_value config --get extensions.partialClone) || partial=""
  if [[ -n "$partial" ]] || git_value config --get-regexp '^remote\..*\.promisor$' >/dev/null; then
    IS_PARTIAL=true
  fi
  if [[ "$(git_value config --bool --get extensions.worktreeConfig || true)" == true ]]; then
    WORKTREE_CONFIG=true
  fi

  alternates_path=$(git_value rev-parse --path-format=absolute --git-path objects/info/alternates)
  if [[ -s "$alternates_path" ]]; then HAS_ALTERNATES=true; fi

  refs=$(git_value rev-list --all --max-count=1) || refs=""
  if [[ -n "$refs" ]] || git_value rev-parse --verify --quiet HEAD >/dev/null; then
    HAS_COMMITS=true
  fi

  if [[ "$IS_LINKED_WORKTREE" == true && "$WORKTREE_CONFIG" == true ]]; then
    REPO_CONFIG_SCOPE=--worktree
  fi

  midx_chain=$(git_value rev-parse --path-format=absolute --git-path objects/pack/multi-pack-index.d)
  if [[ "$MODE" == geometric && ( "$INCREMENTAL_MIDX" == true || -d "$midx_chain" ) ]]; then
    MIDX_MODE=incremental
  fi

  local maintenance_strategy maintenance_repack
  maintenance_strategy=$(git_value config --get maintenance.strategy) || maintenance_strategy=""
  maintenance_repack=$(git_value config --bool --get maintenance.incremental-repack.enabled) || maintenance_repack=""
  if [[ "$MIDX_MODE" == incremental ]] && { [[ "$maintenance_repack" == true ]] || { [[ "$maintenance_strategy" == incremental ]] && [[ "$maintenance_repack" != false ]]; }; }; then
    die "Layered MIDX cannot be combined with the maintenance.incremental-repack task; disable that task before using this tuner"
  fi
}

set_repository_settings() {
  info "Applying repository-local performance settings"
  set_config "$REPO_CONFIG_SCOPE" core.commitGraph true
  set_config "$REPO_CONFIG_SCOPE" commitGraph.changedPaths true
  set_config "$REPO_CONFIG_SCOPE" commitGraph.changedPathsVersion 2
  set_config "$REPO_CONFIG_SCOPE" index.threads true
  set_config "$REPO_CONFIG_SCOPE" index.version 4
  set_config "$REPO_CONFIG_SCOPE" fetch.negotiationAlgorithm skipping
  set_config "$REPO_CONFIG_SCOPE" pack.allowPackReuse multi
  set_config "$REPO_CONFIG_SCOPE" pack.writeBitmapLookupTable true
  set_config "$REPO_CONFIG_SCOPE" core.multiPackIndex true

  if [[ "$IS_BARE" == true ]]; then
    dim "Bare repository: skipping working-tree cache setup"
    return
  fi

  local sparse sparse_checkout index_path index_version index_hex
  sparse=$(git_value config --bool --get index.sparse || true)
  sparse_checkout=$(git_value config --bool --get core.sparseCheckout || true)
  if [[ "$DRY_RUN" == true ]]; then
    local untracked
    untracked=$(config_value "$REPO_CONFIG_SCOPE" core.untrackedCache) || untracked=""
    if [[ "$untracked" == true ]]; then
      success "core.untrackedCache = true (already set)"
    else
      dim "Would probe the filesystem for untracked-cache support"
    fi
  else
    local untracked
    untracked=$(config_value "$REPO_CONFIG_SCOPE" core.untrackedCache) || untracked=""
    if [[ "$untracked" == true ]] || git_cmd update-index --test-untracked-cache >/dev/null 2>&1; then
      set_config "$REPO_CONFIG_SCOPE" core.untrackedCache true
    else
      set_config "$REPO_CONFIG_SCOPE" core.untrackedCache false
      warn "Filesystem does not support Git's untracked cache; continuing without it"
    fi
  fi

  if [[ "$sparse" == true || "$sparse_checkout" == true ]]; then
    dim "Sparse checkout detected: leaving the existing index format untouched"
    return
  fi

  index_path=$(git_value rev-parse --path-format=absolute --git-path index)
  if [[ -f "$index_path" ]]; then
    index_hex=$(/usr/bin/od -An -tx1 -j4 -N4 "$index_path" 2>/dev/null | tr -d ' \n') || index_hex=""
    index_version=${index_hex:6:2}
    if [[ "$index_version" != 04 ]]; then
      git_do update-index --index-version=4
      success "Converted the ordinary index to version 4"
    else
      success "Index is already version 4"
    fi
  fi
}

fsmonitor_scope() {
  printf '%s' "$REPO_CONFIG_SCOPE"
}

configure_fsmonitor() {
  [[ "$IS_BARE" == true ]] && return 0

  local current scope
  current=$(git_value config --get core.fsmonitor) || current=""
  case "$current" in
    ""|false|False|FALSE|0|no|off|NO|OFF|true|True|TRUE|1|yes|on|YES|ON) ;;
    *)
      success "Preserving custom core.fsmonitor hook: $current"
      return 0
      ;;
  esac
  scope=$(fsmonitor_scope)
  if [[ "$IS_LINKED_WORKTREE" == true && "$WORKTREE_CONFIG" != true ]]; then
    dim "Linked worktrees share repository-local FSMonitor settings because extensions.worktreeConfig is disabled"
  fi

  if [[ "$DRY_RUN" == true ]]; then
    print_command fsmonitor--daemon start
    git_do config "$scope" --replace-all core.fsmonitor true
    return 0
  fi

  if [[ "$(uname)" != Darwin ]]; then
    warn "Built-in FSMonitor setup is only enabled automatically on macOS"
    git_do config "$scope" --replace-all core.fsmonitor false
    return 0
  fi

  if git_cmd fsmonitor--daemon status >/dev/null 2>&1 || git_cmd fsmonitor--daemon start >/dev/null 2>&1; then
    git_do config "$scope" --replace-all core.fsmonitor true
    success "Built-in FSMonitor daemon is ready"
  else
    git_do config "$scope" --replace-all core.fsmonitor false
    warn "Could not start FSMonitor; disabled it for this repository and continuing"
  fi
}

warm_working_tree() {
  [[ "$IS_BARE" == true ]] && return 0
  info "Warming working-tree caches"
  git_do_stdout_quiet status --porcelain=v1 --untracked-files=normal
  success "Working-tree caches initialized"
}

verify_objects() {
  info "Checking repository object integrity"
  git_do fsck --full --no-dangling --no-progress
  success "Repository object check passed"
}

write_pack_indexes() {
  local midx_arg
  if [[ "$MIDX_MODE" == incremental ]]; then
    midx_arg=--write-midx=incremental
  else
    midx_arg=--write-midx
  fi

  info "Repacking objects ($MODE mode)"
  if [[ "$MODE" == geometric ]]; then
    git_do repack --local -d --geometric=2 "$midx_arg" --write-bitmap-index --quiet
  elif [[ "$MODE" == full ]]; then
    git_do repack --local -a -d --cruft "$midx_arg" --write-bitmap-index --quiet
  else
    git_do repack --local -a -d --cruft -f --depth=50 --window=10 "$midx_arg" --write-bitmap-index --quiet
  fi
  success "Object packs and bitmap index written"

  if [[ "$HAS_COMMITS" == true ]]; then
    info "Writing commit-graph"
    if [[ "$MODE" == geometric ]]; then
      git_do commit-graph write --reachable --split --changed-paths
      success "Incremental commit-graph layer written"
    else
      git_do commit-graph write --reachable --split=replace --changed-paths
      success "Complete reachable commit-graph rebuilt"
    fi
  else
    dim "No commits are reachable from refs; skipping commit-graph writing"
  fi

  info "Packing refs when Git's automatic threshold is met"
  git_do pack-refs --auto
  success "Reference packing checked"
}

verify_indexes() {
  [[ "$VERIFY" == true ]] || return 0
  info "Verifying written indexes"

  local midx graph split_graph
  if [[ "$DRY_RUN" == true && "$CONFIGURE_ONLY" != true ]]; then
    git_do multi-pack-index verify
    if [[ "$HAS_COMMITS" == true ]]; then
      git_do commit-graph verify
    fi
    return 0
  fi

  midx=$(git_value rev-parse --path-format=absolute --git-path objects/pack/multi-pack-index)
  if [[ -f "$midx" || -d "${midx}.d" ]]; then
    git_do multi-pack-index verify
    success "Multi-pack index verified"
  fi

  graph=$(git_value rev-parse --path-format=absolute --git-path objects/info/commit-graph)
  split_graph=$(git_value rev-parse --path-format=absolute --git-path objects/info/commit-graphs/commit-graph-chain)
  if [[ -f "$graph" || -f "$split_graph" ]]; then
    git_do commit-graph verify
    success "Commit-graph verified"
  fi
}

apply_global_settings() {
  info "Applying shared performance settings"
  set_config --global core.commitGraph true
  set_config --global core.untrackedCache true
  set_config --global core.preloadIndex true
  set_config --global feature.manyFiles true
  set_config --global index.version 4
  set_config --global index.threads true
  set_config --global commitGraph.changedPaths true
  set_config --global commitGraph.changedPathsVersion 2
  set_config --global fetch.negotiationAlgorithm skipping
  set_config --global core.multiPackIndex true
  set_config --global pack.allowPackReuse multi
  set_config --global pack.writeBitmapLookupTable true
}

print_plan() {
  info "Plan"
  if [[ "$GLOBALS_ONLY" == true ]]; then
    dim "Apply shared performance settings; repository settings and data will not be changed"
    dim "core.commitGraph = true"
    dim "core.untrackedCache = true"
    dim "core.preloadIndex = true"
    dim "feature.manyFiles = true"
    dim "index.version = 4; index.threads = true"
    dim "commitGraph.changedPaths = true; commitGraph.changedPathsVersion = 2"
    dim "fetch.negotiationAlgorithm = skipping"
    dim "core.multiPackIndex = true"
    dim "pack.allowPackReuse = multi; pack.writeBitmapLookupTable = true"
    return
  fi

  printf "  Repository: %s\n" "$REPO_ROOT"
  if [[ "$IS_LINKED_WORKTREE" == true ]]; then
    if [[ "$REPO_CONFIG_SCOPE" == --worktree ]]; then
      dim "Linked worktree: repository settings use worktree-specific config"
    else
      dim "Linked worktree: repository settings use shared config because extensions.worktreeConfig is disabled"
    fi
  fi
  if [[ "$HAS_ALTERNATES" == true ]]; then
    dim "Alternate object store detected: repack will only write objects owned by this repository"
  fi
  if [[ "$IS_PARTIAL" == true ]]; then
    dim "Partial clone detected: Git's promisor-aware repack keeps promised objects recoverable"
  fi
  if [[ "$IS_SHALLOW" == true ]]; then
    dim "Shallow repository detected: repacking and graph traversal respect its shallow history boundary"
  fi
  dim "Apply repository-local graph, index, negotiation, pack, and working-tree cache settings"
  if [[ "$CONFIGURE_ONLY" == true ]]; then
    dim "Warm working-tree caches and stop before repacking"
    return
  fi
  case "$MODE" in
    geometric) dim "Geometrically repack the smaller packs and refresh MIDX bitmap indexes" ;;
    full) dim "Repack reachable objects and store unreachable objects in cruft packs" ;;
    redelta) dim "Full cruft-preserving repack with fresh deltas at depth 50 and window 10" ;;
  esac
  dim "Write split commit-graph data and check automatic ref packing"
  dim "No reflogs, unreachable objects, branches, remotes, worktree records, or rerere data will be expired or removed"
  if [[ "$VERIFY" == true ]]; then
    dim "Run a full object check before work and verify written indexes afterward"
  fi
  if [[ "$MIDX_MODE" == incremental ]]; then
    dim "Write layered MIDX output"
  fi
}

main() {
  parse_args "$@"
  resolve_git
  check_git_version

  if [[ "$GLOBALS_ONLY" != true ]]; then
    load_repository_context
  fi

  print_plan
  confirm

  if [[ "$GLOBALS_ONLY" == true ]]; then
    apply_global_settings
    return 0
  fi

  set_repository_settings
  configure_fsmonitor
  warm_working_tree

  if [[ "$VERIFY" == true ]]; then verify_objects; fi
  if [[ "$CONFIGURE_ONLY" == true ]]; then
    verify_indexes
    success "Configuration complete"
    return 0
  fi
  write_pack_indexes
  verify_indexes
  success "git-tune completed"
}

main "$@"
