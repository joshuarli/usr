#!/bin/sh
# worker-watch - observe a pi-subagent-bridge executor session.
#
# Usage:
#   worker-watch <repo-root> <usrw_session_id> [idle-minutes]
#   worker-watch --state <repo-root> <usrw_session_id>
#
# The bridge returns "admitted" and has no completion callback. Run this as a
# background command instead of polling worker_status: it exits when the
# Command Code executor writes its final `result` record (exit 0), when the
# executor process is gone without one (exit 3), or when its NDJSON log has
# been quiet for idle-minutes (default 10; exit 2), printing the last event
# so the coordinator can tell a long download from a stuck worker. SDK workers report an atomic result; unknown states require manual inspection.
# --state asks for the same evidence once, without blocking: it prints
# succeeded, failed, turn_limit, interrupted, running or unknown and exits 0.

set -u

prog=${0##*/}
state_only=0
if [ "${1:-}" = --state ]; then
    state_only=1
    shift
fi

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }
unknown() { [ "$state_only" -eq 1 ] && { printf 'unknown\n'; exit 0; }; die "$*"; }
usage() { printf 'usage: %s <repo-root> <usrw_session_id> [idle-minutes]\n' "$prog" >&2; exit 2; }

[ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
root=$1
session=$2
idle_minutes=${3:-10}
case $idle_minutes in '' | *[!0-9]*) usage ;; esac
command -v jaq >/dev/null 2>&1 || die "jaq is required"

record="$root/.work/worker-bridge/$session.json"
[ -f "$record" ] || unknown "no session record at $record"

backend=$(jaq -r '.backend // (if .command_run then "command-code" else "" end)' "$record")
case $backend in
    pi)
        pi_id=$(jaq -r '.pi_id // empty' "$record")
        [ -n "$pi_id" ] || unknown "Pi session has no SDK child ID"
        child_record="$root/.work/worker-bridge/$pi_id.pi.json"
        [ -f "$child_record" ] || unknown "Pi SDK session record not found: $child_record"
        pid=$(jaq -r '.run.pid // empty' "$child_record")
        log=$(jaq -r '.run.output // empty' "$child_record")
        errors=$(jaq -r '.run.errors // empty' "$child_record")
        [ -n "$pid" ] && [ -n "$log" ] || unknown "Pi SDK worker admission is incomplete"
        ;;
    command-code|codex|antigravity|hydrogen)
        pid=$(jaq -r '.command_run.pid // empty' "$record")
        log=$(jaq -r '.command_run.output // empty' "$record")
        errors=$(jaq -r '.command_run.errors // empty' "$record")
        [ -n "$pid" ] && [ -n "$log" ] || unknown "Session has no active runner"
        case $backend in
            antigravity|hydrogen)
                jaq -e '(has("schema_version") | not) or .schema_version == 1' "$record" >/dev/null 2>&1 ||
                    unknown "Unsupported Antigravity session version"
                expected_model=$(jaq -r '.antigravity_pin.model | strings | select(length > 0)' "$record" 2>/dev/null)
                # Unversioned Hydrogen sessions predate admitted pin snapshots.
                if [ "$backend" = hydrogen ]; then
                    expected_model=gemini-4-hydrogen-xhigh
                    # shellcheck disable=SC2016 # $model is a jaq variable.
                    jaq -e --arg model "$expected_model" '(has("schema_version") | not) and
                        (if has("antigravity_pin") then .antigravity_pin.model == $model and .antigravity_pin.effort == "xhigh" else true end)' \
                        "$record" >/dev/null 2>&1 || unknown "Ambiguous legacy Antigravity pin"
                fi
                [ -n "$expected_model" ] || unknown "Antigravity session has no admitted model pin"
                backend=antigravity
                ;;
        esac
        ;;
    *)
        [ "$state_only" -eq 1 ] && { printf 'unknown\n'; exit 0; }
        printf '%s: %s has no known terminal-output backend; inspect worker_status\n' "$prog" "$session"
        exit 4
        ;;
esac

last_event() {
    if [ "$backend" = pi ]; then
        if [ -n "$errors" ]; then tail -c 500 "$errors" 2>/dev/null; fi
    else
        tail -n 50 "$log" 2>/dev/null |
            jaq -r 'select(.type == "event") | .event | select(.type == "tool_queued") | "\(.toolName): \((.input | objects | .description // .command) // "" | tostring | .[0:160])"' 2>/dev/null |
            tail -n 1
    fi
}
state=
inspect() {
    state=
    if [ "$backend" = pi ]; then
        if [ -s "$log" ] && jaq -e '.state == "succeeded" or .state == "failed" or .state == "cancelled"' "$log" >/dev/null 2>&1; then
            raw_state=$(jaq -r '.state' "$log")
            case $raw_state in cancelled) state=interrupted ;; *) state=$raw_state ;; esac
            return 0
        fi
        return 1
    fi
    if [ "$backend" = codex ]; then
        kill -0 "$pid" 2>/dev/null && return 1
        result=$(jaq -sc '[.[] | select(.type == "turn.completed" or .type == "turn.failed")] | last // empty' "$log" 2>/dev/null)
        [ -n "$result" ] || return 1
        case $(printf '%s\n' "$result" | jaq -r '.type') in
            turn.completed) state=succeeded ;;
            turn.failed) state=failed ;;
        esac
        return 0
    fi
    if [ "$backend" = antigravity ]; then
        kill -0 "$pid" 2>/dev/null && return 1
        result=$(jaq -sc '[.[] | select(.event == "result" and (.result | type == "object"))] | last // empty' "$log" 2>/dev/null)
        [ -n "$result" ] || return 1
        actual_model=$(jaq -sr '[.[] | select(.event == "init")] | first | .init.model // empty' "$log" 2>/dev/null)
        state=failed
        if [ "$actual_model" = "$expected_model" ] &&
            [ "$(printf '%s\n' "$result" | jaq -r '.result.status')" = SUCCESS ]; then
            state=succeeded
        fi
        return 0
    fi
    result=$(rg '"type":"result"' "$log" 2>/dev/null | tail -n 1)
    [ -n "$result" ] || return 1
    case $(printf '%s\n' "$result" | jaq -r '.subtype') in
        success) state=succeeded ;;
        max_turns) state=turn_limit ;;
        *) state=failed ;;
    esac
}
terminal_print() {
    if [ "$backend" = pi ]; then
        jaq -r '"finished: \(.state)\n\(.text // .error // "" | tostring | .[0:2000])"' "$log"
    elif [ "$backend" = codex ]; then
        printf 'finished: %s\n' "$state"
        jaq -sr '[.[] | select(.type == "item.completed" and .item.type == "agent_message") | .item.text] | last // "" | .[0:2000]' "$log"
    elif [ "$backend" = antigravity ]; then
        printf 'finished: %s\n' "$state"
        printf '%s\n' "$result" | jaq -r '.result.response // .result.error // "" | tostring | .[0:2000]'
    else
        printf '%s\n' "$result" | jaq -r '"finished: \(.subtype)\n\(.result // "" | tostring | .[0:2000])"'
    fi
}

if [ "$state_only" -eq 1 ]; then
    if inspect; then printf '%s\n' "$state"; exit 0; fi
    if ! kill -0 "$pid" 2>/dev/null; then printf 'interrupted\n'; exit 0; fi
    printf 'running\n'
    exit 0
fi

while :; do
    if inspect; then terminal_print; exit 0; fi
    if ! kill -0 "$pid" 2>/dev/null; then
        printf 'exited without terminal result (pid %s); last event: %s\n' "$pid" "$(last_event)"
        exit 3
    fi
    observed=$log
    [ -f "$observed" ] || observed=$errors
    [ -f "$observed" ] || observed=$record
    modified=$(stat -c %Y "$observed" 2>/dev/null || stat -f %m "$observed" 2>/dev/null || date +%s)
    quiet=$(( $(date +%s) - modified ))
    if [ "$quiet" -ge $(( idle_minutes * 60 )) ]; then
        printf 'stalled: no executor output for %s min; last event: %s\n' "$(( quiet / 60 ))" "$(last_event)"
        exit 2
    fi
    sleep 15
done
