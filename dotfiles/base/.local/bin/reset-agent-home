#!/bin/sh
set -eu

[ $# -gt 0 ] || { printf 'usage: reset-agent-home DIR...\n' >&2; exit 2; }
case $HOME in
    /*) ;;
    *) printf 'reset-agent-home: HOME must be an absolute path\n' >&2; exit 1 ;;
esac
if ! home=$(CDPATH='' cd "$HOME" 2>/dev/null && pwd -P); then
    printf 'reset-agent-home: HOME is not a directory\n' >&2
    exit 1
fi

target_relative_path() {
    case $1 in
        "$HOME"/*) rel=${1#"$HOME"/} ;;
        "$home"/*) rel=${1#"$home"/} ;;
        *) printf 'reset-agent-home: %s is outside HOME\n' "$1" >&2; return 1 ;;
    esac
}

for dir do
    dir=${dir%/}
    target_relative_path "$dir" || exit 1
    [ -n "$rel" ] || { printf 'reset-agent-home: refusing to reset HOME\n' >&2; exit 1; }
    current=$home
    remaining=$rel
    while [ -n "$remaining" ]; do
        component=${remaining%%/*}
        case $component in
            ''|.|..) printf 'reset-agent-home: invalid path %s\n' "$dir" >&2; exit 1 ;;
        esac
        current=$current/$component
        [ ! -L "$current" ] || { printf 'reset-agent-home: %s is a symlink\n' "$current" >&2; exit 1; }
        case $remaining in
            */*) remaining=${remaining#*/} ;;
            *) remaining= ;;
        esac
    done
done

self=$0
if [ -L "$self" ]; then
    link=$(readlink "$self")
    case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
fi
repo=$(cd "$(dirname "$self")" && pwd -P)
repo=${repo%/dotfiles/*}

reset_contents() {
    for path in "$1"/* "$1"/.[!.]* "$1"/..?*; do
        [ -e "$path" ] || [ -L "$path" ] || continue
        name=${path##*/}
        case $3:$name in
            root:.credentials.json|root:auth.json|root:mcp_credentials.json) continue ;;
        esac
        kept=false
        for layer in "$repo"/dotfiles/*/; do
            if [ -e "$layer$2/$name" ] || [ -L "$layer$2/$name" ]; then kept=true; fi
        done
        if $kept; then
            if [ -d "$path" ] && [ ! -L "$path" ]; then
                reset_contents "$path" "$2/$name" nested
            fi
        else
            rm -rf "$path"
        fi
    done
}

for dir do
    dir=${dir%/}
    target_relative_path "$dir" || exit 1
    dir=$home/$rel
    [ -d "$dir" ] || continue
    reset_contents "$dir" "$rel" root
done
