#!/bin/sh
# Delete everything in an agent's home directory (~/.claude, ~/.codex) except what the
# dotfiles repo installs there. That keeps config, instructions, skills, and rules, and
# clears all state, but keeps the login credentials (Claude's .credentials.json, Codex's
# auth.json) so a reset never forces a new login.
set -eu

[ $# -eq 1 ] || { printf 'usage: reset-agent-home DIR\n' >&2; exit 1; }
dir=${1%/}

[ -d "$dir" ] || exit 0
[ ! -L "$dir" ] || { printf 'reset-agent-home: %s is a symlink\n' "$dir" >&2; exit 1; }

# The repo root, found from where this script's link points.
self=$0
if [ -L "$self" ]; then
    link=$(readlink "$self")
    case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
fi
repo=$(cd "$(dirname "$self")" && pwd -P)
repo=${repo%/dotfiles/*}
rel=${dir#"$HOME"/}

for path in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    # An unmatched glob stays literal.
    [ -e "$path" ] || [ -L "$path" ] || continue
    name=${path##*/}
    case $name in .credentials.json|auth.json) continue ;; esac
    kept=false
    for layer in "$repo"/dotfiles/*/; do
        if [ -e "$layer$rel/$name" ] || [ -L "$layer$rel/$name" ]; then kept=true; fi
    done
    $kept || rm -rf "$path"
done
