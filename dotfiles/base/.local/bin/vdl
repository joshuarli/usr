#!/bin/sh
yt_dlp="${0%/*}/yt-dlp"
[ -x "$yt_dlp" ] || yt_dlp=yt-dlp
exec "$yt_dlp" --ignore-config --ignore-errors \
    --remote-components 'ejs:github' \
    --js-runtimes node \
    -f 'bv*[height<=1080]+ba/b[height<=1080]' \
    --write-subs --write-auto-subs --sub-langs "orig" --sub-format srt --convert-subs srt \
    --add-metadata \
    --embed-thumbnail \
    --embed-metadata \
    --merge-output-format mp4 \
    -o '%(title)s [%(id)s].%(ext)s' "$@"

