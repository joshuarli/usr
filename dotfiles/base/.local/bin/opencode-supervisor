#!/usr/bin/env python3
"""Find the newest opencode session in a directory and, after confirmation, resume a paused goal with "continue"."""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import shutil
import signal
import sqlite3
import subprocess
import sys
import time
from pathlib import Path
from typing import TypedDict

HOME = Path.home()
TMUX = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
OPENCODE_DB = HOME / ".local/share/opencode/opencode.db"
GOAL_KEY_PREFIX = "plugin:" + "opencode.goal".encode("utf-16-be").hex() + ":session:"
STALE_SECONDS = 180
RECENT_RESUME_SECONDS = 120
RESUME_COMMAND = "/goal resume"
CONTINUE_MESSAGE = "continue"
RESUME_WAIT_SECONDS = 10
SOURCE_REVISION = "3b3fd7c2"
VERSION = f"0.1.0 ({SOURCE_REVISION})"
INTERRUPT_SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)
COMMAND_TIMEOUT_SECONDS = 10


class Goal(TypedDict):
    status: str
    updatedAt: int
    objective: str


class Session(TypedDict):
    pane: str
    id: str
    title: str
    updated: int


class SessionNotFound(Exception):
    pass


class Interrupted(Exception):
    def __init__(self, signum: int) -> None:
        super().__init__(f"interrupted by signal {signum}")
        self.signum = signum


def execute_command(*args: str) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            args, capture_output=True, text=True, check=False, timeout=COMMAND_TIMEOUT_SECONDS
        )
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError(f"command timed out: {' '.join(args)}") from exc


def run(*args: str) -> str:
    return execute_command(*args).stdout


def run_checked(*args: str) -> None:
    result = execute_command(*args)
    if result.returncode != 0:
        reason = result.stderr.strip() or "no diagnostic"
        raise RuntimeError(f"command failed ({result.returncode}): {reason}: {' '.join(args)}")


def install_signal_handlers() -> None:
    def handler(signum: int, _frame: object) -> None:
        raise Interrupted(signum)

    for sig in INTERRUPT_SIGNALS:
        signal.signal(sig, handler)


def die_by_signal(signum: int) -> None:
    signal.signal(signum, signal.SIG_DFL)
    os.kill(os.getpid(), signum)


def now() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def read_only() -> sqlite3.Connection:
    return sqlite3.connect(f"file:{OPENCODE_DB}?mode=ro", uri=True)


def find_panes(workdir: str) -> list[tuple[str, str]]:
    panes = run(TMUX, "list-panes", "-a", "-F", "#{pane_id} #{pane_pid} #{pane_current_path}")
    found = []
    for line in panes.splitlines():
        parts = line.split(" ", 2)
        if len(parts) != 3 or parts[2] != workdir:
            continue
        pane, shell_pid = parts[0], parts[1]
        for pid in run("pgrep", "-P", shell_pid).split():
            if "opencode" in run("ps", "-o", "command=", "-p", pid):
                found.append((pane, pid))
                break
    return found


def pane_session(shell_child: str, workdir: str) -> str | None:
    start = run("ps", "-o", "lstart=", "-p", shell_child).strip()
    if not start:
        return None
    try:
        started = dt.datetime.strptime(start, "%a %b %d %H:%M:%S %Y").astimezone()
    except ValueError as exc:
        raise ValueError(f"unparseable process start time: {start}") from exc
    started_ms = started.timestamp() * 1000
    con = read_only()
    try:
        row = con.execute(
            "select id from session_v2 where directory = ? and abs(time_created - ?) < 120000 "
            "order by abs(time_created - ?) limit 1",
            (workdir, started_ms, started_ms),
        ).fetchone()
    finally:
        con.close()
    return str(row[0]) if row else None


def detect_session(workdir: str) -> Session | None:
    found: list[Session] = []
    for pane, child in find_panes(workdir):
        session_id = pane_session(child, workdir)
        if session_id is None:
            continue
        con = read_only()
        try:
            row = con.execute(
                "select title, time_updated from session_v2 where id = ?", (session_id,)
            ).fetchone()
        finally:
            con.close()
        if row is None:
            continue
        found.append(
            {
                "pane": pane,
                "id": session_id,
                "title": str(row[0] or "untitled"),
                "updated": int(row[1] or 0),
            }
        )
    return max(found, key=lambda session: session["updated"]) if found else None


def goal_state(session_id: str) -> Goal:
    con = read_only()
    try:
        row = con.execute("select value from kv where key = ?", (GOAL_KEY_PREFIX + session_id,)).fetchone()
    finally:
        con.close()
    if row is None:
        raise SessionNotFound(f"no goal for opencode session {session_id}")
    try:
        raw = json.loads(str(row[0]))
    except json.JSONDecodeError as exc:
        raise ValueError(f"corrupt goal for session {session_id}") from exc
    if not isinstance(raw, dict):
        raise ValueError(f"invalid goal for session {session_id}")
    status = raw.get("status")
    updated_at = raw.get("updatedAt")
    objective = raw.get("objective")
    if (
        status not in ("active", "paused", "complete")
        or not isinstance(updated_at, int)
        or isinstance(updated_at, bool)
        or not isinstance(objective, str)
    ):
        raise ValueError(f"invalid goal for session {session_id}")
    return {"status": status, "updatedAt": updated_at, "objective": objective}


def last_resume(session_id: str) -> float:
    con = read_only()
    try:
        rows = con.execute(
            "select data from session_message where session_id = ? and type = 'synthetic' "
            "order by time_created desc",
            (session_id,),
        ).fetchall()
    finally:
        con.close()
    for (data,) in rows:
        try:
            message = json.loads(str(data))
        except json.JSONDecodeError:
            continue
        if not isinstance(message, dict):
            continue
        metadata = message.get("metadata")
        text = message.get("text")
        timestamp = message.get("time")
        if not isinstance(metadata, dict) or metadata.get("source") != "goal":
            continue
        if not isinstance(text, str) or "resumed the goal" not in text:
            continue
        if not isinstance(timestamp, dict):
            continue
        created = timestamp.get("created")
        if isinstance(created, int) and not isinstance(created, bool):
            return created / 1000
    return 0.0


def confirm(prompt: str) -> bool:
    try:
        answer = input(f"{prompt} [y/N] ")
    except EOFError:
        return False
    return answer.strip().lower() in ("y", "yes")


def send_keys(pane: str, text: str) -> None:
    run_checked(TMUX, "send-keys", "-t", pane, "C-u")
    sent = False
    try:
        run_checked(TMUX, "send-keys", "-t", pane, "-l", text)
        run_checked(TMUX, "send-keys", "-t", pane, "Enter")
        sent = True
    finally:
        if not sent:
            result = execute_command(TMUX, "send-keys", "-t", pane, "C-u")
            if result.returncode != 0:
                print(
                    f"opencode-supervisor: line cleanup failed in {pane}: {result.stderr.strip()}",
                    file=sys.stderr,
                )


def wait_for_active(session_id: str, timeout: float = RESUME_WAIT_SECONDS) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if goal_state(session_id)["status"] == "active":
            return True
        time.sleep(0.2)
    return False


def resume(pane: str, session_id: str) -> bool:
    send_keys(pane, RESUME_COMMAND)
    if not wait_for_active(session_id):
        return False
    send_keys(pane, CONTINUE_MESSAGE)
    return True


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog=(
            "With no arguments, finds the most recently updated opencode session in the current\n"
            "directory and asks before supervising it. A goal is supervised only when paused.\n"
            "Requires tmux on PATH; tested on macOS with Homebrew tmux.\n"
            "\n"
            "examples:\n"
            "  opencode-supervisor\n"
            "  opencode-supervisor --yes\n"
            "  opencode-supervisor --workdir /Users/josh/repos/tf --yes\n"
            "  opencode-supervisor --dry-run\n"
            "  opencode-supervisor --workdir /Users/josh/repos/tf --stale 300\n"
            "\n"
            "signals:\n"
            "  INT, TERM, HUP and QUIT stop before the next tmux key and exit by that\n"
            "  signal (130 for INT); a second signal during cleanup exits immediately\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--workdir", default=os.getcwd(), help="directory hosting the session (default: cwd)")
    parser.add_argument(
        "--stale", type=int, default=STALE_SECONDS,
        help="seconds paused before resuming (default: 180)",
    )
    parser.add_argument("--yes", action="store_true", help="supervise without prompting (for automation)")
    parser.add_argument("--dry-run", action="store_true", help="report the decision without typing into the pane")
    parser.add_argument("--version", action="version", version=f"opencode-supervisor {VERSION}")
    return parser


def execute(args: argparse.Namespace) -> int:
    workdir = str(Path(args.workdir).resolve())
    stamp = f"[{now():%FT%T%z}]"
    session = detect_session(workdir)
    if session is None:
        print(f"{stamp} no opencode session in {workdir}; no action")
        return 0
    try:
        goal = goal_state(session["id"])
    except SessionNotFound:
        print(f"{stamp} opencode {session['id']} ({session['title']}) has no goal; no action")
        return 0
    print(
        f"{stamp} found opencode {session['id']} ({session['title']}) in {session['pane']}: "
        f"goal {goal['status']}: {goal['objective']}"
    )
    if not args.yes and not confirm("Supervise this session?"):
        print(f"{stamp} declined; no action")
        return 0
    goal = goal_state(session["id"])
    if goal["status"] != "paused":
        print(f"{stamp} goal {goal['status']}; no action")
        return 0
    age = (int(now().timestamp() * 1000) - goal["updatedAt"]) / 1000
    if age < args.stale:
        print(f"{stamp} goal paused {int(age)}s ago; no action")
        return 0
    last = last_resume(session["id"])
    if last and now().timestamp() - last < RECENT_RESUME_SECONDS:
        print(f"{stamp} continue was just sent; no action")
        return 0
    if args.dry_run:
        print(f"{stamp} would resume {session['id']} and send continue to {session['pane']}")
        return 0
    if not resume(session["pane"], session["id"]):
        print(f"{stamp} opencode {session['id']} did not resume; no continue sent", file=sys.stderr)
        return 1
    print(f"{stamp} resumed {session['id']} and sent continue to {session['pane']}")
    return 0


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    install_signal_handlers()
    try:
        return execute(args)
    except Interrupted as exc:
        print(f"opencode-supervisor: interrupted by signal {exc.signum}", file=sys.stderr)
        die_by_signal(exc.signum)
        return 128 + exc.signum
    except (SessionNotFound, RuntimeError, OSError, sqlite3.Error, TypeError, ValueError) as exc:
        print(f"opencode-supervisor: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
