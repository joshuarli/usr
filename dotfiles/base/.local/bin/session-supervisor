#!/usr/bin/env python3
"""Resume a stopped agent session in a tmux pane with the message "continue"."""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import shutil
import signal
import sqlite3
import subprocess
import sys
import time
from pathlib import Path
from typing import Literal, TypedDict, cast

HOME = Path.home()
TMUX = shutil.which("tmux") or "/opt/homebrew/bin/tmux"
AGY_SUMMARIES = HOME / ".gemini/antigravity-cli/conversation_summaries.db"
AGY_HISTORY = HOME / ".gemini/antigravity-cli/history.jsonl"
DEVIN_SESSIONS = HOME / ".local/share/devin/cli/sessions.db"
OPENCODE_DB = HOME / ".local/share/opencode/opencode.db"
GOAL_KEY_PREFIX = "plugin:" + "opencode.goal".encode("utf-16-be").hex() + ":session:"
STALE_SECONDS = 180
RECENT_CONTINUE_SECONDS = 120
RESUME_COMMAND = "/goal resume"
CONTINUE_MESSAGE = "continue"
RESUME_WAIT_SECONDS = 10
HARNESSES = ("opencode", "agy", "devin")
SOURCE_REVISION = "9fe43136"
VERSION = f"0.2.0 ({SOURCE_REVISION})"
INTERRUPT_SIGNALS = (signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)
COMMAND_TIMEOUT_SECONDS = 10


class Goal(TypedDict):
    status: Literal["active", "paused", "complete"]
    updatedAt: int
    objective: str


class Session(TypedDict):
    pane: str
    id: str
    title: str
    updated: int


class Target(TypedDict):
    harness: str
    pane: str
    id: str
    detail: str
    stopped: bool
    last_continue: float
    action: Literal["continue", "resume"]


class SessionNotFound(Exception):
    pass


class Interrupted(Exception):
    def __init__(self, signum: int) -> None:
        super().__init__(f"interrupted by signal {signum}")
        self.signum = signum


def execute_command(*args: str) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            args, capture_output=True, text=True, check=False, timeout=COMMAND_TIMEOUT_SECONDS
        )
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError(f"command timed out: {' '.join(args)}") from exc


def run(*args: str) -> str:
    return execute_command(*args).stdout


def run_checked(*args: str) -> None:
    result = execute_command(*args)
    if result.returncode != 0:
        reason = result.stderr.strip() or "no diagnostic"
        raise RuntimeError(f"command failed ({result.returncode}): {reason}: {' '.join(args)}")


def install_signal_handlers() -> None:
    def handler(signum: int, _frame: object) -> None:
        raise Interrupted(signum)

    for sig in INTERRUPT_SIGNALS:
        signal.signal(sig, handler)


def die_by_signal(signum: int) -> None:
    signal.signal(signum, signal.SIG_DFL)
    os.kill(os.getpid(), signum)


def now() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def read_only(path: Path) -> sqlite3.Connection:
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True)


def find_panes(workdir: str, harness: str) -> list[tuple[str, str]]:
    panes = run(TMUX, "list-panes", "-a", "-F", "#{pane_id} #{pane_pid} #{pane_current_path}")
    found = []
    for line in panes.splitlines():
        parts = line.split(" ", 2)
        if len(parts) != 3 or parts[2] != workdir:
            continue
        pane, shell_pid = parts[0], parts[1]
        for pid in run("pgrep", "-P", shell_pid).split():
            if harness in run("ps", "-o", "command=", "-p", pid):
                found.append((pane, pid))
                break
    return found


def find_pane(workdir: str, harness: str) -> str | None:
    found = find_panes(workdir, harness)
    return found[0][0] if found else None


def pane_session(shell_child: str, workdir: str) -> str | None:
    start = run("ps", "-o", "lstart=", "-p", shell_child).strip()
    if not start:
        return None
    try:
        started = dt.datetime.strptime(start, "%a %b %d %H:%M:%S %Y").astimezone()
    except ValueError as exc:
        raise ValueError(f"unparseable process start time: {start}") from exc
    started_ms = started.timestamp() * 1000
    con = read_only(OPENCODE_DB)
    try:
        row = con.execute(
            "select id from session_v2 where directory = ? and abs(time_created - ?) < 120000 "
            "order by abs(time_created - ?) limit 1",
            (workdir, started_ms, started_ms),
        ).fetchone()
    finally:
        con.close()
    return str(row[0]) if row else None


def detect_opencode_session(workdir: str) -> Session | None:
    found: list[Session] = []
    for pane, child in find_panes(workdir, "opencode"):
        session_id = pane_session(child, workdir)
        if session_id is None:
            continue
        con = read_only(OPENCODE_DB)
        try:
            row = con.execute(
                "select title, time_updated from session_v2 where id = ?", (session_id,)
            ).fetchone()
        finally:
            con.close()
        if row is None:
            continue
        found.append(
            {
                "pane": pane,
                "id": session_id,
                "title": str(row[0] or "untitled"),
                "updated": int(row[1] or 0),
            }
        )
    return max(found, key=lambda session: session["updated"]) if found else None


def goal_state(session_id: str) -> Goal:
    con = read_only(OPENCODE_DB)
    try:
        row = con.execute("select value from kv where key = ?", (GOAL_KEY_PREFIX + session_id,)).fetchone()
    finally:
        con.close()
    if row is None:
        raise SessionNotFound(f"no goal for opencode session {session_id}")
    try:
        raw = json.loads(str(row[0]))
    except json.JSONDecodeError as exc:
        raise ValueError(f"corrupt goal for session {session_id}") from exc
    if not isinstance(raw, dict):
        raise ValueError(f"invalid goal for session {session_id}")
    status = raw.get("status")
    updated_at = raw.get("updatedAt")
    objective = raw.get("objective")
    if (
        status not in ("active", "paused", "complete")
        or not isinstance(updated_at, int)
        or isinstance(updated_at, bool)
        or not isinstance(objective, str)
    ):
        raise ValueError(f"invalid goal for session {session_id}")
    goal_status = cast(Literal["active", "paused", "complete"], status)
    return {"status": goal_status, "updatedAt": updated_at, "objective": objective}


def opencode_last_resume(session_id: str) -> float:
    con = read_only(OPENCODE_DB)
    try:
        rows = con.execute(
            "select data from session_message where session_id = ? and type = 'synthetic' "
            "order by time_created desc",
            (session_id,),
        ).fetchall()
    finally:
        con.close()
    for (data,) in rows:
        try:
            message = json.loads(str(data))
        except json.JSONDecodeError:
            continue
        if not isinstance(message, dict):
            continue
        metadata = message.get("metadata")
        text = message.get("text")
        timestamp = message.get("time")
        if not isinstance(metadata, dict) or metadata.get("source") != "goal":
            continue
        if not isinstance(text, str) or "resumed the goal" not in text:
            continue
        if not isinstance(timestamp, dict):
            continue
        created = timestamp.get("created")
        if isinstance(created, int) and not isinstance(created, bool):
            return created / 1000
    return 0.0


def agy_state(
    workdir: str, stale: int = STALE_SECONDS, session_id: str | None = None
) -> tuple[str, bool, float, str]:
    uri = f"file://{workdir}"
    query = (
        "select conversation_id, status, last_modified_time, step_count "
        "from conversation_summaries where workspace_uris like ?"
    )
    params = [f"%{uri}%"]
    if session_id is not None:
        query += " and conversation_id = ?"
        params.append(session_id)
    con = read_only(AGY_SUMMARIES)
    try:
        row = con.execute(query + " order by last_modified_time desc limit 1", tuple(params)).fetchone()
    finally:
        con.close()
    if row is None:
        raise SessionNotFound(f"no agy conversation for {uri}")
    conversation, status, modified, steps = (str(row[0]), str(row[1]), str(row[2]), int(row[3]))
    modified_at = dt.datetime.fromisoformat(modified)
    if modified_at.tzinfo is None:
        raise ValueError(f"agy conversation {conversation} has a naive last_modified_time")
    stopped = status == "CASCADE_RUN_STATUS_IDLE" and (now() - modified_at).total_seconds() >= stale

    latest = 0
    try:
        with open(AGY_HISTORY, encoding="utf-8") as handle:
            for line in handle:
                try:
                    entry = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(entry, dict):
                    continue
                if entry.get("conversationId") == conversation and entry.get("display") == "continue":
                    timestamp = entry.get("timestamp")
                    if isinstance(timestamp, int) and not isinstance(timestamp, bool):
                        latest = max(latest, timestamp)
    except FileNotFoundError:
        pass
    detail = f"status={status} steps={steps}"
    return conversation, stopped, latest / 1000, detail


def devin_state(
    workdir: str, stale: int = STALE_SECONDS, session_id: str | None = None
) -> tuple[str, bool, float, str]:
    query = "select id, last_activity_at from sessions where working_directory = ?"
    params = [workdir]
    if session_id is not None:
        query += " and id = ?"
        params.append(session_id)
    con = read_only(DEVIN_SESSIONS)
    try:
        row = con.execute(query + " order by last_activity_at desc limit 1", tuple(params)).fetchone()
        latest = 0
        if row is not None:
            latest_row = con.execute(
                "select max(timestamp) from prompt_history "
                "where session_id = ? and content = 'continue'",
                (row[0],),
            ).fetchone()
            latest = int(latest_row[0] or 0)
    finally:
        con.close()
    if row is None:
        raise SessionNotFound(f"no devin session for {workdir}")
    session_id, activity = str(row[0]), int(row[1])
    stopped = (now() - dt.datetime.fromtimestamp(activity, dt.timezone.utc)).total_seconds() >= stale
    detail = f"last_activity={activity}"
    return session_id, stopped, float(latest), detail


def make_target(
    harness: str, pane: str, session_id: str, detail: str, stopped: bool, last_continue: float
) -> Target:
    action = "resume" if harness == "opencode" else "continue"
    return {
        "harness": harness,
        "pane": pane,
        "id": session_id,
        "detail": detail,
        "stopped": stopped,
        "last_continue": last_continue,
        "action": action,
    }


def target_for(harness: str, workdir: str, stale: int) -> Target | None:
    if harness == "opencode":
        session = detect_opencode_session(workdir)
        if session is None:
            return None
        try:
            goal = goal_state(session["id"])
        except SessionNotFound:
            return None
        age = (int(now().timestamp() * 1000) - goal["updatedAt"]) / 1000
        return make_target(
            harness,
            session["pane"],
            session["id"],
            f"goal {goal['status']}: {goal['objective']}",
            goal["status"] == "paused" and age >= stale,
            opencode_last_resume(session["id"]),
        )
    pane = find_pane(workdir, harness)
    if pane is None:
        return None
    state = agy_state(workdir, stale) if harness == "agy" else devin_state(workdir, stale)
    session_id, stopped, last_continue, detail = state
    return make_target(harness, pane, session_id, detail, stopped, last_continue)


def refresh_target(target: Target, workdir: str, stale: int) -> Target | None:
    harness, pane, session_id = target["harness"], target["pane"], target["id"]
    if harness == "opencode":
        try:
            goal = goal_state(session_id)
        except SessionNotFound:
            return None
        age = (int(now().timestamp() * 1000) - goal["updatedAt"]) / 1000
        return make_target(
            harness,
            pane,
            session_id,
            f"goal {goal['status']}: {goal['objective']}",
            goal["status"] == "paused" and age >= stale,
            opencode_last_resume(session_id),
        )
    try:
        state = (
            agy_state(workdir, stale, session_id=session_id)
            if harness == "agy"
            else devin_state(workdir, stale, session_id=session_id)
        )
    except SessionNotFound:
        return None
    _, stopped, last_continue, detail = state
    return make_target(harness, pane, session_id, detail, stopped, last_continue)


def confirm(prompt: str) -> bool:
    try:
        answer = input(f"{prompt} [y/N] ")
    except EOFError:
        return False
    return answer.strip().lower() in ("y", "yes")


def send_keys(pane: str, text: str) -> None:
    run_checked(TMUX, "send-keys", "-t", pane, "C-u")
    sent = False
    try:
        run_checked(TMUX, "send-keys", "-t", pane, "-l", text)
        run_checked(TMUX, "send-keys", "-t", pane, "Enter")
        sent = True
    finally:
        if not sent:
            result = execute_command(TMUX, "send-keys", "-t", pane, "C-u")
            if result.returncode != 0:
                print(
                    f"session-supervisor: line cleanup failed in {pane}: {result.stderr.strip()}",
                    file=sys.stderr,
                )


def wait_for_active(session_id: str, timeout: float = RESUME_WAIT_SECONDS) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if goal_state(session_id)["status"] == "active":
            return True
        time.sleep(0.2)
    return False


def supervise(target: Target, dry_run: bool) -> bool:
    if dry_run:
        return True
    if target["action"] == "resume":
        send_keys(target["pane"], RESUME_COMMAND)
        if not wait_for_active(target["id"]):
            return False
    send_keys(target["pane"], CONTINUE_MESSAGE)
    return True


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog=(
            f"With no harness, checks {', '.join(HARNESSES)} in that order. When attached to a\n"
            "terminal it asks before sending anything; automation proceeds without a prompt.\n"
            "\n"
            "examples:\n"
            "  session-supervisor\n"
            "  session-supervisor opencode\n"
            "  session-supervisor agy --workdir /Users/josh/repos/tf\n"
            "  session-supervisor devin --dry-run\n"
            "  session-supervisor opencode --yes --stale 300\n"
            "\n"
            "signals:\n"
            "  INT, TERM, HUP and QUIT stop before the next tmux key and exit by that\n"
            "  signal (130 for INT); a second signal during cleanup exits immediately\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "harness", nargs="?", choices=HARNESSES,
        help=f"harness whose session is supervised (default: detect in {', '.join(HARNESSES)} order)",
    )
    parser.add_argument("--workdir", default=os.getcwd(), help="directory hosting the session (default: cwd)")
    parser.add_argument(
        "--stale", type=int, default=STALE_SECONDS,
        help="seconds without progress before sending continue (default: 180)",
    )
    parser.add_argument("--yes", action="store_true", help="supervise without prompting")
    parser.add_argument("--dry-run", action="store_true", help="report the decision without typing into the pane")
    parser.add_argument("--version", action="version", version=f"session-supervisor {VERSION}")
    return parser


def execute(args: argparse.Namespace) -> int:
    workdir = str(Path(args.workdir).resolve())
    stamp = f"[{now():%FT%T%z}]"
    harnesses = (args.harness,) if args.harness else HARNESSES
    target = None
    for harness in harnesses:
        try:
            target = target_for(harness, workdir, args.stale)
        except SessionNotFound:
            continue
        if target is not None:
            break
    if target is None:
        print(f"{stamp} no agent session in {workdir}; no action")
        return 0
    print(f"{stamp} found {target['harness']} {target['id']} in {target['pane']}: {target['detail']}")
    if not args.yes and sys.stdin.isatty() and not confirm("Supervise this session?"):
        print(f"{stamp} declined; no action")
        return 0
    try:
        fresh = refresh_target(target, workdir, args.stale)
    except SessionNotFound:
        fresh = None
    if fresh is None:
        print(f"{stamp} {target['harness']} {target['id']} is no longer available; no action")
        return 0
    target = fresh
    if not target["stopped"]:
        print(f"{stamp} {target['harness']} {target['id']} active: {target['detail']}; no action")
        return 0
    if target["last_continue"] and now().timestamp() - target["last_continue"] < RECENT_CONTINUE_SECONDS:
        print(f"{stamp} {target['harness']} {target['id']} stopped but continue was just sent; no action")
        return 0
    if not supervise(target, args.dry_run):
        print(f"{stamp} {target['harness']} {target['id']} did not resume; no continue sent", file=sys.stderr)
        return 1
    verb = "would send" if args.dry_run else "sent"
    print(f"{stamp} {target['harness']} {target['id']} stopped: {target['detail']}; {verb} continue to {target['pane']}")
    return 0


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    install_signal_handlers()
    try:
        return execute(args)
    except Interrupted as exc:
        print(f"session-supervisor: interrupted by signal {exc.signum}", file=sys.stderr)
        die_by_signal(exc.signum)
        return 128 + exc.signum
    except (SessionNotFound, RuntimeError, OSError, sqlite3.Error, TypeError, ValueError) as exc:
        print(f"session-supervisor: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
