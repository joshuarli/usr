#!/bin/sh
exec python3 -I - "$@" <<'PY'
from __future__ import annotations

import concurrent.futures
import datetime
import hashlib
import json
import math
import os
from pathlib import Path
import select
import shutil
import subprocess
import sys
import time
import unicodedata


PROVIDERS = (
    ("claude", "Claude Code", "claude"),
    ("codex", "Codex", "codex"),
    ("muse", "Muse Code", "muse"),
    ("grok", "Grok Build", "grok"),
    ("dsh", "DeepSeek API", "dsh"),
    ("agy", "Antigravity", "agy"),
    ("opencode", "OpenCode Go", "opencode2"),
)
HELP = """usage: usage [claude|codex|muse|grok|dsh|agy|opencode]

Read subscription quota usage from Claude Code, Codex, Muse Code, Grok
Build, OpenCode Go, and Antigravity, plus the DeepSeek API credit balance.
Grok queries its CLI billing extension over ACP. The DeepSeek balance is not
a subscription quota. With no provider, query every supported CLI installed
here. These reads do not submit a model prompt. Claude Code uses its
undocumented OAuth usage endpoint and does not refresh credentials. OpenCode
Go queries its hosted usage endpoint with the stored OAuth credential.
"""


def stop_process(process):
    if process.stdin and not process.stdin.closed:
        try:
            process.stdin.close()
        except BrokenPipeError:
            pass
    try:
        process.wait(timeout=2)
    except subprocess.TimeoutExpired:
        process.terminate()
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def read_rpc_response(process, request_id, deadline):
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("timed out waiting for the CLI response")
        ready, _, _ = select.select([process.stdout], [], [], remaining)
        if not ready:
            raise TimeoutError("timed out waiting for the CLI response")
        line = process.stdout.readline()
        if not line:
            raise RuntimeError("the CLI closed its protocol output")
        try:
            message = json.loads(line)
        except json.JSONDecodeError as error:
            raise RuntimeError("the CLI returned invalid protocol JSON") from error
        if message.get("id") != request_id:
            continue
        if "error" in message:
            detail = message["error"].get("message", "request failed")
            raise RuntimeError(detail)
        return message.get("result")


def send_rpc(process, request):
    process.stdin.write(json.dumps(request, separators=(",", ":")) + "\n")
    process.stdin.flush()


def query_rpc(binary, arguments, method, experimental=False):
    process = subprocess.Popen(
        [binary, *arguments],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    deadline = time.monotonic() + 35
    try:
        send_rpc(
            process,
            {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "initialize",
                "params": {
                    "clientInfo": {"name": "usage", "version": "1"},
                    "capabilities": {"experimentalApi": experimental},
                },
            },
        )
        read_rpc_response(process, 1, deadline)
        send_rpc(
            process,
            {"jsonrpc": "2.0", "method": "initialized", "params": {}},
        )
        send_rpc(
            process,
            {"jsonrpc": "2.0", "id": 2, "method": method, "params": {}},
        )
        return read_rpc_response(process, 2, deadline)
    finally:
        stop_process(process)


def json_object(value: object, error: str) -> dict[str, object]:
    if not isinstance(value, dict):
        raise RuntimeError(error)
    return {key: item for key, item in value.items() if isinstance(key, str)}


def query_codex(binary: str) -> dict[str, object]:
    return json_object(
        query_rpc(binary, ["app-server", "--stdio"], "account/rateLimits/read", True),
        "Codex returned an invalid usage response",
    )


def muse_last_observed(binary: str) -> object:
    try:
        return query_rpc(binary, ["serve", "--no-session-log"], "usage/read", True)
    except Exception:
        return None


def is_percent(value: object) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def query_muse(binary: str) -> dict[str, object]:
    try:
        process = subprocess.run(
            [binary, "usage", "--json"],
            capture_output=True,
            text=True,
            encoding="utf-8",
            timeout=20,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError("Muse usage request timed out after 20 seconds") from error
    except OSError as error:
        raise RuntimeError(f"cannot run Muse usage: {error.strerror}") from error
    if process.returncode:
        detail = (process.stderr or process.stdout).strip() or "command failed"
        fallback = muse_last_observed(binary)
        if isinstance(fallback, dict) and isinstance(fallback.get("usage"), dict):
            return json_object(fallback, "Muse returned an invalid usage response")
        raise RuntimeError(detail)
    try:
        result = json.loads(process.stdout)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise RuntimeError("Muse returned invalid usage JSON") from error
    if not isinstance(result, dict):
        raise RuntimeError("Muse returned an invalid usage response")
    allowance = result.get("allowance")
    if isinstance(allowance, dict) and any(
        isinstance(section, dict) and is_percent(section.get("usedPercent"))
        for section in (allowance.get("window"), allowance.get("weekly"))
    ):
        return json_object(result, "Muse returned an invalid usage response")
    fallback = muse_last_observed(binary)
    if isinstance(fallback, dict) and isinstance(fallback.get("usage"), dict):
        return json_object(fallback, "Muse returned an invalid usage response")
    reason = result.get("reason") or result.get("hint")
    if isinstance(reason, str) and reason.strip():
        raise RuntimeError(reason.strip())
    raise RuntimeError("Muse returned no subscription quota")


def grok_usage(result: object) -> dict[str, object]:
    config = result.get("config") if isinstance(result, dict) else None
    if not isinstance(config, dict):
        raise RuntimeError("Grok returned no subscription billing configuration")
    current = config.get("currentPeriod")
    current = current if isinstance(current, dict) else {}
    prepaid = config.get("prepaidBalance")
    usage_percent = config.get("creditUsagePercent")
    if (
        isinstance(usage_percent, bool)
        or not isinstance(usage_percent, (int, float))
        or not math.isfinite(usage_percent)
    ):
        raise RuntimeError("Grok returned no valid subscription usage percentage")
    prepaid_cents = prepaid.get("val") if isinstance(prepaid, dict) else None
    if (
        isinstance(prepaid_cents, bool)
        or not isinstance(prepaid_cents, (int, float))
        or not math.isfinite(prepaid_cents)
    ):
        prepaid_cents = None
    subscription_tier = result.get("subscription_tier") if isinstance(result, dict) else None
    return {
        "subscription_tier": (
            subscription_tier if isinstance(subscription_tier, str) else None
        ),
        "usage_percent": usage_percent,
        "period_type": (
            current.get("type") if isinstance(current.get("type"), str) else None
        ),
        "reset_at": current.get("end") or config.get("billingPeriodEnd"),
        "prepaid_balance_cents": prepaid_cents,
    }


def query_grok(binary: str) -> dict[str, object]:
    process = subprocess.Popen(
        [binary, "--no-auto-update", "agent", "stdio"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        encoding="utf-8",
        bufsize=1,
    )
    deadline = time.monotonic() + 35
    try:
        send_rpc(
            process,
            {
                "jsonrpc": "2.0",
                "id": 1,
                "method": "initialize",
                "params": {
                    "protocolVersion": 1,
                    "clientCapabilities": {
                        "fs": {"readTextFile": True, "writeTextFile": True},
                        "terminal": True,
                    },
                },
            },
        )
        initialized = read_rpc_response(process, 1, deadline)
        auth_methods = initialized.get("authMethods", [])
        if not any(method.get("id") == "cached_token" for method in auth_methods):
            raise RuntimeError("Grok subscription login is unavailable; run `grok login`")
        send_rpc(
            process,
            {
                "jsonrpc": "2.0",
                "id": 2,
                "method": "authenticate",
                "params": {"methodId": "cached_token", "_meta": {"headless": True}},
            },
        )
        read_rpc_response(process, 2, deadline)
        send_rpc(
            process,
            {"jsonrpc": "2.0", "id": 3, "method": "_x.ai/billing", "params": {}},
        )
        result = read_rpc_response(process, 3, deadline)
        return grok_usage(result)
    except TimeoutError as error:
        raise RuntimeError("Grok billing request timed out after 35 seconds") from error
    finally:
        stop_process(process)


def read_claude_credentials():
    config_directory = os.environ.get("CLAUDE_CONFIG_DIR")
    if sys.platform == "darwin":
        secure_storage_directory = os.environ.get("CLAUDE_SECURESTORAGE_CONFIG_DIR")
        keychain_directory = secure_storage_directory or config_directory
        service = "Claude Code-credentials"
        if keychain_directory:
            normalized_directory = unicodedata.normalize("NFC", keychain_directory)
            suffix = hashlib.sha256(os.fsencode(normalized_directory)).hexdigest()[:8]
            service = f"{service}-{suffix}"
        security = shutil.which("security")
        if not security:
            raise RuntimeError("macOS Keychain command `security` is unavailable")
        process = subprocess.run(
            [security, "find-generic-password", "-s", service, "-w"],
            capture_output=True,
            text=True,
            check=False,
        )
        if process.returncode:
            raise RuntimeError("Claude Code OAuth credentials were not found in Keychain")
        contents = process.stdout
    elif sys.platform.startswith("linux"):
        directory = Path(config_directory).expanduser() if config_directory else Path.home() / ".claude"
        credential_path = directory / ".credentials.json"
        try:
            contents = credential_path.read_text(encoding="utf-8")
        except FileNotFoundError as error:
            raise RuntimeError("Claude Code OAuth credentials were not found") from error
        except OSError as error:
            raise RuntimeError(f"cannot read Claude Code credentials: {error.strerror}") from error
    else:
        raise RuntimeError("Claude Code subscription usage supports macOS and Linux")
    try:
        credentials = json.loads(contents)
    except json.JSONDecodeError as error:
        raise RuntimeError("Claude Code credential store contains invalid JSON") from error
    oauth = credentials.get("claudeAiOauth") if isinstance(credentials, dict) else None
    if not isinstance(oauth, dict) or not isinstance(oauth.get("accessToken"), str):
        raise RuntimeError("Claude Code credential store has no OAuth subscription token")
    return oauth


def query_claude(binary: str) -> dict[str, object]:
    oauth = read_claude_credentials()
    token = oauth["accessToken"]
    curl = shutil.which("curl")
    if not curl:
        raise RuntimeError("curl is required to verify Anthropic's HTTPS certificate")
    if any(character in token for character in "\r\n\x00"):
        raise RuntimeError("Claude Code OAuth token contains invalid header characters")
    headers = (
        "Accept: application/json",
        f"Authorization: Bearer {token}",
        "anthropic-beta: oauth-2025-04-20",
        "User-Agent: dotfiles-usage/1",
    )
    config = "".join(
        f'header = "{curl_config_value(header)}"\n'
        for header in headers
    )
    del token
    process = subprocess.run(
        [
            curl,
            "-q",
            "--silent",
            "--show-error",
            "--connect-timeout",
            "5",
            "--max-time",
            "12",
            "--config",
            "-",
            "--write-out",
            "\\n%{http_code}",
            "https://api.anthropic.com/api/oauth/usage",
        ],
        input=config,
        capture_output=True,
        text=True,
        encoding="utf-8",
        check=False,
    )
    if process.returncode:
        detail = process.stderr.strip() or f"curl exited with status {process.returncode}"
        raise RuntimeError(f"Claude usage request failed: {detail}")
    body, separator, status = process.stdout.rpartition("\n")
    if not separator or len(status) != 3 or not status.isdigit():
        raise RuntimeError("curl returned an invalid HTTP response")
    status_code = int(status)
    if status_code in (401, 403):
        raise RuntimeError("Anthropic rejected the OAuth token; open Claude Code to refresh the login")
    if status_code == 429:
        raise RuntimeError("Anthropic rate-limited the usage request; try again later")
    if status_code < 200 or status_code >= 300:
        raise RuntimeError(f"Anthropic usage endpoint returned HTTP {status_code}")
    try:
        usage = json.loads(body)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise RuntimeError("Anthropic returned invalid usage JSON") from error
    if not isinstance(usage, dict):
        raise RuntimeError("Anthropic returned an invalid usage response")
    if not claude_windows(usage):
        raise RuntimeError("Anthropic returned no recognized quota windows")
    return {"plan": oauth.get("subscriptionType"), "usage": json_object(usage, "Anthropic returned an invalid usage response")}


def curl_config_value(value):
    return value.replace("\\", "\\\\").replace('"', '\\"')


def read_deepseek_api_key():
    token = os.environ.get("DEEPSEEK_API_KEY")
    if token:
        return token
    vault = shutil.which("vault")
    if not vault:
        raise RuntimeError("set DEEPSEEK_API_KEY or install vault with that entry")
    process = subprocess.run(
        [
            vault,
            "DEEPSEEK_API_KEY",
            "--",
            sys.executable,
            "-I",
            "-c",
            "import os, sys; sys.stdout.write(os.environ.get('DEEPSEEK_API_KEY', ''))",
        ],
        capture_output=True,
        text=True,
        encoding="utf-8",
        timeout=10,
        check=False,
    )
    if process.returncode:
        detail = process.stderr.strip() or "vault could not provide DEEPSEEK_API_KEY"
        raise RuntimeError(detail)
    if not process.stdout:
        raise RuntimeError("vault returned an empty DEEPSEEK_API_KEY")
    return process.stdout


def query_dsh(binary: str) -> dict[str, object]:
    token = read_deepseek_api_key()
    curl = shutil.which("curl")
    if not curl:
        raise RuntimeError("curl is required to verify DeepSeek's HTTPS certificate")
    if any(character in token for character in "\r\n\x00"):
        raise RuntimeError("DeepSeek API key contains invalid header characters")
    headers = (
        "Accept: application/json",
        f"Authorization: Bearer {token}",
        "User-Agent: dotfiles-usage/1",
    )
    config = "".join(
        f'header = "{curl_config_value(header)}"\n'
        for header in headers
    )
    del token
    process = subprocess.run(
        [
            curl,
            "-q",
            "--silent",
            "--show-error",
            "--connect-timeout",
            "5",
            "--max-time",
            "12",
            "--config",
            "-",
            "--write-out",
            "\\n%{http_code}",
            "https://api.deepseek.com/user/balance",
        ],
        input=config,
        capture_output=True,
        text=True,
        encoding="utf-8",
        check=False,
    )
    if process.returncode:
        detail = process.stderr.strip() or f"curl exited with status {process.returncode}"
        raise RuntimeError(f"DeepSeek balance request failed: {detail}")
    body, separator, status = process.stdout.rpartition("\n")
    if not separator or len(status) != 3 or not status.isdigit():
        raise RuntimeError("curl returned an invalid HTTP response")
    status_code = int(status)
    if status_code in (401, 403):
        raise RuntimeError("DeepSeek rejected the API key")
    if status_code == 402:
        raise RuntimeError("DeepSeek reports insufficient API balance")
    if status_code == 429:
        raise RuntimeError("DeepSeek rate-limited the balance request; try again later")
    if status_code < 200 or status_code >= 300:
        raise RuntimeError(f"DeepSeek balance endpoint returned HTTP {status_code}")
    try:
        result = json.loads(body)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise RuntimeError("DeepSeek returned invalid balance JSON") from error
    if not isinstance(result, dict) or not isinstance(result.get("is_available"), bool):
        raise RuntimeError("DeepSeek returned an invalid balance response")
    balances = result.get("balance_infos")
    if not isinstance(balances, list):
        raise RuntimeError("DeepSeek returned no balance information")
    for balance in balances:
        if not isinstance(balance, dict) or any(
            not isinstance(balance.get(field), str)
            for field in ("currency", "total_balance", "granted_balance", "topped_up_balance")
        ):
            raise RuntimeError("DeepSeek returned an invalid balance entry")
    return json_object(result, "DeepSeek returned an invalid balance response")


def query_agy(binary: str) -> dict[str, object]:
    process = subprocess.run(
        [binary, "-p", "/usage", "--output-format", "json", "--print-timeout", "30s"],
        capture_output=True,
        text=True,
        timeout=35,
        check=False,
    )
    if process.returncode:
        detail = process.stderr.strip() or "command failed"
        raise RuntimeError(detail)
    try:
        result = json.loads(process.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("Antigravity returned invalid JSON") from error
    if result.get("status") == "ERROR":
        raise RuntimeError(result.get("error") or result.get("response") or "usage read failed")
    report = result.get("response") or result.get("structured_output")
    if not report:
        raise RuntimeError("Antigravity returned no quota report")
    return {"report": report}


def read_opencode_account(binary: str) -> dict[str, object]:
    try:
        process = subprocess.run(
            [binary, "auth", "export"],
            capture_output=True,
            text=True,
            encoding="utf-8",
            timeout=15,
            check=False,
        )
    except subprocess.TimeoutExpired as error:
        raise RuntimeError("OpenCode auth export timed out") from error
    except OSError as error:
        raise RuntimeError(f"cannot run OpenCode auth export: {error.strerror}") from error
    if process.returncode:
        detail = process.stderr.strip() or "auth export failed"
        raise RuntimeError(detail)
    try:
        credentials = json.loads(process.stdout)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise RuntimeError("OpenCode auth export returned invalid JSON") from error
    if not isinstance(credentials, list):
        raise RuntimeError("OpenCode auth export returned an invalid credential list")
    fallback = None
    for entry in credentials:
        if not isinstance(entry, dict):
            continue
        if entry.get("integrationID") != "opencode":
            continue
        value = entry.get("value")
        if not isinstance(value, dict):
            continue
        if not isinstance(value.get("access"), str):
            continue
        if entry.get("active"):
            return json_object(entry, "OpenCode auth export returned an invalid credential")
        if fallback is None:
            fallback = entry
    if fallback is None:
        raise RuntimeError("OpenCode Go login not found; run `opencode2 auth login`")
    return json_object(fallback, "OpenCode auth export returned an invalid credential")


def query_opencode(binary: str) -> dict[str, object]:
    account = read_opencode_account(binary)
    value = account.get("value")
    if not isinstance(value, dict):
        raise RuntimeError("OpenCode auth export returned an invalid credential")
    token = value.get("access")
    if not isinstance(token, str):
        raise RuntimeError("OpenCode auth export returned an invalid credential")
    metadata = value.get("metadata")
    metadata = metadata if isinstance(metadata, dict) else {}
    curl = shutil.which("curl")
    if not curl:
        raise RuntimeError("curl is required to verify OpenCode's HTTPS certificate")
    if any(character in token for character in "\r\n\x00"):
        raise RuntimeError("OpenCode OAuth token contains invalid header characters")
    headers = (
        "Accept: application/json",
        f"Authorization: Bearer {token}",
        "User-Agent: dotfiles-usage/1",
    )
    config = "".join(
        f'header = "{curl_config_value(header)}"\n'
        for header in headers
    )
    del token
    process = subprocess.run(
        [
            curl,
            "-q",
            "--silent",
            "--show-error",
            "--connect-timeout",
            "5",
            "--max-time",
            "12",
            "--config",
            "-",
            "--write-out",
            "\\n%{http_code}",
            "https://opencode.ai/zen/go/v1/usage",
        ],
        input=config,
        capture_output=True,
        text=True,
        encoding="utf-8",
        check=False,
    )
    if process.returncode:
        detail = process.stderr.strip() or f"curl exited with status {process.returncode}"
        raise RuntimeError(f"OpenCode usage request failed: {detail}")
    body, separator, status = process.stdout.rpartition("\n")
    if not separator or len(status) != 3 or not status.isdigit():
        raise RuntimeError("curl returned an invalid HTTP response")
    status_code = int(status)
    if status_code in (401, 403):
        raise RuntimeError("OpenCode rejected the stored credential; run `opencode2 auth login` to refresh the login")
    if status_code == 429:
        raise RuntimeError("OpenCode rate-limited the usage request; try again later")
    if status_code < 200 or status_code >= 300:
        raise RuntimeError(f"OpenCode usage endpoint returned HTTP {status_code}")
    try:
        result = json.loads(body)
    except (json.JSONDecodeError, UnicodeDecodeError) as error:
        raise RuntimeError("OpenCode returned invalid usage JSON") from error
    if not isinstance(result, dict):
        raise RuntimeError("OpenCode returned an invalid usage response")
    if not opencode_windows(result):
        raise RuntimeError("OpenCode returned no recognized quota windows")
    usage = result.get("usage")
    email = metadata.get("email")
    org = metadata.get("orgName")
    return {
        "email": email if isinstance(email, str) else None,
        "org": org if isinstance(org, str) else None,
        "usage": usage,
    }


def local_time(timestamp, scale=1):
    if not isinstance(timestamp, (int, float)):
        return "unknown"
    try:
        return datetime.datetime.fromtimestamp(timestamp / scale).astimezone().strftime(
            "%Y-%m-%d %H:%M %Z"
        )
    except (OverflowError, OSError, ValueError):
        return "unknown"


def reset_seconds(timestamp: object, scale: float = 1) -> float | None:
    try:
        if isinstance(timestamp, (int, float)) and not isinstance(timestamp, bool):
            target = timestamp / scale
        elif isinstance(timestamp, str):
            parsed = datetime.datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
            target = parsed.timestamp()
        else:
            return None
        return target - time.time()
    except (OverflowError, OSError, ValueError):
        return None


def reset_delay(timestamp: object, scale: float = 1) -> str:
    remaining = reset_seconds(timestamp, scale)
    if remaining is None:
        return "unknown"
    if remaining <= 0:
        return "now"
    minutes = math.ceil(remaining / 60)
    days, remainder = divmod(minutes, 1440)
    hours, minutes = divmod(remainder, 60)
    parts = []
    if days:
        parts.append(f"{days}d")
    if hours:
        parts.append(f"{hours}h")
    if minutes or not parts:
        parts.append(f"{minutes}m")
    return "".join(parts)


def duration_name(minutes):
    if not isinstance(minutes, (int, float)) or minutes <= 0:
        return None
    if minutes == 300:
        return "5h"
    if minutes == 10080:
        return "7d"
    days, remainder = divmod(int(minutes), 1440)
    hours, remaining_minutes = divmod(remainder, 60)
    parts = []
    if days:
        parts.append(f"{days}d")
    if hours:
        parts.append(f"{hours}h")
    if remaining_minutes or not parts:
        parts.append(f"{remaining_minutes}m")
    return " ".join(parts)


def color(text, code, stream=None):
    stream = stream or sys.stdout
    if not stream.isatty() or "NO_COLOR" in os.environ:
        return str(text)
    return f"\033[{code}m{text}\033[0m"


def percentage_text(value):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return color("unknown", "2") if value is None else str(value)
    text = f"{value:g}% used"
    if value >= 100:
        return color(text, "31")
    if value >= 80:
        return color(text, "33")
    return color(text, "32")


def print_heading(title):
    print(color(title, "1;36"))


def reset_urgency_color(timestamp: object, scale: float = 1) -> str:
    remaining = reset_seconds(timestamp, scale)
    if remaining is None:
        return "2"
    if remaining < 86400:
        return "38;5;208"
    if remaining > 259200:
        return "32"
    return "33"


def print_window(label: str, used: object, reset: object, scale: float = 1) -> None:
    delay = reset_delay(reset, scale)
    reset_text = color("resets in " + delay, reset_urgency_color(reset, scale))
    print(f"  {label}: {percentage_text(used)}, {reset_text}")


def normalize_window_label(raw: object, fallback: str) -> str:
    if isinstance(raw, str) and raw.strip():
        token = raw.strip().upper()
        if "WEEK" in token:
            return "7d"
        if "MONTH" in token:
            return "30d"
        if any(key in token for key in ("SESSION", "ROLLING", "HOURLY", "5H", "FIVE")):
            return "5h"
        if "DAY" in token or "DAILY" in token:
            return "24h"
        cleaned = raw.strip().removeprefix("USAGE_PERIOD_TYPE_").replace("_", " ").strip()
        if cleaned:
            return cleaned
    return fallback


def print_codex(result: dict[str, object]) -> None:
    print_heading("Codex")
    buckets = result.get("rateLimitsByLimitId") or {}
    bucket = buckets.get("codex") if isinstance(buckets, dict) else None
    bucket = bucket or result.get("rateLimits")
    if not isinstance(bucket, dict):
        print(f"  {color('no subscription quota returned', '33')}")
        return
    plan = bucket.get("planType")
    if plan:
        print(f"  plan: {plan}")
    windows = []
    for slot in ("primary", "secondary"):
        window = bucket.get(slot)
        if isinstance(window, dict):
            windows.append((slot, window))
    if not windows:
        print(f"  {color('no subscription quota returned', '33')}")
        return
    for slot, window in windows:
        label = duration_name(window.get("windowDurationMins")) or normalize_window_label(
            slot, slot
        )
        label = {"primary": "5h", "secondary": "7d"}.get(label, label)
        used = window.get("usedPercent")
        print_window(label, used, window.get("resetsAt"))


def claude_windows(result):
    limits = result.get("limits")
    if isinstance(limits, list):
        windows = []
        for item in limits:
            if not isinstance(item, dict):
                continue
            percent = item.get("percent")
            if isinstance(percent, bool) or not isinstance(percent, (int, float)):
                continue
            kind = item.get("kind")
            if not isinstance(kind, str):
                continue
            model_scope = item.get("scope")
            model = model_scope.get("model") if isinstance(model_scope, dict) else None
            if isinstance(model, str):
                model_name = model
            elif isinstance(model, dict):
                model_name = model.get("display_name") or model.get("id")
            else:
                model_name = None
            if kind == "session":
                label = "5h"
            elif kind == "weekly_all":
                label = "7d"
            elif kind == "weekly_scoped" and model_name:
                label = f"7d {model_name}"
            else:
                label = kind.replace("_", " ")
                if model_name:
                    label = f"{label} {model_name}"
            windows.append((label, percent, item.get("resets_at")))
        if windows:
            return windows
    windows = []
    for key, item in result.items():
        if key == "five_hour":
            label = "5h"
        elif key == "seven_day":
            label = "7d"
        elif key.startswith("seven_day_"):
            label = f"7d {key.removeprefix('seven_day_').replace('_', ' ')}"
        else:
            continue
        if not isinstance(item, dict):
            continue
        percent = item.get("utilization")
        if isinstance(percent, bool) or not isinstance(percent, (int, float)):
            continue
        windows.append((label, percent, item.get("resets_at")))
    return windows


def print_claude(result: dict[str, object]) -> None:
    print_heading("Claude Code")
    if result.get("plan"):
        print(f"  plan: {result['plan']}")
    windows = claude_windows(result["usage"])
    for label, percent, reset in windows:
        print_window(label, percent, reset)


def print_muse(result: dict[str, object]) -> None:
    print_heading("Muse Code")
    allowance = result.get("allowance")
    if isinstance(allowance, dict):
        tier = allowance.get("tier")
        if tier:
            print(f"  plan: {tier}")
        current = allowance.get("window")
        weekly = allowance.get("weekly")
        shown = False
        if isinstance(current, dict) and is_percent(current.get("usedPercent")):
            print_window("5h", current.get("usedPercent"), current.get("resetsAtMs"), 1000)
            shown = True
        if isinstance(weekly, dict) and is_percent(weekly.get("usedPercent")):
            print_window("7d", weekly.get("usedPercent"), weekly.get("resetsAtMs"), 1000)
            shown = True
        if shown:
            return
        print(f"  {color('no subscription quota returned', '33')}")
        return
    usage = result.get("usage")
    if not isinstance(usage, dict):
        print(f"  {color('no subscription quota returned', '33')}")
        return
    if usage.get("tier"):
        print(f"  plan: {usage.get('tier')}")
    print(f"  {color('(last observed)', '2')}")
    current = usage.get("window")
    weekly = usage.get("weekly")
    if isinstance(current, dict):
        label = duration_name(current.get("windowDurationMins")) or "current window"
        print_window(label, current.get("usedPercent"), current.get("resetsAtMs"), 1000)
    if isinstance(weekly, dict):
        print_window("7d", weekly.get("usedPercent"), weekly.get("resetsAtMs"), 1000)


def print_grok(result: dict[str, object]) -> None:
    print_heading("Grok Build")
    if result.get("subscription_tier"):
        print(f"  plan: {result['subscription_tier']}")
    label = normalize_window_label(result.get("period_type"), "subscription")
    print_window(label, result.get("usage_percent"), result.get("reset_at"))
    prepaid = result.get("prepaid_balance_cents")
    if isinstance(prepaid, (int, float)) and not isinstance(prepaid, bool):
        print(f"  prepaid credits: ${prepaid / 100:.2f}")


def print_dsh(result: dict[str, object]) -> None:
    print_heading("DeepSeek API")
    available = result.get("is_available")
    label = "available for API requests" if available else "insufficient for API requests"
    print(f"  {color(label, '32' if available else '31')}")
    balances = result.get("balance_infos")
    if not isinstance(balances, list):
        raise RuntimeError("DeepSeek returned no balance information")
    for balance in balances:
        if not isinstance(balance, dict):
            raise RuntimeError("DeepSeek returned an invalid balance entry")
        currency = balance.get("currency")
        total = balance.get("total_balance")
        granted = balance.get("granted_balance")
        topped_up = balance.get("topped_up_balance")
        print(
            f"  {currency}: {total} total "
            f"({granted} granted, {topped_up} topped up)"
        )


def print_agy(result: dict[str, object]) -> None:
    print_heading("Antigravity")
    for line in str(result.get("report")).strip().splitlines():
        print(f"  {line}")


def opencode_windows(result):
    usage = result.get("usage") if isinstance(result, dict) else None
    if not isinstance(usage, dict):
        return []
    windows = []
    for key, label in (("rolling", "5h"), ("weekly", "7d"), ("monthly", "30d")):
        window = usage.get(key)
        if not isinstance(window, dict):
            continue
        percent = window.get("percent")
        if (
            isinstance(percent, bool)
            or not isinstance(percent, (int, float))
            or not math.isfinite(percent)
        ):
            continue
        status = window.get("status")
        if not isinstance(status, str):
            status = None
        windows.append((label, percent, window.get("resetsAt"), status))
    return windows


def print_opencode(result: dict[str, object]) -> None:
    print_heading("OpenCode Go")
    email = result.get("email")
    org = result.get("org")
    if isinstance(email, str) and email:
        detail = email
        if isinstance(org, str) and org:
            detail = f"{detail} ({org})"
        print(f"  account: {detail}")
    for label, percent, reset, status in opencode_windows(result):
        if isinstance(status, str) and status and status != "ok":
            label = f"{label} [{status}]"
        print_window(label, percent, reset)


def main(arguments):
    if arguments in (["-h"], ["--help"]):
        print(HELP, end="")
        return 0
    if len(arguments) > 1:
        print(HELP, end="", file=sys.stderr)
        return 2
    selected = arguments[0] if arguments else None
    providers = {item[0]: item for item in PROVIDERS}
    if selected is not None and selected not in providers:
        print(HELP, end="", file=sys.stderr)
        return 2
    candidates = (providers[selected],) if selected is not None else PROVIDERS
    available = []
    for item in candidates:
        binary = shutil.which(item[2])
        if binary:
            available.append((item, binary))
        elif selected is not None:
            print(f"usage: {item[2]} is not installed", file=sys.stderr)
            return 1
    if not available:
        print("usage: no supported subscription-usage CLI is installed", file=sys.stderr)
        return 1
    query = {
        "claude": query_claude,
        "codex": query_codex,
        "muse": query_muse,
        "grok": query_grok,
        "dsh": query_dsh,
        "agy": query_agy,
        "opencode": query_opencode,
    }
    render = {
        "claude": print_claude,
        "codex": print_codex,
        "muse": print_muse,
        "grok": print_grok,
        "dsh": print_dsh,
        "agy": print_agy,
        "opencode": print_opencode,
    }
    results = {}
    failures = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(available)) as pool:
        futures = {
            pool.submit(query[key], binary): key
            for (key, _, _), binary in available
        }
        for future in concurrent.futures.as_completed(futures):
            key = futures[future]
            try:
                results[key] = future.result()
            except Exception as error:
                failures[key] = str(error)
    for key, title, _ in providers.values():
        if key not in results and key not in failures:
            continue
        if key in failures:
            print(color(f"{title}: {failures[key]}", "1;31", sys.stderr), file=sys.stderr)
            continue
        render[key](results[key])
    return 1 if failures else 0


raise SystemExit(main(sys.argv[1:]))
