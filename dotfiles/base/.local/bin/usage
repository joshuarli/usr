#!/bin/sh
# Shim: the real implementation lives at tools/usage/src/usage.
set -eu
self="$0"
while [ -L "$self" ]; do
    link=$(readlink "$self") || break
    case "$link" in
        /*) self="$link" ;;
        *) self="$(dirname -- "$self")/$link" ;;
    esac
done
root=$(CDPATH='' cd -- "$(dirname -- "$self")/../../../.." && pwd)
exec "$root/tools/usage/src/usage" "$@"
