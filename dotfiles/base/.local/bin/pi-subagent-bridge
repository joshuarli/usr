#!/bin/sh
set -eu
script=$0
case $script in
    */*) ;;
    *) script=$(command -v "$script") ;;
esac
while [ -L "$script" ]; do
    link=$(readlink "$script")
    case $link in
        /*) script=$link ;;
        *) script=$(dirname "$script")/$link ;;
    esac
done
root=$(CDPATH='' cd -- "$(dirname "$script")/../../../.." && pwd -P)
exec node --experimental-strip-types "$root/tools/pi-subagent-bridge/src/cli.ts" "$@"
