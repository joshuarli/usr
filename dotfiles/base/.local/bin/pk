#!/bin/sh
set -eu

usage() {
    printf '%s\n' \
        'usage: pk [-9] query...' \
        '  Type to filter; Down selects a row, Space marks/unmarks, Enter kills.' \
        '  Without marks, Enter kills the focused row. Esc cancels.' \
        '  -9  send SIGKILL rather than SIGTERM'
}

signal=TERM
while [ "$#" -gt 0 ]; do
    case $1 in
        -9|--force) signal=KILL; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) usage >&2; exit 2 ;;
        *) break ;;
    esac
done
[ "$#" -gt 0 ] || { usage >&2; exit 2; }
query=$*

if ! command -v fz >/dev/null 2>&1; then
    printf 'pk: fz is required (github.com/laputa-systems/fz)\n' >&2
    exit 1
fi
if ! fz --help 2>&1 | grep -Fq -- '--multi'; then
    printf 'pk: update fz to a version supporting --multi\n' >&2
    exit 1
fi

user=$(id -un)
parent=$(LC_ALL=C ps -p "$$" -o ppid= 2>/dev/null | awk 'NR == 1 { print $1 }')
if ! snapshot=$(LC_ALL=C ps -ww -u "$user" -o pid=,ppid=,lstart=,args=); then
    printf 'pk: cannot list processes\n' >&2
    exit 1
fi

# Display only this user's positive PIDs, excluding this command and its
# invoking shell. Keep the original ps records for identity verification.
candidates=$(printf '%s\n' "$snapshot" | LC_ALL=C awk \
    -v self="$$" -v parent="$parent" '
    $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && NF >= 8 && $1 > 1 &&
    $1 != self && $1 != parent && $2 != self {
        command = $0
        for (i = 1; i <= 7; i++)
            sub(/^[[:space:]]*[^[:space:]]+[[:space:]]*/, "", command)
        gsub(/[[:cntrl:]]/, "?", command)
        if (command != "") printf "%s  %s\n", $1, command
    }')
if [ -z "$candidates" ]; then
    printf 'pk: no eligible processes\n' >&2
    exit 0
fi

prompt='TERM> '
[ "$signal" = KILL ] && prompt='KILL> '
# fz --multi emits marked rows in marking order, or the focused row if
# nothing is marked. Cancellation emits nothing; no signal is sent.
if ! selection=$(printf '%s\n' "$candidates" | \
        fz --multi --query="$query" --prompt="$prompt"); then
    exit 0
fi
[ -n "$selection" ] || exit 0

# Validate the entire batch before signaling. Reject invented rows,
# duplicate PIDs, and unmatched-query echoes even if the selector misbehaves.
seen=' '
while IFS= read -r entry; do
    if [ -z "$entry" ] || ! printf '%s\n' "$candidates" | grep -Fxq -- "$entry"; then
        printf 'pk: rejected invalid process selection\n' >&2
        exit 1
    fi
    pid=${entry%% *}
    case $seen in
        *" $pid "*)
            printf 'pk: rejected duplicate process %s\n' "$pid" >&2
            exit 1
            ;;
    esac
    seen="$seen$pid "
done <<EOF_SELECTION
$selection
EOF_SELECTION

failed=0
while IFS= read -r entry; do
    pid=${entry%% *}
    # PID-only signaling is vulnerable to recycling. Compare the original
    # process's PPID, start time and argv against a fresh record before kill.
    # This is best-effort: POSIX kill cannot eliminate the final TOCTOU gap.
    before=$(printf '%s\n' "$snapshot" | awk -v pid="$pid" '
        $1 == pid { sub(/^[[:space:]]*/, ""); print; exit }')
    now=$(LC_ALL=C ps -ww -p "$pid" -o pid=,ppid=,lstart=,args= 2>/dev/null | \
          awk -v pid="$pid" '$1 == pid { sub(/^[[:space:]]*/, ""); print; exit }')
    if [ -z "$before" ] || [ "$before" != "$now" ]; then
        printf 'pk: skipped %s (process exited or changed)\n' "$pid" >&2
        failed=1
    elif kill -s "$signal" "$pid" 2>/dev/null; then
        printf 'pk: sent %s to %s\n' "$signal" "$pid"
    else
        printf 'pk: cannot send %s to %s\n' "$signal" "$pid" >&2
        failed=1
    fi
done <<EOF_SELECTION
$selection
EOF_SELECTION
exit "$failed"
