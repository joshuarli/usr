#!/bin/sh
# setup-kache - install Kache from the joshuarli/kache GitHub releases and set it up.
#
# Usage:
#   setup-kache [--version release-70c22925abc6a194006fb5ce85c9a195150a1401] [--nightly nightly-2026-09-15] [--force]
#   setup-kache uninstall [--purge]
#
# Detects macOS/Linux on aarch64/x86_64, resolves the newest release-*
# GitHub release through releases.atom (like the other tools), downloads
# the matching kache-<triple>.zip and kache-engine-<triple>.zip plus
# SHA256SUMS, verifies both checksums, installs them as
# ${CARGO_HOME:-~/.cargo}/bin/kache and ${CARGO_HOME:-~/.cargo}/bin/kache-engine,
# idempotently ensures
# ~/.cargo/config.toml carries the kache-managed keys, then runs kache init,
# installs compiler shims, verifies the setup under the preferred nightly
# toolchain (rust-toolchain.toml style: nightly-2026-09-15), and finally
# runs kache config when interactive.
#
# `setup-kache uninstall` reverses it: stops the daemon, removes the login
# service, empties the cache with --purge, removes the shims, strips the
# kache-managed keys from ~/.cargo/config.toml, and deletes both
# binaries and the release tag file.
#
# Env overrides: KACHE_VERSION (release tag; empty means newest release-*),
# KACHE_NIGHTLY.
# Only linux and macos on aarch64/x86_64 are supported. Published triples are
# aarch64-apple-darwin, aarch64-unknown-linux-musl-static, and
# x86_64-unknown-linux-musl-static; other combinations fail at the
# SHA256SUMS lookup.
#
# The kache binary reports its own version (e.g. kache 2.0.0-rc.2), which
# differs from the release-* tag. Currency is tracked in
# ${CARGO_HOME:-~/.cargo}/bin/.kache-release, not by comparing versions.

set -eu

prog=${0##*/}
version="${KACHE_VERSION:-}"
nightly="${KACHE_NIGHTLY:-nightly-2026-09-15}"
force=0
mode=install
purge=0

die() { printf '%s: %s\n' "$prog" "$*" >&2; exit 1; }
usage() {
    printf 'usage: %s [--version release-<sha>] [--nightly nightly-2026-09-15] [--force]\n' "$prog" >&2
    printf '       %s uninstall [--purge]\n' "$prog" >&2
    exit 2
}
log() { printf '%s: %s\n' "$prog" "$*"; }
quiet() {
    quiet_out=$("$@" 2>&1) || { printf '%s\n' "$quiet_out" >&2; die "failed: $*"; }
}

repo=https://github.com/joshuarli/kache

latest_tag() {
    curl -fsSL "$repo/releases.atom" | awk '
        /<entry>/ { in_entry = 1; updated = ""; tag = "" }
        in_entry && /<updated>/ {
            updated = $0
            sub(/^.*<updated>/, "", updated)
            sub(/<.*/, "", updated)
        }
        in_entry && /<link[^>]*releases\/tag\// {
            tag = $0
            sub(/^.*releases\/tag\//, "", tag)
            sub(/".*/, "", tag)
            if (index(tag, "release-") != 1) tag = ""
        }
        /\/entry>/ {
            if (updated > newest_updated && tag != "") {
                newest_updated = updated
                newest_tag = tag
            }
            in_entry = 0
        }
        END { print newest_tag }
    '
}

checksum_of() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        die "no shasum or sha256sum found"
    fi
}

# Ensure a `key = value` line exists under a [section] header in a TOML file.
# Idempotent: does nothing when the key is already present anywhere in the
# file, preserves comments and all other content, creates the file/section
# when missing.
ensure_toml_key() {
    file=$1; section=$2; key=$3; value=$4
    if [ ! -f "$file" ]; then
        printf '\n[%s]\n%s = %s\n' "$section" "$key" "$value" >> "$file"
        return 0
    fi
    if grep -Eq "^[[:space:]]*${key}[[:space:]]*=" "$file"; then
        return 0
    fi
    if grep -Eq "^[[:space:]]*\\[${section}\\][[:space:]]*$" "$file"; then
        tmp=$(mktemp "${TMPDIR:-/tmp}/setup-kache.toml.XXXXXX")
        awk -v line="$key = $value" '
            { print }
            !done && /^[[:space:]]*\['"$section"'\][[:space:]]*$/ { print line; done = 1 }
        ' "$file" > "$tmp" && cat "$tmp" > "$file"
        rm -f "$tmp"
    else
        printf '\n[%s]\n%s = %s\n' "$section" "$key" "$value" >> "$file"
    fi
}

# Refresh only values owned by kache, including paths copied from another host.
# Leave foreign wrappers and rustdoc commands for kache init to resolve.
refresh_kache_key() {
    file=$1; section=$2; key=$3; value=$4
    if [ -f "$file" ]; then
        tmp=$(mktemp "${TMPDIR:-/tmp}/setup-kache.toml.XXXXXX")
        awk -v section="$section" -v key="$key" -v value="$value" '
            /^[[:space:]]*\[/ {
                header = $0
                sub(/^[[:space:]]*\[/, "", header)
                sub(/\][[:space:]]*$/, "", header)
            }
            header == section && $0 ~ "^[[:space:]]*" key "[[:space:]]*=" && $0 ~ /kache/ {
                print key " = " value
                next
            }
            { print }
        ' "$file" > "$tmp"
        cat "$tmp" > "$file"
        rm -f "$tmp"
    fi
    ensure_toml_key "$file" "$section" "$key" "$value"
}

ensure_cargo_config() {
    cfg="${CARGO_HOME:-$HOME/.cargo}/config.toml"
    if [ -L "$cfg" ]; then
        log "cargo config is a symlink managed by the dotfiles; not editing $cfg"
        return
    fi
    mkdir -p "${CARGO_HOME:-$HOME/.cargo}"
    refresh_kache_key "$cfg" build rustc-wrapper "\"$dest\""
    refresh_kache_key "$cfg" build rustdoc "\"$HOME/.local/lib/kache/shims/rustdoc\""
    refresh_kache_key "$cfg" env HOST_CC "\"$dest cc\""
    refresh_kache_key "$cfg" env HOST_CXX "\"$dest c++\""
    refresh_kache_key "$cfg" env CC_KNOWN_WRAPPER_CUSTOM '"kache"'
}

# Remove the kache-managed keys from ~/.cargo/config.toml, preserving
# everything else. Drops a [build]/[env] header left with no keys. Only
# removes values that point at kache (a foreign rustdoc or wrapper is kept).
strip_cargo_config() {
    cfg="${CARGO_HOME:-$HOME/.cargo}/config.toml"
    [ -f "$cfg" ] || { log "no cargo config, nothing to strip"; return 0; }
    tmp=$(mktemp "${TMPDIR:-/tmp}/setup-kache.toml.XXXXXX")
    grep -Ev '^[[:space:]]*rustc-wrapper[[:space:]]*=[[:space:]]*"([^"]*/)?kache"' "$cfg" | \
    grep -Ev '^[[:space:]]*rustdoc[[:space:]]*=[[:space:]]*"[^"]*kache' | \
    grep -Ev '^[[:space:]]*HOST_CC[[:space:]]*=[[:space:]]*"([^"]*/)?kache' | \
    grep -Ev '^[[:space:]]*HOST_CXX[[:space:]]*=[[:space:]]*"([^"]*/)?kache' | \
    grep -Ev '^[[:space:]]*CC_KNOWN_WRAPPER_CUSTOM[[:space:]]*=[[:space:]]*"([^"]*/)?kache' | \
    awk '
        function flush() {
            if (!pending) return
            if (has_key) { print header; printf "%s", buf }
            pending = 0; buf = ""
        }
        /^[[:space:]]*\[(build|env)\][[:space:]]*$/ {
            flush(); header = $0; pending = 1; has_key = 0; next
        }
        pending && /^[[:space:]]*\[.*\][[:space:]]*$/ { flush(); print; next }
        pending { if ($0 ~ /=/) has_key = 1; buf = buf $0 "\n"; next }
        { flush(); print }
        END { flush() }
    ' > "$tmp" && cat "$tmp" > "$cfg"
    rm -f "$tmp"
    if grep -Eq 'kache' "$cfg"; then
        log "warning: $cfg still mentions kache, left in place:"
        grep -En 'kache' "$cfg" || true
    else
        log "cargo config clean: $cfg"
    fi
}

if [ "${1:-}" = "uninstall" ]; then
    mode=uninstall; shift
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --purge) purge=1; shift ;;
            -h|--help) usage ;;
            *) usage ;;
        esac
    done
else
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --version) [ "$#" -ge 2 ] || usage; version=$2; shift 2 ;;
            --nightly) [ "$#" -ge 2 ] || usage; nightly=$2; shift 2 ;;
            --force) force=1; shift ;;
            -h|--help) usage ;;
            --*) usage ;;
            *) usage ;;
        esac
    done
fi

if [ "$mode" = "uninstall" ]; then
    cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin"
    dest="${cargo_bin}/kache"
    export PATH="$cargo_bin:$PATH"
    if [ -x "$dest" ]; then
        kache daemon stop || log "daemon not running, continuing"
        kache daemon uninstall || log "no daemon service, continuing"
        if [ "$purge" -eq 1 ]; then
            kache clean --cache --yes || log "cache clean reported an issue, continuing"
        fi
    else
        log "no kache binary at $dest, skipping daemon/cache steps"
        if [ "$purge" -eq 1 ]; then
            log "cannot purge cache without the kache binary; remove the cache dir by hand"
        fi
    fi
    shims="$HOME/.local/lib/kache/shims"
    if [ -d "$shims" ]; then
        rm -rf "$shims"
        log "removed shims: $shims"
    else
        log "no shims dir, nothing to remove"
    fi
    strip_cargo_config
    if [ -e "$dest" ]; then
        if [ -x "$dest" ] && "$dest" --version 2>/dev/null | grep -q "kache "; then
            rm -f "$dest"
            log "removed $dest"
        else
            die "refusing: $dest does not look like kache"
        fi
    else
        log "no binary at $dest"
    fi
    engine="${cargo_bin}/kache-engine"
    if [ -e "$engine" ]; then
        if [ -x "$engine" ] && "$engine" --version 2>/dev/null | grep -q "kache "; then
            rm -f "$engine"
            log "removed $engine"
        else
            die "refusing: $engine does not look like kache-engine"
        fi
    else
        log "no engine at $engine"
    fi
    tagfile="${cargo_bin}/.kache-release"
    if [ -f "$tagfile" ]; then
        rm -f "$tagfile"
        log "removed $tagfile"
    fi
    # NB: this shell hashed kache's path while stopping the daemon, so clear
    # the hash before asking where kache is now.
    hash -r 2>/dev/null || true
    kache_path=$(command -v kache 2>/dev/null || true)
    case "$kache_path" in
        "") log "kache off PATH" ;;
        */*)
            if [ -e "$kache_path" ]; then
                die "kache still on PATH: $kache_path"
            else
                log "kache off PATH"
            fi
            ;;
        *) die "kache still on PATH ($kache_path)" ;;
    esac
    log "uninstalled. Left in place (if any): ~/.cargo/.kache-cargo-backup-*, logs,"
    if [ "$purge" -eq 0 ]; then
        log "and the cache dir (rerun with --purge to empty it)"
    fi
    log "cargo builds now run without the wrapper"
    exit 0
fi

[ -n "$nightly" ] || die "empty nightly toolchain"
if [ -n "$version" ]; then
    case "$version" in
        release-*) ;;
        *) die "invalid version: $version (expected a release-<sha> tag)" ;;
    esac
    case "$version" in
        *[!0-9A-Za-z.-]*) die "invalid version: $version" ;;
    esac
    tag=$version
else
    command -v curl >/dev/null 2>&1 || die "curl not found"
    tag=$(latest_tag)
    [ -n "$tag" ] || die "no kache release found"
fi
log "kache release $tag"

# Detect platform. Linux and macOS on aarch64/x86_64 only.
os=$(uname -s)
arch=$(uname -m)
case "$os" in
    Darwin) os_tag="apple-darwin" ;;
    Linux) os_tag="unknown-linux-musl-static" ;;
    *) die "unsupported OS: $os (linux and macos only)" ;;
esac
case "$arch" in
    arm64|aarch64) arch_tag="aarch64" ;;
    x86_64|amd64) arch_tag="x86_64" ;;
    *) die "unsupported arch: $arch (aarch64 and x86-64 only)" ;;
esac
triple="${arch_tag}-${os_tag}"
asset="kache-${triple}.zip"
engine_asset="kache-engine-${triple}.zip"
base_url="$repo/releases/download/$tag"

cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin"
dest="${cargo_bin}/kache"
engine="${cargo_bin}/kache-engine"
tagfile="${cargo_bin}/.kache-release"

# Skip re-download when the release tag file matches and both binaries run.
if [ "$force" -eq 0 ] && [ -f "$tagfile" ] && [ "$(cat "$tagfile")" = "$tag" ] \
    && [ -x "$dest" ] && [ -x "$engine" ] \
    && "$dest" --version 2>/dev/null | grep -q "kache "; then
    log "$dest already at $tag, continuing to setup"
    asset=""
    engine_asset=""
fi

if [ -n "$asset" ]; then
    command -v curl >/dev/null 2>&1 || die "curl not found"
    command -v unzip >/dev/null 2>&1 || die "unzip not found"
    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/setup-kache.XXXXXX")
    trap 'rm -rf "$tmpdir"' EXIT INT TERM

    curl -fsSL -o "$tmpdir/SHA256SUMS" "$base_url/SHA256SUMS"
    curl -fsSL -o "$tmpdir/$asset" "$base_url/$asset"
    curl -fsSL -o "$tmpdir/$engine_asset" "$base_url/$engine_asset"

    for zip in "$asset" "$engine_asset"; do
        want=$(grep -F "  $zip" "$tmpdir/SHA256SUMS" | awk '{print $1}')
        [ "${#want}" -eq 64 ] || die "$zip is not available in $tag"
        got=$(checksum_of "$tmpdir/$zip")
        [ "$got" = "$want" ] || die "checksum mismatch for $zip"
    done

    rm -rf "$tmpdir/unpack"
    mkdir -p "$tmpdir/unpack"
    unzip -q "$tmpdir/$asset" -d "$tmpdir/unpack"
    unzip -q "$tmpdir/$engine_asset" -d "$tmpdir/unpack"
    [ -f "$tmpdir/unpack/kache-${triple}" ] && [ ! -L "$tmpdir/unpack/kache-${triple}" ] \
        || die "$asset did not contain the kache binary"
    [ -f "$tmpdir/unpack/kache-engine-${triple}" ] && [ ! -L "$tmpdir/unpack/kache-engine-${triple}" ] \
        || die "$engine_asset did not contain the kache-engine binary"
    mkdir -p "$cargo_bin"
    install -m 755 "$tmpdir/unpack/kache-engine-${triple}" "$engine"
    install -m 755 "$tmpdir/unpack/kache-${triple}" "$dest"
    rm -rf "$tmpdir"
    trap - EXIT INT TERM

    "$dest" --version 2>/dev/null | grep -q "kache " \
        || die "installed binary does not report kache"
    printf '%s\n' "$tag" > "${tagfile}.tmp"
    install -m 644 "${tagfile}.tmp" "$tagfile"
    rm -f "${tagfile}.tmp"
    log "installed $("$dest" --version) ($tag)"
else
    command -v kache >/dev/null 2>&1 || [ -x "$dest" ] || die "kache not found"
fi

export PATH="$cargo_bin:$PATH"

if [ "$os" = Darwin ]; then
    for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$brew_bin" ]; then
            rustup_prefix=$("$brew_bin" --prefix rustup 2>/dev/null || :)
            if [ -n "$rustup_prefix" ] && [ -x "$rustup_prefix/bin/rustup" ]; then
                PATH="$rustup_prefix/bin:$PATH"
                break
            fi
        fi
    done
fi
export PATH

# Ensure the preferred nightly toolchain exists with rust-src (matches
# rust-toolchain.toml files that pin channel + rust-src component).
if ! rustup toolchain list 2>/dev/null | grep -q "^${nightly}"; then
    log "installing toolchain $nightly"
    quiet rustup toolchain install "$nightly" --component rust-src
fi
quiet rustup run "$nightly" rustc -vV

# Cargo config first (idempotent, preserves user content), then init for the
# daemon/service plus its own validation of the wrapper setup.
ensure_cargo_config
quiet kache init --yes --no-shell
quiet kache install-shims
# Init may preserve a previously configured path; normalize it after shims exist.
ensure_cargo_config

check_doctor() {
    doctor_out=$("$@" 2>&1) || { printf '%s\n' "$doctor_out" >&2; die "kache doctor failed: $*"; }
    printf '%s\n' "$doctor_out" | grep -Eq '"issues"[[:space:]]*:[[:space:]]*0([,}]|$)' \
        || { printf '%s\n' "$doctor_out" >&2; die "kache doctor reported issues: $*"; }
}

check_doctor kache doctor --json

# Doctor must also see the preferred nightly when run under it. This is the
# check that matters for rust-toolchain.toml pins: the wrapper binary (built
# from the prebuilt release) has to interoperate with nightly rustc.
check_doctor rustup run "$nightly" kache doctor --json

# End-to-end probe: fresh cargo project pinned to the nightly via
# rust-toolchain.toml (same mechanism as the user's projects), built once
# through the wrapper. A miss on first build is fine; failure is not.
probe=$(mktemp -d "${TMPDIR:-/tmp}/setup-kache-probe.XXXXXX")
trap 'rm -rf "$probe"' EXIT INT TERM
(
    cd "$probe"
    cargo init --bin --name kache_probe . >/dev/null 2>&1
    printf '[toolchain]\nchannel = "%s"\n' "$nightly" > rust-toolchain.toml
    quiet cargo build
    [ -x "target/debug/kache_probe" ] || die "probe build produced no binary"
    ./target/debug/kache_probe >/dev/null
)
rm -rf "$probe"
trap - EXIT INT TERM

# Show the effective kache-managed cargo config, then open the interactive
# editor when there is a terminal (kache config requires one).
grep -Eq '^[[:space:]]*(rustc-wrapper|rustdoc|HOST_CC|HOST_CXX|CC_KNOWN_WRAPPER_CUSTOM)[[:space:]]*=' \
    "${CARGO_HOME:-$HOME/.cargo}/config.toml" || die "managed keys missing from cargo config"
if [ -t 0 ]; then
    kache config
else
    log "skipping interactive 'kache config' (no terminal)"
fi

case ":$PATH:" in
    *":$HOME/.local/lib/kache/shims:"*) ;;
    *) log "optional: add shims to PATH for C/C++ caching:"; log "  export PATH=\"\$HOME/.local/lib/kache/shims:\$PATH\"" ;;
esac
log "done: $("$dest" --version) ($tag) ready, verified under $nightly"
