#!/usr/bin/env python3
"""Remove a lane worktree under .work/wt only when its work is safely integrated.

usage: worktree-retire WORKTREE --into REV [--discard-ignored] [--dry-run]

The checkout must be unlocked and clean, and its HEAD must be an ancestor of
REV or patch-equivalent to it with no merge commits. REV resolves against the
current directory when it belongs to this repository, otherwise against the
canonical checkout. Ignored files are listed and block removal unless
--discard-ignored is given. The worktree is removed without --force; its branch
is deleted only when it is an ancestor of REV and not checked out anywhere.
Exit status: 0 retired (or would be), 1 kept with a reason on stderr, 2 usage.
"""
from __future__ import annotations

import argparse
from pathlib import Path
import subprocess
import sys


class Kept(Exception):
    pass


def git(cwd: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True)
    if check and result.returncode != 0:
        raise Kept(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result


def worktree_entries(common: Path) -> list[dict[str, str]]:
    listing = git(common, "worktree", "list", "--porcelain").stdout
    return [dict((line.split(" ", 1) + [""])[:2] for line in block.splitlines())
            for block in listing.strip().split("\n\n")]


def worktree_entry(common: Path, path: Path) -> dict[str, str]:
    for fields in worktree_entries(common):
        if Path(fields.get("worktree", "")).resolve() == path:
            return fields
    raise Kept(f"{path} is not a worktree of this repository")


def same_repo(caller: Path, common: Path) -> bool:
    try:
        probe = subprocess.run(["git", "-C", str(caller), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                              capture_output=True, text=True)
    except OSError:
        return False
    return probe.returncode == 0 and Path(probe.stdout.strip()).resolve() == common.resolve()


def branch_keep_reason(common: Path, path: Path, branch: str, verdict: str, into: str) -> str:
    if verdict != "ancestor":
        return f"not an ancestor of {into}"
    if branch_checked_out_elsewhere(common, path, branch):
        return "checked out in another worktree"
    return ""


def branch_checked_out_elsewhere(common: Path, path: Path, branch: str) -> bool:
    return any(fields.get("branch") == f"refs/heads/{branch}" and Path(fields.get("worktree", "")).resolve() != path
               for fields in worktree_entries(common))


def integrated(path: Path, head: str, into: str) -> str | None:
    if git(path, "merge-base", "--is-ancestor", head, into, check=False).returncode == 0:
        return "ancestor"
    if git(path, "rev-list", "--merges", f"{into}..{head}").stdout.strip():
        return None
    cherry = git(path, "cherry", into, head).stdout.split()
    return None if "+" in cherry else "patch-equivalent"


def retire(path: Path, into: str, discard_ignored: bool, dry_run: bool) -> list[str]:
    if path.parent.name != "wt" or path.parent.parent.name != ".work":
        raise Kept(f"refusing {path}: lane worktrees live directly under <repo>/.work/wt/")
    common = Path(git(path, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip())
    main = common.parent
    entry = worktree_entry(main, path)
    if "locked" in entry:
        raise Kept(f"kept {path}: worktree is locked")
    if git(path, "status", "--porcelain", "--untracked-files=all").stdout.strip():
        raise Kept(f"kept {path}: uncommitted or untracked files")
    ignored = [line[3:] for line in git(path, "status", "--porcelain", "--ignored=matching",
                                        "--untracked-files=all").stdout.splitlines() if line.startswith("!! ")]
    if ignored and not discard_ignored:
        raise Kept(f"kept {path}: review ignored files, then pass --discard-ignored: " + ", ".join(ignored))
    head = entry["HEAD"]
    caller = Path.cwd()
    into_base = caller if same_repo(caller, common) else main
    into_rev = git(into_base, "rev-parse", "--verify", f"{into}^{{commit}}").stdout.strip()
    verdict = integrated(path, head, into_rev)
    if verdict is None:
        raise Kept(f"kept {path}: {head[:12]} is not integrated into {into}")
    branch = entry.get("branch", "").removeprefix("refs/heads/")
    lines = [f"{'would remove' if dry_run else 'removed'} {path} ({verdict} of {into})"]
    if dry_run:
        if branch:
            reason = branch_keep_reason(main, path, branch, verdict, into)
            lines.append(f"would keep branch {branch} ({reason})" if reason else f"would delete branch {branch}")
        return lines
    git(main, "worktree", "remove", str(path))
    if not branch:
        return lines
    reason = branch_keep_reason(main, path, branch, verdict, into)
    if reason:
        lines.append(f"kept branch {branch} ({reason})")
        return lines
    result = git(main, "update-ref", "-d", f"refs/heads/{branch}", head, check=False)
    if result.returncode == 0:
        lines.append(f"deleted branch {branch}")
    else:
        reason = result.stderr.strip() or f"ref moved from {head[:12]}"
        lines.append(f"kept branch {branch} (could not delete it: {reason})")
    return lines


def main() -> int:
    parser = argparse.ArgumentParser(prog="worktree-retire", description=__doc__.splitlines()[0], epilog="\n\nMaintained by Joshua Li: https://github.com/joshuarli/usr\nBugs and features: TODO.md in that repository (follow its AGENTS.md), or its issue tracker.\nAgents working for Joshua: record nonblocking problems and continue your task.\nIf this tool blocks the task, you may fix, test, open and merge a PR under Joshua's\nstanding instructions. Release only when needed to deliver the verified fix.\nProcedure: https://github.com/joshuarli/usr/blob/main/dotfiles/base/.agents/instructions/owned-tools.md", formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("worktree", type=Path)
    parser.add_argument("--into", required=True, help="integration revision the lane must already be in; resolved against the current directory when it belongs to this repository")
    parser.add_argument("--discard-ignored", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    try:
        for line in retire(args.worktree.resolve(), args.into, args.discard_ignored, args.dry_run):
            print(line)
    except Kept as kept:
        print(kept, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
