#!/usr/bin/env python3
"""Remove a lane worktree under .work/wt only when its work is safely integrated.

usage: worktree-retire WORKTREE --into REV [--discard-ignored] [--dry-run]

The caller must establish that the lane is finished and quiescent. The checkout
must be unlocked, clean and free of a bridge lease. Its HEAD must be an ancestor
of REV, or REV must contain the exact net changes of a lane with no unique merge
commits. REV resolves against the current directory when it belongs to this
repository, otherwise against the primary checkout. Ignored files are listed
and block removal unless --discard-ignored is given. A branch is deleted only
when its history is in the integration revision, a surviving ref retains that
revision, and the branch is no longer checked out.
Exit status: 0 retired (or would be), 1 kept with a reason on stderr, 2 usage.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys


class Kept(Exception):
    pass


def git(cwd: Path, *args: str, check: bool = True, stdin: str | None = None) -> subprocess.CompletedProcess[str]:
    raw = subprocess.run(["git", "--no-replace-objects", "-C", str(cwd), *args],
                         capture_output=True, input=os.fsencode(stdin) if stdin is not None else None,
                         env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
    result = subprocess.CompletedProcess(raw.args, raw.returncode, os.fsdecode(raw.stdout), os.fsdecode(raw.stderr))
    if check and result.returncode != 0:
        raise Kept(f"git {' '.join(args)} failed: {result.stderr.strip()}")
    return result


def worktree_entries(cwd: Path) -> list[dict[str, str]]:
    listing = git(cwd, "worktree", "list", "--porcelain", "-z").stdout
    return [dict(field.partition(" ")[::2] for field in block.split("\0"))
            for block in listing.split("\0\0") if block]


def registered_lane(path: Path, caller: Path) -> tuple[Path, dict[str, str]]:
    if caller.is_relative_to(path):
        raise Kept(f"refusing {path}: current directory is inside the worktree")
    entries = worktree_entries(path)
    if not entries or "bare" in entries[0]:
        raise Kept(f"refusing {path}: repository has no primary checkout")
    primary = Path(entries[0]["worktree"]).resolve()
    if path == primary:
        raise Kept(f"refusing {path}: primary checkout")
    common = Path(git(path, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.removesuffix("\n"))
    if common.resolve() != primary / ".git":
        raise Kept(f"refusing {path}: Git common directory is outside the primary checkout's .git")
    if path.parent != primary / ".work/wt":
        raise Kept(f"refusing {path}: lane worktrees live directly under {primary}/.work/wt/")
    top = git(path, "rev-parse", "--show-toplevel").stdout.removesuffix("\n")
    if Path(top) != path:
        raise Kept(f"refusing {path}: expected the Git worktree root")
    for entry in entries[1:]:
        if entry["worktree"] == str(path) and "prunable" not in entry and "HEAD" in entry:
            return primary, entry
    raise Kept(f"refusing {path}: expected a registered lane worktree root")


def check_bridge_lease(primary: Path, path: Path) -> None:
    # Matches readStateDir in bridge git.ts and worktreeLeasePath in worktree-lease.ts.
    state = primary / ".work/worker-bridge"
    digest = hashlib.sha256(os.fsencode(path)).hexdigest()
    lease = state / f".active-worktree-{digest}"
    try:
        if not stat.S_ISDIR(state.lstat().st_mode):
            raise Kept(f"kept {path}: cannot verify bridge leases at {state}")
        lease.lstat()
    except FileNotFoundError:
        return
    session_id: str | None = None
    try:
        data = json.loads((lease / "owner.json").read_text())
        candidate = data.get("session_id") if isinstance(data, dict) else None
        if isinstance(candidate, str) and candidate.startswith("usrw_") and len(candidate) == 41:
            session_id = candidate
    except (OSError, ValueError, UnicodeDecodeError):
        session_id = None
    if session_id is None:
        raise Kept(f"kept {path}: active or unknown bridge lease at {lease}")
    bridge = shutil.which("pi-subagent-bridge")
    if bridge is None:
        raise Kept(f"kept {path}: active bridge lease at {lease} for session {session_id}; "
                    "bridge unavailable (pi-subagent-bridge not on PATH)")
    try:
        proc = subprocess.run([bridge, "inspect", str(primary), session_id],
                              capture_output=True, text=True, timeout=30,
                              env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"})
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Kept(f"kept {path}: active bridge lease at {lease} for session {session_id}; "
                    f"bridge unavailable ({exc})")
    reported: str | None = None
    try:
        snapshot = json.loads(proc.stdout)
        if isinstance(snapshot, dict):
            value = snapshot.get("execution_state", snapshot.get("state"))
            if isinstance(value, str) and value:
                reported = value
    except ValueError:
        reported = None
    try:
        lease.lstat()
    except FileNotFoundError:
        return
    if proc.returncode != 0 and reported is None:
        detail = proc.stderr.strip() or f"exit {proc.returncode}"
        raise Kept(f"kept {path}: active bridge lease at {lease} for session {session_id}; "
                    f"bridge unavailable ({detail})")
    if reported:
        raise Kept(f"kept {path}: active bridge lease at {lease} for session {session_id} (state {reported})")
    raise Kept(f"kept {path}: active bridge lease at {lease} for session {session_id} (state unknown)")


def gitlinks(cwd: Path) -> list[tuple[str, str]]:
    out = git(cwd, "ls-files", "-s", "-z").stdout
    found: list[tuple[str, str]] = []
    for block in out.split("\0"):
        if not block:
            continue
        try:
            meta, rel = block.split("\t", 1)
            mode, oid, _stage = meta.split(" ", 2)
        except ValueError:
            continue
        if mode == "160000":
            found.append((oid, rel))
    return found


def submodule_gitdirs(sub: Path) -> tuple[Path, Path] | None:
    probe = git(sub, "rev-parse", "--path-format=absolute",
                "--git-dir", "--git-common-dir", check=False)
    if probe.returncode != 0:
        return None
    lines = probe.stdout.splitlines()
    if len(lines) != 2 or not lines[0] or not lines[1]:
        return None
    return Path(lines[0]), Path(lines[1])


def submodule_survives(common: Path, head: str) -> bool:
    refs = git(common, "for-each-ref", f"--contains={head}",
               "--format=%(refname)", "refs/heads", "refs/tags", "refs/remotes", check=False)
    if refs.returncode != 0:
        raise Kept(f"could not verify submodule refs: {refs.stderr.strip()}")
    return bool(refs.stdout.strip())


def collect_submodule_worktrees(path: Path, primary: Path, discard_ignored: bool) -> list[tuple[Path, Path]]:
    collected: list[tuple[Path, Path]] = []
    for _oid, rel in gitlinks(path):
        sub = path / rel
        dirs = submodule_gitdirs(sub)
        if dirs is None:
            continue
        gitdir, common = dirs
        try:
            same = gitdir.resolve() == common.resolve()
        except OSError:
            raise Kept(f"kept {path}: submodule {rel} repository cannot be verified")
        if same:
            raise Kept(f"kept {path}: submodule {rel} has its own standalone repository at {gitdir}; "
                        "removing the lane could destroy that repository")
        try:
            has_modules = (gitdir / "modules").is_dir()
        except OSError:
            has_modules = False
        if has_modules:
            raise Kept(f"kept {path}: submodule {rel} contains nested modules at {gitdir / 'modules'}; "
                        "removing the lane could destroy that repository")
        try:
            sub_resolved = sub.resolve()
        except OSError:
            raise Kept(f"kept {path}: submodule {rel} path cannot be resolved")
        entries = worktree_entries(common)
        match: dict[str, str] | None = None
        for entry in entries:
            try:
                if "prunable" in entry or "HEAD" not in entry:
                    continue
                if Path(entry["worktree"]).resolve() == sub_resolved:
                    match = entry
                    break
            except OSError:
                continue
        if match is None:
            raise Kept(f"kept {path}: submodule {rel} worktree at {sub} is not a registered linked worktree")
        if "locked" in match:
            raise Kept(f"kept {path}: submodule {rel} worktree is locked")
        if git(sub, "status", "--porcelain", "--untracked-files=all").stdout.strip():
            raise Kept(f"kept {path}: submodule {rel} has uncommitted or untracked files")
        ignored = [line[3:] for line in git(sub, "status", "--porcelain", "--ignored=matching",
                                            "--untracked-files=all").stdout.splitlines() if line.startswith("!! ")]
        if ignored and not discard_ignored:
            raise Kept(f"kept {path}: submodule {rel} has ignored files, pass --discard-ignored: " + ", ".join(ignored))
        for _nested_oid, nested_rel in gitlinks(sub):
            if submodule_gitdirs(sub / nested_rel) is not None:
                raise Kept(f"kept {path}: submodule {rel} contains nested submodule {nested_rel}; refusing")
        head = match["HEAD"]
        branch = match.get("branch", "")
        if not branch and not submodule_survives(common, head):
            raise Kept(f"kept {path}: submodule {rel} detached HEAD {head[:12]} has no surviving branch, tag or remote-tracking ref")
        collected.append((sub_resolved, common))
    return collected


def is_ancestor(cwd: Path, before: str, after: str) -> bool:
    result = git(cwd, "merge-base", "--is-ancestor", before, after, check=False)
    if result.returncode not in (0, 1):
        raise Kept(f"could not verify commit ancestry: {result.stderr.strip()}")
    return result.returncode == 0


def surviving_ref(primary: Path, revision: str, branch: str) -> tuple[str, str] | None:
    refs = git(primary, "for-each-ref", f"--contains={revision}",
               "--format=%(refname) %(objectname) %(symref)", "refs/heads", "refs/tags", "refs/remotes")
    for line in refs.stdout.split("\n")[:-1]:
        name, oid, symref = line.split(" ", 2)
        if name != branch and not symref:
            return name, oid
    return None


def survives_removal(primary: Path, path: Path, revision: str, branch: str) -> bool:
    if surviving_ref(primary, revision, branch):
        return True
    return any(entry["worktree"] != str(path) and "prunable" not in entry and "HEAD" in entry
               and "detached" in entry and Path(entry["worktree"]).is_dir()
               and is_ancestor(primary, revision, entry["HEAD"]) for entry in worktree_entries(primary))


def tree_changes(cwd: Path, base: str, revision: str) -> dict[str, str]:
    diff = git(cwd, "diff-tree", "-r", "--raw", "--no-abbrev", "--no-renames", "--no-commit-id",
               "--ignore-submodules=none", "-z", base, revision, "--").stdout
    fields = iter(diff.split("\0")[:-1])
    return {path: change for change, path in zip(fields, fields, strict=True)}


def integrated(path: Path, head: str, into: str) -> str | None:
    if is_ancestor(path, head, into):
        return "ancestor"
    if git(path, "rev-list", "--merges", f"{into}..{head}").stdout.strip():
        return None
    bases = git(path, "merge-base", "--all", head, into, check=False)
    if bases.returncode == 1:
        return None
    if bases.returncode:
        raise Kept(f"could not find a shared base: {bases.stderr.strip()}")
    if len(bases.stdout.splitlines()) != 1:
        return None
    base = bases.stdout.strip()
    lane_changes = tree_changes(path, base, head)
    dest_changes = tree_changes(path, base, into)
    if lane_changes and all(dest_changes.get(name) == change for name, change in lane_changes.items()):
        return "patch-equivalent"
    return None


def delete_branch(primary: Path, path: Path, branch: str, head: str, into: str, dry_run: bool) -> str:
    name = branch.removeprefix("refs/heads/")
    kept = "would keep" if dry_run else "kept"
    if any(entry.get("branch") == branch and entry["worktree"] != str(path) for entry in worktree_entries(primary)):
        return f"{kept} branch {name} (checked out in another worktree)"
    proof = surviving_ref(primary, into, branch)
    if not proof:
        return f"{kept} branch {name} (no surviving integration ref)"
    if dry_run:
        return f"would delete branch {name}"
    ref, oid = proof
    result = git(primary, "update-ref", "--stdin", check=False,
                 stdin=f"option no-deref\nverify {ref} {oid}\noption no-deref\ndelete {branch} {head}\n")
    if result.returncode:
        return f"kept branch {name} (could not delete it: {result.stderr.strip()})"
    return f"deleted branch {name}"


def retire(request: Path, into: str | None, discard_ignored: bool = False, dry_run: bool = False) -> list[str]:
    path = request.resolve(strict=True)
    if Path(os.path.abspath(request)) != path:
        raise Kept(f"refusing {request}: use the canonical lane worktree path {path}")
    caller = Path.cwd()
    primary, entry = registered_lane(path, caller)
    if "locked" in entry:
        raise Kept(f"kept {path}: worktree is locked")
    submodules = collect_submodule_worktrees(path, primary, discard_ignored)
    if git(path, "status", "--porcelain", "--untracked-files=all").stdout.strip():
        raise Kept(f"kept {path}: uncommitted or untracked files")
    ignored = [line[3:] for line in git(path, "status", "--porcelain", "--ignored=matching",
                                        "--untracked-files=all").stdout.splitlines() if line.startswith("!! ")]
    if ignored and not discard_ignored:
        raise Kept(f"kept {path}: review ignored files, then pass --discard-ignored: " + ", ".join(ignored))
    head = entry["HEAD"]
    branch = entry.get("branch", "")
    # Two detached checkouts must not each rely on the other while both retire.
    if not branch and not surviving_ref(primary, head, branch):
        raise Kept(f"kept {path}: detached HEAD {head[:12]} has no surviving branch, tag or remote-tracking ref")
    if into is None:
        # Claude may discard a clean attached checkout while its branch retains the work.
        into_rev = ""
        if branch.startswith("refs/heads/worktree-"):
            name = branch.removeprefix("refs/heads/")
            upstream = git(primary, "rev-parse", "--verify", f"{name}@{{upstream}}^{{commit}}", check=False)
            into_rev = upstream.stdout.strip()
            if not into_rev:
                into_rev = git(primary, "rev-parse", "--verify", "HEAD^{commit}", check=False).stdout.strip()
        verdict = "ancestor" if into_rev and is_ancestor(primary, head, into_rev) else None
        detail = ""
    else:
        common = git(caller, "rev-parse", "--path-format=absolute", "--git-common-dir", check=False)
        into_base = primary
        if common.returncode == 0 and Path(common.stdout.removesuffix("\n")).resolve() == primary / ".git":
            into_base = caller
        into_ref = git(into_base, "rev-parse", "--symbolic-full-name", "--verify", "--end-of-options", into, check=False)
        if branch and into_ref.returncode == 0 and into_ref.stdout.strip() == branch:
            raise Kept(f"refusing {path}: {into} names the worktree's own branch")
        into_rev = git(into_base, "rev-parse", "--verify", "--end-of-options", f"{into}^{{commit}}").stdout.strip()
        verdict = integrated(path, head, into_rev)
        if verdict is None:
            raise Kept(f"kept {path}: {head[:12]} is not integrated into {into}")
        if not survives_removal(primary, path, into_rev, branch):
            raise Kept(f"kept {path}: integration revision {into} has no surviving ref or checkout")
        detail = f" ({verdict} of {into})"
    check_bridge_lease(primary, path)
    if dry_run:
        lines = [f"would remove {sub} (submodule worktree)" for sub, _common in submodules]
        lines.append(f"would remove {path}{detail}")
    else:
        for sub, common in submodules:
            git(common, "worktree", "remove", str(sub))
            # An empty directory is an unpopulated gitlink, which keeps the parent clean for git worktree remove.
            sub.mkdir()
        git(primary, "worktree", "remove", str(path))
        lines = [f"removed {sub} (submodule worktree)" for sub, _common in submodules]
        lines.append(f"removed {path}{detail}")
    if branch and (into is not None or branch.startswith("refs/heads/worktree-")):
        name = branch.removeprefix("refs/heads/")
        if verdict == "ancestor":
            lines.append(delete_branch(primary, path, branch, head, into_rev, dry_run))
        elif into is not None:
            lines.append(f"{'would keep' if dry_run else 'kept'} branch {name} (not an ancestor of {into})")
        else:
            lines.append(f"kept unmerged branch {name}")
    return lines


def hook_worktree() -> Path:
    payload = json.load(sys.stdin)
    path = payload.get("worktree_path") if isinstance(payload, dict) else None
    if not isinstance(path, str) or not Path(path).is_absolute() or "\0" in path:
        raise Kept("worktree-remove: expected an absolute worktree_path in the hook payload")
    return Path(path)


def main() -> int:
    try:
        if sys.argv[1:] == ["--from-hook"]:
            lines = retire(hook_worktree(), None)
        else:
            parser = argparse.ArgumentParser(prog="worktree-retire", description=__doc__.splitlines()[0], epilog="\n".join(__doc__.splitlines()[4:]) + "\n\nExamples:\n  worktree-retire .work/wt/lane --into main --dry-run\n\nMaintained by Joshua Li: https://github.com/joshuarli/usr\nBugs and features: TODO.md in that repository (follow its AGENTS.md), or its issue tracker.\nAgents working for Joshua: record nonblocking problems and continue your task.\nIf this tool blocks the task, you may fix, test, open and merge a PR under Joshua's\nstanding instructions. Release only when needed to deliver the verified fix.\nProcedure: https://github.com/joshuarli/usr/blob/main/dotfiles/base/.agents/instructions/owned-tools.md", formatter_class=argparse.RawDescriptionHelpFormatter)
            parser.add_argument("worktree", type=Path, help="lane worktree under .work/wt to retire")
            parser.add_argument("--into", required=True, help="integration revision resolved against the current directory when it belongs to this repository")
            parser.add_argument("--discard-ignored", action="store_true", help="allow removal of ignored files")
            parser.add_argument("--dry-run", action="store_true", help="report what would happen without removing anything")
            if len(sys.argv) == 1:
                parser.print_help()
                return 0
            args = parser.parse_args()
            lines = retire(args.worktree, args.into, args.discard_ignored, args.dry_run)
        for line in lines:
            print(line)
    except (Kept, OSError, ValueError) as kept:
        print(kept, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
