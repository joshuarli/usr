#!/bin/sh
"$HOME/.local/bin/harness-enabled" codex || exit $?
# Keep local sessions off the daemon; an explicit remote target stays remote.
for arg do
	case $arg in
	--) break ;;
	--no-daemon|--remote|--remote=*) exec "$HOME/.local/bin/codex" "$@" ;;
	esac
done
exec "$HOME/.local/bin/codex" --no-daemon "$@"
