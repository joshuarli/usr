#!/bin/sh
pane=$(printf '%s' "${TMUX_PANE:-local}" | tr -cd '[:alnum:]')
[ -n "$pane" ] || pane=local
stamp="${TMPDIR:-/tmp}/notify-sound-$pane"
now=$(date +%s 2>/dev/null || printf '0')
if [ -f "$stamp" ]; then
    prev=$(cat "$stamp" 2>/dev/null || printf '0')
    case $prev in *[!0-9]*) prev=0 ;; esac
    if [ "$((now - prev))" -lt 2 ]; then
        exit 0
    fi
fi
printf '%s\n' "$now" >"$stamp" 2>/dev/null || true
if printf '\a' >/dev/tty 2>/dev/null; then
    exit 0
fi
exec /usr/bin/afplay /System/Library/Sounds/Glass.aiff
