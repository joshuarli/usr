#!/bin/sh

if [ "${1:-}" = -h ] || [ "${1:-}" = --help ]; then
    cat <<'HELP'
Usage: safari-cloud-tabs
List URLs from Safari iCloud tabs.
  -h, --help  Show this help.
Environment:
  HOME  Home directory containing Safari's CloudTabs database.
Examples:
  safari-cloud-tabs -h
HELP
    exit 0
fi

sqlite3 "$HOME/Library/Containers/com.apple.Safari/Data/Library/Safari/CloudTabs.db" \
'SELECT c.url FROM cloud_tabs c LEFT JOIN cloud_tab_devices d ON c.device_uuid = d.device_uuid WHERE c.url LIKE "http%" GROUP BY c.url ORDER BY d.device_name, c.position DESC;'
