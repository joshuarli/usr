#!/bin/sh
# One-shot Linux CPU power policy: sysfs only, no daemon or dependencies.
set -eu

name=power-policy
die() { printf '%s: %s\n' "$name" "$*" >&2; exit 1; }
usage() {
    cat <<'HELP'
usage: power-policy [status | diff [auto|ac|battery|performance] |
                     apply [auto|ac|battery|performance] |
                     auto | ac | battery | performance]

status       Show current power source and CPU policy settings (default).
diff MODE    Preview changes without writing (default MODE: auto).
apply MODE   Apply a policy as root (default MODE: auto).
auto         Detect AC/battery, or use kernel-managed AMD dynamic EPP.
ac           Balance performance and energy use.
battery      Prefer energy savings when the hardware supports a hint.
performance  Prefer performance; enable CPU boost when supported.

No CPU frequency caps, voltage changes, or blanket USB/PCIe/storage tuning.
HELP
}

sys=${POWER_POLICY_SYSFS_ROOT:-/sys}
case $sys in /*) ;; *) die 'POWER_POLICY_SYSFS_ROOT must be absolute' ;; esac
[ "$sys" != / ] || die 'refusing to use / as sysfs root'
sys=${sys%/}

mode=${1:-status}
[ "$#" -eq 0 ] || shift
case $mode in
    status) action=status; [ "$#" -eq 0 ] || die 'status takes no arguments' ;;
    diff|apply)
        action=$mode
        mode=${1:-auto}
        [ "$#" -eq 0 ] || shift
        [ "$#" -eq 0 ] || die 'too many arguments'
        ;;
    ac|battery|auto|performance)
        action=apply
        [ "$#" -eq 0 ] || die 'too many arguments'
        ;;
    -h|--help|help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
case $mode in status|ac|battery|auto|performance) ;; *) die 'unknown policy' ;; esac

if [ "$action" = apply ] && [ "$sys" = /sys ] && [ "$(id -u)" -ne 0 ]; then
    die 'applying policy requires root (use doas)'
fi

read_value() {
    [ -r "$1" ] || return 1
    IFS= read -r value < "$1" || [ -n "${value:-}" ] || return 1
    printf '%s\n' "$value"
}

# Do not mistake a peripheral battery (mouse/headset) for the system battery.
# AC-only desktops, including Intel N100 and Ryzen 2400GE systems, select AC.
power_source() {
    has_battery=no
    on_ac=no
    charging=no
    for supply in "$sys"/class/power_supply/*; do
        [ -d "$supply" ] || continue
        scope=$(read_value "$supply/scope" 2>/dev/null || :)
        [ "$scope" != Device ] || continue
        kind=$(read_value "$supply/type" 2>/dev/null || :)
        case $kind in
            Mains|USB*|Wireless)
                [ "$(read_value "$supply/online" 2>/dev/null || :)" != 1 ] || on_ac=yes
                ;;
            Battery)
                [ "$(read_value "$supply/present" 2>/dev/null || echo 1)" != 0 ] || continue
                has_battery=yes
                case $(read_value "$supply/status" 2>/dev/null || :) in
                    Charging|Full|'Not charging') charging=yes ;;
                esac
                ;;
        esac
    done
    if [ "$on_ac" = yes ] || [ "$charging" = yes ] || [ "$has_battery" = no ]; then
        printf 'ac\n'
    else
        printf 'battery\n'
    fi
}

# Token matching, not substring matching. Kernel lists are whitespace-separated.
supports() {
    [ -r "$1" ] || return 1
    available=$(read_value "$1" 2>/dev/null || :)
    for supported_item in $available; do
        [ "$supported_item" != "$2" ] || return 0
    done
    return 1
}

show_setting() {
    [ -r "$1" ] || return 0
    current=$(read_value "$1" 2>/dev/null || :)
    printf '  %s=%s\n' "$2" "$current"
}

if [ "$action" = status ]; then
    printf 'source=%s\n' "$(power_source)"
    found=no
    for policy in "$sys"/devices/system/cpu/cpufreq/policy*; do
        [ -d "$policy" ] || continue
        found=yes
        printf '%s:\n' "${policy##*/}"
        show_setting "$policy/scaling_driver" driver
        show_setting "$policy/scaling_governor" governor
        show_setting "$policy/energy_performance_preference" epp
    done
    [ "$found" = yes ] || printf 'cpufreq=unavailable\n'
    show_setting "$sys/devices/system/cpu/cpufreq/boost" boost
    show_setting "$sys/devices/system/cpu/intel_pstate/no_turbo" intel_no_turbo
    for cpu in "$sys"/devices/system/cpu/cpu[0-9]*; do
        [ -r "$cpu/power/energy_perf_bias" ] || continue
        printf '%s:\n' "${cpu##*/}"
        show_setting "$cpu/power/energy_perf_bias" epb
    done
    exit 0
fi

requested=$mode
[ "$mode" != auto ] || mode=$(power_source)
printf 'policy=%s\n' "$requested"
[ "$requested" != auto ] || printf 'source=%s\n' "$mode"
failed=no
controls=no

set_value() {
    path=$1
    target=$2
    [ -r "$path" ] || return 0
    controls=yes
    current=$(read_value "$path") || { printf 'unreadable: %s\n' "$path" >&2; failed=yes; return 0; }
    [ "$current" != "$target" ] || return 0
    if [ "$action" = diff ]; then
        printf '%s: %s -> %s\n' "${path#"$sys"/}" "$current" "$target"
        return 0
    fi
    if [ ! -w "$path" ] || ! printf '%s\n' "$target" > "$path"; then
        printf 'failed to write %s\n' "$path" >&2
        failed=yes
        return 0
    fi
    actual=$(read_value "$path" 2>/dev/null || :)
    if [ "$actual" != "$target" ]; then
        printf 'write not retained by %s (wanted %s, got %s)\n' "$path" "$target" "$actual" >&2
        failed=yes
        return 0
    fi
    printf '%s: %s -> %s\n' "${path#"$sys"/}" "$current" "$target"
}

has_epp=no
for policy in "$sys"/devices/system/cpu/cpufreq/policy*; do
    [ -d "$policy" ] || continue
    driver=$(read_value "$policy/scaling_driver" 2>/dev/null || :)
    governor=$policy/scaling_governor
    choices=$policy/scaling_available_governors
    epp=$policy/energy_performance_preference
    preferences=$policy/energy_performance_available_preferences

    case $driver in
        intel_pstate|amd-pstate-epp)
            if [ -r "$epp" ] && [ -r "$preferences" ]; then
                has_epp=yes
                # Older AMD kernels expose a global dynamic_epp toggle. When
                # enabled, the kernel already owns EPP and rejects manual hints.
                if [ "$driver" = amd-pstate-epp ]; then
                    legacy_dynamic=$(read_value "$sys/devices/system/cpu/amd_pstate/dynamic_epp" 2>/dev/null || :)
                    case $legacy_dynamic in
                        1|enabled)
                            if [ "$requested" != auto ]; then
                                printf 'AMD dynamic_epp owns EPP; select auto or disable it first\n' >&2
                                failed=yes
                            else
                                controls=yes
                            fi
                            continue
                            ;;
                    esac
                fi
                # With hardware-managed P-states, powersave leaves frequency
                # selection dynamic and permits non-performance EPP values.
                if supports "$choices" powersave; then
                    set_value "$governor" powersave
                fi
                target=
                if [ "$requested" = auto ] && [ "$driver" = amd-pstate-epp ] && supports "$preferences" dynamic; then
                    target=dynamic
                else
                    case $mode in
                        ac) candidates='balance_performance balance_power' ;;
                        battery) candidates='balance_power power' ;;
                        performance) candidates=performance ;;
                    esac
                    for candidate in $candidates; do
                        if supports "$preferences" "$candidate"; then
                            target=$candidate
                            break
                        fi
                    done
                fi
                [ -z "$target" ] || set_value "$epp" "$target"
            else
                # Intel without HWP: its *own* powersave governor is dynamic.
                # AMD/Intel active drivers without EPP still support perf.
                if [ "$mode" = performance ]; then target=performance; else target=powersave; fi
                if supports "$choices" "$target"; then
                    set_value "$governor" "$target"
                fi
            fi
            ;;
        acpi-cpufreq|amd-pstate|intel_cpufreq)
            # Older Ryzen (e.g. 2400GE) uses acpi-cpufreq, not EPP.
            # On generic CPUFreq, 'powersave' pins minimum frequency: NEVER
            # use that as a battery policy. schedutil/ondemand stay adaptive.
            if [ "$mode" = performance ]; then
                candidates=performance
            else
                candidates='schedutil ondemand'
            fi
            for candidate in $candidates; do
                if supports "$choices" "$candidate"; then
                    set_value "$governor" "$candidate"
                    break
                fi
            done
            # Passive drivers may also advertise HWP EPP. Honor it.
            if [ -r "$epp" ] && [ -r "$preferences" ]; then
                has_epp=yes
                case $mode in
                    ac) candidates='balance_performance balance_power' ;;
                    battery) candidates='balance_power power' ;;
                    performance) candidates=performance ;;
                esac
                for candidate in $candidates; do
                    if supports "$preferences" "$candidate"; then
                        set_value "$epp" "$candidate"
                        break
                    fi
                done
            fi
            ;;
        *) ;; # Unsupported drivers are untouched.
    esac
done

# Older Intel exposes Energy Performance Bias (EPB) without HWP/EPP.
if [ "$has_epp" = no ]; then
    case $mode in ac) epb=6 ;; battery) epb=12 ;; performance) epb=0 ;; esac
    for cpu in "$sys"/devices/system/cpu/cpu[0-9]*; do
        [ -r "$cpu/power/energy_perf_bias" ] || continue
        set_value "$cpu/power/energy_perf_bias" "$epb"
    done
fi

# Retain the old Threadripper tuner's boost behavior. Balanced modes never
# disable turbo. Intel's no_turbo is inverse: zero means enabled.
if [ "$mode" = performance ]; then
    boost=$sys/devices/system/cpu/cpufreq/boost
    [ ! -r "$boost" ] || set_value "$boost" 1
    turbo=$sys/devices/system/cpu/intel_pstate/no_turbo
    [ ! -r "$turbo" ] || set_value "$turbo" 0
fi

[ "$controls" = yes ] || { printf 'no supported CPU energy controls found\n' >&2; exit 1; }
[ "$failed" = no ] || exit 1
