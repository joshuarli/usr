#!/bin/sh
die()   { printf '%s\n' "$*" >&2; exit 1; }
usage() { printf 'usage: sym [-t TARGET] [-d] [--dry-run] [-v] SOURCE\n' >&2; exit 1; }
log()   { if "$verbose"; then printf '%s\n' "$1"; fi; }
conflict() { printf 'CONFLICT: %s\n' "$1" >> "$tmp/conflicts"; }
record_owned() {
    [ -n "${SYM_OWNED_FILE:-}" ] || return 0
    if [ ! -f "$SYM_OWNED_FILE" ] \
        || ! awk -F '\t' -v kind="$1" -v path="$2" \
            '$1 == kind && $2 == path { found = 1 } END { exit !found }' "$SYM_OWNED_FILE"; then
        printf '%s\t%s\n' "$1" "$2" >> "$SYM_OWNED_FILE"
    fi
}
record_missing_target_dirs() {
    record_dir=$1
    while [ "$record_dir" != "$tgt_phys" ] && [ ! -d "$record_dir" ]; do
        record_owned E "$record_dir" || return 1
        record_dir=${record_dir%/*}
    done
}

relpath() {
    _d="$1" _b="$2" _up=''
    while [ "$_b" != / ]; do
        case $_d in "$_b"/* | "$_b") break ;; esac
        _up="../$_up"
        _b="${_b%/*}"; [ -z "$_b" ] && _b=/
    done
    if [ "$_b" = / ]; then _r="${_d#/}"; else _r="${_d#"$_b"/}"; fi
    [ -n "$_r" ] && printf '%s%s' "$_up" "$_r" || printf '%s' "${_up%/}"
}

target_path() {
    if [ "$1" = / ]; then _target_path="/$2"; else _target_path="$1/$2"; fi
}

planned_directory() {
    _link_text=$1 _target_dir=$2
    while IFS= read -r _sd; do
        if [ "$_sd" = "$src" ]; then
            _sd_target=$tgt_phys
        else
            target_path "$tgt_phys" "${_sd#"$src"/}"
            _sd_target=$_target_path
        fi
        [ "$(relpath "$_sd_target" "$_target_dir")" = "$_link_text" ] && return 0
    done < "$tmp/top-dirs"
    return 1
}

physical_parent() {
    _p="${1%/*}"
    [ -n "$_p" ] || _p=/
    while [ ! -d "$_p" ]; do
        _p="${_p%/*}"
        [ -n "$_p" ] || _p=/
    done
    (cd "$_p" && pwd -P)
}

confined_parent() {
    if [ "$tgt_phys" = / ]; then
        case "$1/" in /*) ;; *) return 1 ;; esac
    else
        case "$1/" in "$tgt_phys"/*) ;; *) return 1 ;; esac
    fi
    case "$1/" in "$src_phys"/*) return 1 ;; esac
    return 0
}

confined() {
    confined_parent "$(physical_parent "$1")"
}

lexical_path() (
    case $2 in /*) _lp=$2 ;; *) _lp=$1/$2 ;; esac
    _out=''
    IFS=/
    set -f
    for _seg in $_lp; do
        case $_seg in
            ''|.) ;;
            ..) _out=${_out%/*} ;;
            *) _out=$_out/$_seg ;;
        esac
    done
    printf '%s' "${_out:-/}"
)

source_relative_path() {
    if [ "$1" = "$src" ]; then
        source_rel=$src
    else
        case "$1" in
            "$src"/*) source_rel=${1#"$src"/} ;;
            *) return 1 ;;
        esac
    fi
    case "/$source_rel/" in
        *"/../"*|*"/./"*) return 1 ;;
    esac
    return 0
}

plan_entry() {
    _kind=$1 _source=$2
    case "$_source" in *"$tab"*)
        conflict "$_source contains a tab, which sym cannot record."
        return ;;
    esac
    if ! source_relative_path "$_source"; then
        conflict "$_source is not a safe source path."
        return
    fi
    target_path "$tgt" "$source_rel"
    name=$_target_path
    target_path "$tgt_phys" "$source_rel"
    name_abs=$_target_path
    source_abs="$src_phys/$source_rel"
    dir_abs="${name_abs%/*}"
    [ -n "$dir_abs" ] || dir_abs=/

    if [ "$_kind" = file ] && [ -L "$_source" ]; then
        dest="$(readlink "$_source")"
        case "$dest" in /*) dest="$(relpath "$dest" "$dir_abs")" ;; esac
    else
        dest="$(relpath "$source_abs" "$dir_abs")"
    fi

    if ! confined "$name"; then
        conflict "$name passes through a symlinked directory, so sym will not touch it."
        return
    fi

    if $delete; then
        { [ -e "$name" ] || [ -L "$name" ]; } || return 0
        if [ ! -L "$name" ]; then
            conflict "$name is not a symlink, so refusing to remove."
            return
        fi
        if ! [ "$name" -ef "$source_abs" ] && { [ "$_kind" = dir ] || [ "$(readlink "$name")" != "$dest" ]; }; then
            conflict "$name does not point to the expected destination, so refusing to remove."
            return
        fi
    elif $dry_run && [ -s "${SYM_PLANNED_PRUNES:-/dev/null}" ] && grep -Fxq -- "$name_abs" "$SYM_PLANNED_PRUNES" 2>/dev/null; then
        :
    elif [ -L "$name" ]; then
        [ "$name" -ef "$source_abs" ] && return 0
        if [ "$_kind" = file ] && [ "$(readlink "$name")" = "$dest" ]; then
            [ -e "$name" ] && return 0
            planned_directory "$dest" "$dir_abs" && return 0
        fi
        conflict "$name already exists. sym cannot create symlinks if there is an existing file."
        return
    elif [ -e "$name" ]; then
        conflict "$name already exists. sym cannot create symlinks if there is an existing file."
        return
    fi

    printf '%s\t%s\t%s\n' "$name" "$dest" "$name_abs" >> "$tmp/jobs"
}

tab="$(printf '\t')"
target="$HOME"; delete=false; dry_run=false; verbose=false; failed=false

while [ $# -gt 0 ]; do
    case "$1" in
        -t|--target)  [ $# -ge 2 ] || usage; shift; target="$1" ;;
        -d|--delete)  delete=true ;;
        --dry-run)    dry_run=true; verbose=true ;;
        -v|--verbose) verbose=true ;;
        --) shift; break ;;
        -*) usage ;;
        *)  break ;;
    esac
    shift
done

[ $# -eq 1 ] || usage

[ -d "$1" ]      || die "source directory $1 is not a directory or does not exist"
[ -d "$target" ] || die "target directory $target is not a directory or does not exist"

src="${1%/}"
tgt="${target%/}"
[ -n "$tgt" ] || tgt=/
src_phys="$(cd "$src" && pwd -P)"
tgt_phys="$(cd "$tgt" && pwd -P)"
case "$tgt$tgt_phys" in *"$tab"*) die "target directory $target contains a tab, which sym cannot record" ;; esac

tmp="${TMPDIR:-/tmp}/sym.$$"
mkdir "$tmp" || die 'failed to create temp directory'
trap 'rm -rf "$tmp"' 0
trap 'exit 130' 1 2 3 15

: > "$tmp/all-files"
: > "$tmp/symlink-dirs"
: > "$tmp/jobs"
: > "$tmp/prune"
: > "$tmp/stale"
if git -C "$src" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$src" -c core.quotePath=false ls-files --cached --others --exclude-standard -- . > "$tmp/file-relpaths"
    ! grep -q '^"' "$tmp/file-relpaths" || die "a file name in $src has a character git quotes; rename it"
    while IFS= read -r rel; do
        case "$rel" in
            '') ;;
            .sym-dir) printf '%s\n' "$src" >> "$tmp/symlink-dirs" ;;
            */.sym-dir) printf '%s/%s\n' "$src" "${rel%/.sym-dir}" >> "$tmp/symlink-dirs" ;;
            *) printf '%s/%s\n' "$src" "$rel" >> "$tmp/all-files" ;;
        esac
    done < "$tmp/file-relpaths"
else
    find "$src" -name '.sym-dir' -type f | sed 's|/\.sym-dir$||' > "$tmp/symlink-dirs"
    find "$src" \( -type f -o -type l \) ! -name '.sym-dir' > "$tmp/all-files"
fi

: > "$tmp/top-dirs"
: > "$tmp/nested-dirs"
LC_ALL=C sort "$tmp/symlink-dirs" > "$tmp/sorted-dirs" || die 'failed to sort .sym-dir directories'
TOP="$tmp/top-dirs" NESTED="$tmp/nested-dirs" awk '
    $0 == "" { next }
    { for (i = 1; i <= n; i++) if (index($0 "/", kept[i] "/") == 1) { print >> ENVIRON["NESTED"]; next } }
    { kept[++n] = $0; print >> ENVIRON["TOP"] }' "$tmp/sorted-dirs" \
    || die 'failed to classify .sym-dir directories'
TOP="$tmp/top-dirs" awk '
    BEGIN { while ((getline dir < ENVIRON["TOP"]) > 0) dirs[++n] = dir }
    { for (i = 1; i <= n; i++) if (index($0, dirs[i] "/") == 1) next; print }' \
    "$tmp/all-files" > "$tmp/files" || die 'failed to filter files under .sym-dir directories'

while IFS= read -r fp; do
    plan_entry file "$fp"
done < "$tmp/files"

while IFS= read -r sd; do
    log "SKIP (nested in another symlink-dir): $sd"
done < "$tmp/nested-dirs"
while IFS= read -r sd; do
    plan_entry dir "$sd"
done < "$tmp/top-dirs"

if ! $delete && [ -n "${SYM_OWNED_FILE:-}" ] && [ -f "$SYM_OWNED_FILE" ]; then
    while IFS="$tab" read -r kind owned; do
        [ "$kind" = F ] || continue
        case "$owned" in "$tgt_phys"/*) ;; *) continue ;; esac
        if [ ! -e "$owned" ] && [ ! -L "$owned" ]; then
            printf '%s\n' "$owned" >> "$tmp/stale"
            continue
        fi
        [ -L "$owned" ] || continue
        rel=${owned#"$tgt_phys"/}
        { [ -e "$src/$rel" ] || [ -L "$src/$rel" ]; } && continue
        confined "$owned" || continue
        linked="$(lexical_path "$(physical_parent "$owned")" "$(readlink "$owned")")"
        case "$linked/" in "$src_phys"/*) ;; *) continue ;; esac
        printf '%s\n' "$owned" >> "$tmp/prune"
    done < "$SYM_OWNED_FILE"
fi

if $dry_run && [ -n "${SYM_PLANNED_PRUNES:-}" ]; then
    cat "$tmp/prune" >> "$SYM_PLANNED_PRUNES" || die "failed to record planned prunes in $SYM_PLANNED_PRUNES"
fi

if [ -s "$tmp/conflicts" ]; then
    cat "$tmp/conflicts" >&2
    $dry_run || die "sym will not start until all conflicts are resolved."
fi

$dry_run && printf 'dry-run; the following operations are what would have been executed.\n'

: > "$tmp/pruned"
while IFS= read -r owned; do
    log "PRUNE: $owned"
    $dry_run && continue
    if rm "$owned"; then printf '%s\n' "$owned" >> "$tmp/pruned"; else failed=true; fi
done < "$tmp/prune"
cat "$tmp/stale" >> "$tmp/pruned" 2>/dev/null || :
if [ -s "$tmp/pruned" ]; then
    if ! awk -F '\t' 'NR == FNR { gone[$0] = 1; next } !($1 == "F" && ($2 in gone))' \
            "$tmp/pruned" "$SYM_OWNED_FILE" > "$SYM_OWNED_FILE.$$" \
        || ! mv "$SYM_OWNED_FILE.$$" "$SYM_OWNED_FILE"; then
        rm -f "$SYM_OWNED_FILE.$$"
        failed=true
    fi
fi

while IFS="$tab" read -r name dest name_abs; do
    dir="${name%/*}"
    [ -n "$dir" ] || dir=/
    if $delete; then
        log "UNLINK: $name"
        $dry_run && continue
        rm "$name" || failed=true
        while [ "$dir" != "$tgt" ] && [ -d "$dir" ] && [ -z "$(ls -A "$dir")" ]; do
            log "RMDIR: $dir"
            rmdir "$dir" || { failed=true; break; }
            dir="${dir%/*}"
        done
        continue
    fi
    if [ ! -d "$dir" ] && ! $dry_run; then
        if ! record_missing_target_dirs "${name_abs%/*}" || ! mkdir -p "$dir"; then
            failed=true
            continue
        fi
    fi
    log "LINK: $name -> $dest"
    $dry_run && continue
    if ln -s "$dest" "$name"; then
        record_owned F "$name_abs" || failed=true
    else
        failed=true
    fi
done < "$tmp/jobs"

if $failed; then die "sym: some operations failed."; fi
