#!/bin/sh
# sym - batch symlinker for dotfiles
#
# Mirrors the files of SOURCE into TARGET as relative symlinks. A directory
# holding a .sym-dir marker file is linked as a whole instead of file by file.
# Enumeration follows Git's ignore rules, so ignored files are never linked.
# Every conflict is reported before anything is written.

die()   { printf '%s\n' "$*" >&2; exit 1; }
usage() { printf 'usage: sym [-t TARGET] [-d] [--dry-run] [-v] SOURCE\n' >&2; exit 1; }
log()   { if "$verbose"; then printf '%s\n' "$1"; fi; }
record_owned() {
    [ -n "${SYM_OWNED_FILE:-}" ] || return 0
    if [ ! -f "$SYM_OWNED_FILE" ] \
        || ! awk -F '\t' -v kind="$1" -v path="$2" \
            '$1 == kind && $2 == path { found = 1 } END { exit !found }' "$SYM_OWNED_FILE"; then
        printf '%s\t%s\n' "$1" "$2" >> "$SYM_OWNED_FILE"
    fi
}
record_missing_target_dirs() {
    record_dir=$1
    while [ "$record_dir" != "$tgt_abs" ] && [ ! -d "$record_dir" ]; do
        record_owned E "$record_dir" || return 1
        record_dir=${record_dir%/*}
    done
}

# relpath DEST BASE
# Relative path from directory BASE to file DEST (both absolute, no trailing /).
relpath() {
    _d="$1" _b="$2" _up=''
    while [ "$_b" != / ]; do
        case $_d in "$_b"/* | "$_b") break ;; esac
        _up="../$_up"
        _b="${_b%/*}"; [ -z "$_b" ] && _b=/
    done
    if [ "$_b" = / ]; then _r="${_d#/}"; else _r="${_d#"$_b"/}"; fi
    [ -n "$_r" ] && printf '%s%s' "$_up" "$_r" || printf '%s' "${_up%/}"
}

# planned_directory LINK_TEXT TARGET_DIR
# Succeed if LINK_TEXT points at a whole-directory link this run will create.
planned_directory() {
    _link_text=$1 _target_dir=$2
    while IFS= read -r _sd; do
        [ -z "$_sd" ] && continue
        _nested=false
        while IFS= read -r _sd2; do
            [ "$_sd2" = "$_sd" ] && continue
            case "$_sd" in "$_sd2"/*) _nested=true; break ;; esac
        done < "$tmp/symlink-dirs"
        if $_nested; then continue; fi

        if [ "$_sd" = "$src" ]; then
            _sd_target_abs=$tgt_abs
        else
            _sd_rel=${_sd#"$src"/}
            _sd_target_abs=$tgt_abs/$_sd_rel
        fi
        [ "$(relpath "$_sd_target_abs" "$_target_dir")" = "$_link_text" ] && return 0
    done < "$tmp/symlink-dirs"
    return 1
}

# physical_parent PATH
# Physical path of the nearest existing ancestor directory of PATH.
physical_parent() {
    _p="${1%/*}"
    while [ ! -d "$_p" ]; do _p="${_p%/*}"; done
    (cd "$_p" && pwd -P)
}

# confined PATH
# Succeed if PATH sits inside the physical target and outside the physical source. A
# symlinked ancestor would otherwise send reads, writes, and deletes into the source tree
# or out of the target.
confined() {
    _pp="$(physical_parent "$1")"
    case "$_pp/" in "$tgt_phys"/*) ;; *) return 1 ;; esac
    case "$_pp/" in "$src_phys"/*) return 1 ;; esac
    return 0
}

source_relative_path() {
    if [ "$1" = "$src" ]; then
        source_rel=$src
    else
        case "$1" in
            "$src"/*) source_rel=${1#"$src"/} ;;
            *) return 1 ;;
        esac
    fi
    case "/$source_rel/" in
        *"/../"*|*"/./"*) return 1 ;;
    esac
    return 0
}

target="$HOME"; delete=false; dry_run=false; verbose=false; failed=false

while [ $# -gt 0 ]; do
    case "$1" in
        -t|--target)  [ $# -ge 2 ] || usage; shift; target="$1" ;;
        -d|--delete)  delete=true ;;
        --dry-run)    dry_run=true; verbose=true ;;
        -v|--verbose) verbose=true ;;
        --) shift; break ;;
        -*) usage ;;
        *)  break ;;
    esac
    shift
done

[ $# -eq 1 ] || usage

[ -d "$1" ]      || die "source directory $1 is not a directory or does not exist"
[ -d "$target" ] || die "target directory $target is not a directory or does not exist"

# src/tgt: user-supplied strings, used for output paths
# src_abs/tgt_abs: canonical absolute paths, used only for relpath computation
src="${1%/}"
tgt="${target%/}"
src_abs="$(cd "$src" && pwd -P)"
tgt_abs="$(cd "$tgt" && pwd -P)"
src_phys="$src_abs"
tgt_phys="$tgt_abs"

tmp="${TMPDIR:-/tmp}/sym.$$"
mkdir "$tmp" || die 'failed to create temp directory'
trap 'rm -rf "$tmp"' 0
trap 'exit 130' 1 2 3 15

# Enumerate files using Git's ignore rules when src is inside a Git worktree.
# Exclude .sym-dir marker files themselves (their parent dirs are handled in pass 1b).
: > "$tmp/files"
: > "$tmp/symlink-dirs"
: > "$tmp/names"
: > "$tmp/dests"
: > "$tmp/absolute-names"
if git -C "$src" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$src" -c core.quotePath=false ls-files --cached --others --exclude-standard -- . > "$tmp/file-relpaths"
    ! grep -q '^"' "$tmp/file-relpaths" || die "a file name in $src has a character git quotes; rename it"
    while IFS= read -r rel; do
        [ -z "$rel" ] && continue
        case "$rel" in
            .sym-dir)
                printf '%s\n' "$src" >> "$tmp/symlink-dirs"
                ;;
            */.sym-dir)
                dir="${rel%/.sym-dir}"
                printf '%s/%s\n' "$src" "$dir" >> "$tmp/symlink-dirs"
                ;;
            *)
                printf '%s/%s\n' "$src" "$rel" >> "$tmp/files"
                ;;
        esac
    done < "$tmp/file-relpaths"
else
    find "$src" -name '.sym-dir' -type f > "$tmp/sym-dirs"
    while IFS= read -r marker; do
        [ -z "$marker" ] && continue
        dir="${marker%/.sym-dir}"
        printf '%s\n' "$dir" >> "$tmp/symlink-dirs"
    done < "$tmp/sym-dirs"
    find "$src" \( -type f -o -type l \) ! -name '.sym-dir' > "$tmp/files"
fi

# Pass 1: compute jobs and detect conflicts
while IFS= read -r fp; do
    # Skip files inside whole-symlink directories
    if [ -s "$tmp/symlink-dirs" ]; then
        _in_sd=false
        while IFS= read -r sd; do
            case "$fp" in "$sd"/*) _in_sd=true; break ;; esac
        done < "$tmp/symlink-dirs"
        if $_in_sd; then continue; fi
    fi

    if ! source_relative_path "$fp"; then
        printf 'CONFLICT: %s is not a safe source path.\n' "$fp" >> "$tmp/conflicts"
        continue
    fi
    rel=$source_rel
    name="$tgt/$rel"
    # Absolute versions for relpath computation only
    fp_abs="$src_abs/$rel"
    name_abs="$tgt_abs/$rel"
    dir_abs="${name_abs%/*}"

    if [ -L "$fp" ]; then
        dest_abs="$(readlink "$fp")"
        case "$dest_abs" in
            /*) dest="$(relpath "$dest_abs" "$dir_abs")" ;;
            *)  dest="$dest_abs" ;;  # already relative
        esac
    else
        dest="$(relpath "$fp_abs" "$dir_abs")"
    fi

    if ! confined "$name"; then
        printf 'CONFLICT: %s passes through a symlinked directory, so sym will not touch it.\n' "$name" >> "$tmp/conflicts"
        continue
    fi

    if $delete; then
        if { [ -e "$name" ] || [ -L "$name" ]; }; then
            if [ ! -L "$name" ]; then
                printf 'CONFLICT: %s is not a symlink, so refusing to remove.\n' "$name" >> "$tmp/conflicts"
                continue
            fi
            if ! [ "$name" -ef "$fp_abs" ] && [ "$(readlink "$name")" != "$dest" ]; then
                printf 'CONFLICT: %s does not point to the expected destination, so refusing to remove.\n' "$name" >> "$tmp/conflicts"
                continue
            fi
        else
            continue
        fi
    else
        if [ -L "$name" ]; then
            [ "$name" -ef "$fp_abs" ] && continue
            # Same link text as sym would write: correct even when it resolves
            # into the target's own tree rather than the source's.
            if [ "$(readlink "$name")" = "$dest" ]; then
                [ -e "$name" ] && continue
                planned_directory "$dest" "$dir_abs" && continue
            fi
            printf 'CONFLICT: %s already exists. sym cannot create symlinks if there is an existing file.\n' "$name" >> "$tmp/conflicts"
            continue
        elif [ -e "$name" ]; then
            printf 'CONFLICT: %s already exists. sym cannot create symlinks if there is an existing file.\n' "$name" >> "$tmp/conflicts"
            continue
        fi
    fi

    printf '%s\n' "$name" >> "$tmp/names"
    printf '%s\n' "$dest" >> "$tmp/dests"
    printf '%s\n' "$name_abs" >> "$tmp/absolute-names"

done < "$tmp/files"

# Pass 1b: process whole-directory symlinks
while IFS= read -r sd; do
    [ -z "$sd" ] && continue

    # Skip directories that are nested inside another symlink-dir
    _nested=false
    while IFS= read -r sd2; do
        [ "$sd2" = "$sd" ] && continue
        case "$sd" in "$sd2"/*) _nested=true; break ;; esac
    done < "$tmp/symlink-dirs"
    if $_nested; then log "SKIP (nested in another symlink-dir): $sd"; continue; fi

    if ! source_relative_path "$sd"; then
        printf 'CONFLICT: %s is not a safe source path.\n' "$sd" >> "$tmp/conflicts"
        continue
    fi
    rel=$source_rel
    name="$tgt/$rel"
    fp_abs="$src_abs/$rel"
    name_abs="$tgt_abs/$rel"

    if ! confined "$name"; then
        printf 'CONFLICT: %s passes through a symlinked directory, so sym will not touch it.\n' "$name" >> "$tmp/conflicts"
        continue
    fi

    if $delete; then
        { [ -e "$name" ] || [ -L "$name" ]; } || continue
        if [ ! -L "$name" ]; then
            printf 'CONFLICT: %s is not a symlink, so refusing to remove.\n' "$name" >> "$tmp/conflicts"
            continue
        fi
        if ! [ "$name" -ef "$fp_abs" ]; then
            printf 'CONFLICT: %s does not point to the expected destination, so refusing to remove.\n' "$name" >> "$tmp/conflicts"
            continue
        fi
    else
        if [ -L "$name" ]; then
            [ "$name" -ef "$fp_abs" ] && continue
            printf 'CONFLICT: %s already exists. sym cannot create symlinks if there is an existing file.\n' "$name" >> "$tmp/conflicts"
            continue
        elif [ -e "$name" ]; then
            printf 'CONFLICT: %s already exists. sym cannot create symlinks if there is an existing file.\n' "$name" >> "$tmp/conflicts"
            continue
        fi
    fi

    dest="$(relpath "$fp_abs" "${name_abs%/*}")"
    printf '%s\n' "$name" >> "$tmp/names"
    printf '%s\n' "$dest" >> "$tmp/dests"
    printf '%s\n' "$name_abs" >> "$tmp/absolute-names"
done < "$tmp/symlink-dirs"

# Report conflicts
if [ -s "$tmp/conflicts" ]; then
    cat "$tmp/conflicts" >&2
    $dry_run || die "sym will not start until all conflicts are resolved."
fi

$dry_run && printf 'dry-run; the following operations are what would have been executed.\n'

[ -s "$tmp/names" ] || exit 0

# Pass 2: execute
if $delete; then
    while IFS= read -r name; do
        log "UNLINK: $name"
        $dry_run || rm "$name" || failed=true
        if ! $dry_run; then
            dir="${name%/*}"
            while [ "$dir" != "$tgt" ] && [ -d "$dir" ] && [ -z "$(ls -A "$dir")" ]; do
                log "RMDIR: $dir"
                rmdir "$dir" || { failed=true; break; }
                dir="${dir%/*}"
            done
        fi
    done < "$tmp/names"
else
    paste "$tmp/names" "$tmp/dests" "$tmp/absolute-names" > "$tmp/jobs"
    while IFS="$(printf '\t')" read -r name dest name_abs; do
        dir="${name%/*}"
        if [ ! -d "$dir" ]; then
            log "MKDIRS: $dir"
            if ! $dry_run; then
                if ! record_missing_target_dirs "${name_abs%/*}" || ! mkdir -p "$dir"; then
                    failed=true
                    continue
                fi
            fi
        fi
        log "LINK: $name -> $dest"
        if ! $dry_run; then
            if ln -s "$dest" "$name"; then
                record_owned F "$name_abs" || failed=true
            else
                failed=true
            fi
        fi
    done < "$tmp/jobs"
fi

if $failed; then die "sym: some operations failed."; fi
