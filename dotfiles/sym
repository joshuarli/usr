#!/bin/sh
# sym - batch symlinker for dotfiles

die()   { printf '%s\n' "$*" >&2; exit 1; }
usage() { printf 'usage: sym [-t TARGET] [-d] [--dry-run] [-v] [--exclude PATTERN] [--copy PATTERN]... [--sync DIR]... SOURCE\n' >&2; exit 1; }
log()   { if "$verbose"; then printf '%s\n' "$1"; fi; }

# relpath DEST BASE
# Relative path from directory BASE to file DEST (both absolute, no trailing /).
relpath() {
    _d="$1" _b="$2" _up=''
    while [ "$_b" != / ]; do
        case $_d in "$_b"/* | "$_b") break ;; esac
        _up="../$_up"
        _b="${_b%/*}"; [ -z "$_b" ] && _b=/
    done
    if [ "$_b" = / ]; then _r="${_d#/}"; else _r="${_d#"$_b"/}"; fi
    [ -n "$_r" ] && printf '%s%s' "$_up" "$_r" || printf '%s' "${_up%/}"
}

# match_paths < PATTERNS [PATH]...
# Succeed if any PATH matches one of the newline-separated glob patterns on stdin.
match_paths() {
    while IFS= read -r _pat; do
        [ -z "$_pat" ] && continue
        for _p do
            # shellcheck disable=SC2254
            case $_p in $_pat) return 0 ;; esac
        done
    done
    return 1
}

# file_kind PATH
# Print none (absent), file (regular file, not a symlink), or other.
file_kind() {
    if [ -L "$1" ] || { [ -e "$1" ] && [ ! -f "$1" ]; }; then printf other
    elif [ -f "$1" ]; then printf file
    else printf none
    fi
}

# under_sync_dir REL
# Succeed if source-relative path REL is inside a synced directory that the
# source tree contains. Those files are reconciled by the sync pass, not linked.
under_sync_dir() {
    while IFS= read -r _sd; do
        [ -n "$_sd" ] && [ -d "$src/$_sd" ] || continue
        case $1 in "$_sd"/*) return 0 ;; esac
    done < "$tmp/syncs"
    return 1
}

# Defaults
target="$HOME"; delete=false; dry_run=false; verbose=false; excludes=''; copies=''; syncs=''

while [ $# -gt 0 ]; do
    case "$1" in
        -t|--target)  [ $# -ge 2 ] || usage; shift; target="$1" ;;
        -d|--delete)  delete=true ;;
        --dry-run)    dry_run=true; verbose=true ;;
        -v|--verbose) verbose=true ;;
        --exclude)    [ $# -ge 2 ] || usage; shift
                      excludes="${excludes:+${excludes}
}$1" ;;
        --copy)       [ $# -ge 2 ] || usage; shift
                      copies="${copies:+${copies}
}$1" ;;
        --sync)       [ $# -ge 2 ] || usage; shift
                      case $1 in
                          ''|/*|*..*) die "--sync directory $1 must be a relative path without .." ;;
                      esac
                      syncs="${syncs:+${syncs}
}${1%/}" ;;
        --) shift; break ;;
        -*) usage ;;
        *)  break ;;
    esac
    shift
done

[ $# -eq 1 ] || usage

[ -d "$1" ]      || die "source directory $1 is not a directory or does not exist"
[ -d "$target" ] || die "target directory $target is not a directory or does not exist"

# src/tgt: user-supplied strings, used for output paths
# src_abs/tgt_abs: canonical absolute paths, used only for relpath computation
src="${1%/}"
tgt="${target%/}"
src_abs="$(cd "$src" && pwd)"
tgt_abs="$(cd "$tgt" && pwd)"

tmp="${TMPDIR:-/tmp}/sym.$$"
mkdir "$tmp" || die 'failed to create temp directory'
trap 'rm -rf "$tmp"' 0 1 2 3 15

# TEMPORARY EXCEPTIONS: directories kept as real files on both sides and synced
# in both directions instead of symlinked. Agent skills are not followed through
# symlinks, and agents edit the installed copy, so edits must flow back into the
# source tree. A source tree opts in by containing the directory.
# Remove entries here when they no longer need to be managed as copies.
syncs="${syncs:+$syncs
}.agents/skills"
printf '%s\n' "$syncs" > "$tmp/syncs"

# Enumerate files using Git's ignore rules when src is inside a Git worktree.
# Exclude .sym-dir marker files themselves (their parent dirs are handled in pass 1b).
: > "$tmp/files"
: > "$tmp/symlink-dirs"
: > "$tmp/names"
: > "$tmp/dests"
: > "$tmp/copy-names"
: > "$tmp/copy-srcs"
if git -C "$src" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$src" ls-files --cached --others --exclude-standard -- . > "$tmp/file-relpaths"
    while IFS= read -r rel; do
        [ -z "$rel" ] && continue
        case "$rel" in
            .sym-dir)
                printf '%s\n' "$src" >> "$tmp/symlink-dirs"
                ;;
            */.sym-dir)
                dir="${rel%/.sym-dir}"
                printf '%s/%s\n' "$src" "$dir" >> "$tmp/symlink-dirs"
                ;;
            *)
                printf '%s/%s\n' "$src" "$rel" >> "$tmp/files"
                ;;
        esac
    done < "$tmp/file-relpaths"
else
    find "$src" -name '.sym-dir' -type f > "$tmp/sym-dirs"
    while IFS= read -r marker; do
        [ -z "$marker" ] && continue
        dir="${marker%/.sym-dir}"
        printf '%s\n' "$dir" >> "$tmp/symlink-dirs"
    done < "$tmp/sym-dirs"
    find "$src" \( -type f -o -type l \) ! -name '.sym-dir' > "$tmp/files"
fi

# Pass 1: compute jobs and detect conflicts
while IFS= read -r fp; do
    # Filter excluded paths
    if [ -n "$excludes" ] && printf '%s\n' "$excludes" | match_paths "$fp"; then
        log "IGNORE: $fp"
        continue
    fi

    # Skip files inside whole-symlink directories
    if [ -s "$tmp/symlink-dirs" ]; then
        _in_sd=false
        while IFS= read -r sd; do
            case "$fp" in "$sd"/*) _in_sd=true; break ;; esac
        done < "$tmp/symlink-dirs"
        if $_in_sd; then continue; fi
    fi

    rel="${fp#"$src/"}"
    if under_sync_dir "$rel"; then continue; fi
    name="$tgt/$rel"
    # Absolute versions for relpath computation only
    fp_abs="$src_abs/$rel"
    name_abs="$tgt_abs/$rel"
    dir_abs="${name_abs%/*}"

    # Copy exception: matching paths are copied instead of symlinked, so the
    # usual "existing file" conflicts do not apply.
    is_copy=false
    if [ -n "$copies" ] && printf '%s\n' "$copies" | match_paths "$fp_abs" "$name_abs"; then
        is_copy=true
    fi

    if [ -L "$fp" ]; then
        dest_abs="$(readlink "$fp")"
        case "$dest_abs" in
            /*) dest="$(relpath "$dest_abs" "$dir_abs")" ;;
            *)  dest="$dest_abs" ;;  # already relative
        esac
    else
        dest="$(relpath "$fp_abs" "$dir_abs")"
    fi

    if $delete; then
        if $is_copy; then
            { [ -e "$name" ] || [ -L "$name" ]; } || continue
            if [ -L "$name" ] || [ ! -f "$name" ] || ! cmp -s "$name" "$fp_abs"; then
                printf 'CONFLICT: %s is not an identical copy of %s, so refusing to remove.\n' "$name" "$fp_abs" >> "$tmp/conflicts"
                continue
            fi
        elif { [ -e "$name" ] || [ -L "$name" ]; }; then
            if [ ! -L "$name" ]; then
                printf 'CONFLICT: %s is not a symlink, so refusing to remove.\n' "$name" >> "$tmp/conflicts"
                continue
            fi
            if ! [ "$name" -ef "$fp_abs" ] && [ "$(readlink "$name")" != "$dest" ]; then
                printf 'CONFLICT: %s does not point to the expected destination, so refusing to remove.\n' "$name" >> "$tmp/conflicts"
                continue
            fi
        else
            continue
        fi
    else
        if $is_copy; then
            # Copy mode is forceful: the destination is replaced regardless of
            # its current type or contents.
            printf '%s\n' "$name" >> "$tmp/copy-names"
            printf '%s\n' "$fp_abs" >> "$tmp/copy-srcs"
            continue
        fi
        if [ -L "$name" ]; then
            [ "$name" -ef "$fp_abs" ] && continue  # already correct, idempotent
            # Same link text as sym would write: correct even when it resolves
            # into the target's own tree rather than the source's (a symlink to
            # a synced directory, whose target-side copy is not the source dir).
            [ "$(readlink "$name")" = "$dest" ] && continue
            printf 'CONFLICT: %s already exists. sym cannot create symlinks if there is an existing file.\n' "$name" >> "$tmp/conflicts"
            continue
        elif [ -e "$name" ]; then
            printf 'CONFLICT: %s already exists. sym cannot create symlinks if there is an existing file.\n' "$name" >> "$tmp/conflicts"
            continue
        fi
    fi

    printf '%s\n' "$name" >> "$tmp/names"
    printf '%s\n' "$dest" >> "$tmp/dests"

done < "$tmp/files"

# Pass 1b: process whole-directory symlinks
while IFS= read -r sd; do
    [ -z "$sd" ] && continue

    # Skip directories that are nested inside another symlink-dir
    _nested=false
    while IFS= read -r sd2; do
        [ "$sd2" = "$sd" ] && continue
        case "$sd" in "$sd2"/*) _nested=true; break ;; esac
    done < "$tmp/symlink-dirs"
    if $_nested; then log "SKIP (nested in another symlink-dir): $sd"; continue; fi

    rel="${sd#"$src/"}"
    name="$tgt/$rel"
    fp_abs="$src_abs/$rel"
    name_abs="$tgt_abs/$rel"

    # Filter excluded paths
    if [ -n "$excludes" ] && printf '%s\n' "$excludes" | match_paths "$sd"; then
        log "IGNORE: $sd"
        continue
    fi

    # --copy applies to individual files only, not whole-directory symlinks.
    rel="${sd#"$src/"}"
    if [ -n "$copies" ] && printf '%s\n' "$copies" | match_paths "$src_abs/$rel" "$tgt_abs/$rel"; then
        printf 'CONFLICT: %s is a whole-directory symlink; --copy supports individual files only.\n' "$tgt/$rel" >> "$tmp/conflicts"
        continue
    fi

    if $delete; then
        { [ -e "$name" ] || [ -L "$name" ]; } || continue
        if [ ! -L "$name" ]; then
            printf 'CONFLICT: %s is not a symlink, so refusing to remove.\n' "$name" >> "$tmp/conflicts"
            continue
        fi
        if ! [ "$name" -ef "$fp_abs" ]; then
            printf 'CONFLICT: %s does not point to the expected destination, so refusing to remove.\n' "$name" >> "$tmp/conflicts"
            continue
        fi
    else
        if [ -L "$name" ]; then
            [ "$name" -ef "$fp_abs" ] && continue
            printf 'CONFLICT: %s already exists. sym cannot create symlinks if there is an existing file.\n' "$name" >> "$tmp/conflicts"
            continue
        elif [ -e "$name" ]; then
            printf 'CONFLICT: %s already exists. sym cannot create symlinks if there is an existing file.\n' "$name" >> "$tmp/conflicts"
            continue
        fi
    fi

    dest="$(relpath "$fp_abs" "${name_abs%/*}")"
    printf '%s\n' "$name" >> "$tmp/names"
    printf '%s\n' "$dest" >> "$tmp/dests"
done < "$tmp/symlink-dirs"

# Pass 1c: plan synced directories.
# Each synced directory holds a marker file in the target whose mtime is the end
# of the last successful sync. A file that differs between the sides is pushed
# (source -> target) or pulled (target -> source) according to which side changed
# since the marker; if both changed, or no sync is recorded, it is a conflict.
# Deletions do not propagate: a file missing on one side is restored from the
# other, so remove it from both sides (or use --delete) to retire it.
: > "$tmp/sync-ops"
: > "$tmp/sync-dirs"
src_in_git=false
git -C "$src" rev-parse --show-toplevel >/dev/null 2>&1 && src_in_git=true
while IFS= read -r sdir; do
    [ -n "$sdir" ] && [ -d "$src/$sdir" ] || continue
    marker="$tgt/$sdir/.sym-synced"
    printf '%s\n' "$sdir" >> "$tmp/sync-dirs"
    {
        (cd "$src/$sdir" && find . -type f)
        [ -d "$tgt/$sdir" ] && (cd "$tgt/$sdir" && find . -type f)
    } | sed 's|^\./||' | sort -u > "$tmp/sync-rels"
    while IFS= read -r r; do
        [ "${r##*/}" = .sym-synced ] && continue
        s="$src/$sdir/$r"; t="$tgt/$sdir/$r"
        if [ -n "$excludes" ] && printf '%s\n' "$excludes" | match_paths "$s" "$t"; then
            log "IGNORE: $s"
            continue
        fi
        if $src_in_git && git -C "$src" check-ignore -q -- "$sdir/$r"; then continue; fi
        sk="$(file_kind "$s")"; tk="$(file_kind "$t")"

        if $delete; then
            [ "$tk" = none ] && continue
            if [ "$sk" = file ] && [ "$tk" = file ] && cmp -s "$s" "$t"; then
                printf 'UNLINK\t%s\n' "$t" >> "$tmp/sync-ops"
            else
                printf 'CONFLICT: %s is not an identical copy of %s, so refusing to remove.\n' "$t" "$s" >> "$tmp/conflicts"
            fi
            continue
        fi

        if [ "$sk" = other ] || [ "$tk" = other ]; then
            printf 'CONFLICT: %s and %s must both be regular files or absent to sync.\n' "$t" "$s" >> "$tmp/conflicts"
        elif [ "$tk" = none ]; then
            printf 'PUSH\t%s\t%s\n' "$t" "$s" >> "$tmp/sync-ops"
        elif [ "$sk" = none ]; then
            printf 'PULL\t%s\t%s\n' "$s" "$t" >> "$tmp/sync-ops"
        elif ! cmp -s "$s" "$t"; then
            s_changed=false; t_changed=false
            if [ ! -e "$marker" ] || [ "$s" -nt "$marker" ]; then s_changed=true; fi
            if [ ! -e "$marker" ] || [ "$t" -nt "$marker" ]; then t_changed=true; fi
            if $s_changed && ! $t_changed; then
                printf 'PUSH\t%s\t%s\n' "$t" "$s" >> "$tmp/sync-ops"
            elif $t_changed && ! $s_changed; then
                printf 'PULL\t%s\t%s\n' "$s" "$t" >> "$tmp/sync-ops"
            else
                printf 'CONFLICT: %s and %s differ and sync cannot tell which side is newer (both changed since the last sync, or none is recorded).\n' "$t" "$s" >> "$tmp/conflicts"
            fi
        fi
    done < "$tmp/sync-rels"

    # With --delete the marker goes last, after the files it describes.
    if $delete && [ -e "$marker" ]; then printf 'UNLINK\t%s\n' "$marker" >> "$tmp/sync-ops"; fi
done < "$tmp/syncs"

# Report conflicts
if [ -s "$tmp/conflicts" ]; then
    cat "$tmp/conflicts" >&2
    $dry_run || die "sym will not start until all conflicts are resolved."
fi

$dry_run && printf 'dry-run; the following operations are what would have been executed.\n'

# Sync jobs. Copies keep the source mtime (-p), which is never later than the
# marker written afterwards, so a synced file never looks changed since the sync.
while IFS="$(printf '\t')" read -r op dest from; do
    [ -n "$op" ] || continue
    case $op in
        PUSH|PULL)
            dir="${dest%/*}"
            if [ ! -d "$dir" ]; then
                log "MKDIRS: $dir"
                $dry_run || mkdir -p "$dir"
            fi
            log "$op: $dest <- $from"
            $dry_run || cp -p "$from" "$dest"
            ;;
        UNLINK)
            log "UNLINK: $dest"
            if ! $dry_run; then
                rm "$dest"
                dir="${dest%/*}"
                while [ -d "$dir" ] && [ -z "$(ls -A "$dir")" ]; do
                    log "RMDIR: $dir"
                    rmdir "$dir"
                    dir="${dir%/*}"
                done
            fi
            ;;
    esac
done < "$tmp/sync-ops"
if ! $delete && ! $dry_run; then
    while IFS= read -r sdir; do
        mkdir -p "$tgt/$sdir"
        touch "$tgt/$sdir/.sym-synced"
    done < "$tmp/sync-dirs"
fi

[ -s "$tmp/names" ] || [ -s "$tmp/copy-names" ] || exit 0

# Pass 2: execute
if $delete; then
    while IFS= read -r name; do
        log "UNLINK: $name"
        $dry_run || rm "$name"
        if ! $dry_run; then
            dir="${name%/*}"
            while [ -d "$dir" ] && [ -z "$(ls -A "$dir")" ]; do
                log "RMDIR: $dir"
                rmdir "$dir"
                dir="${dir%/*}"
            done
        fi
    done < "$tmp/names"
else
    paste "$tmp/names" "$tmp/dests" > "$tmp/jobs"
    while IFS="$(printf '\t')" read -r name dest; do
        dir="${name%/*}"
        if [ ! -d "$dir" ]; then
            log "MKDIRS: $dir"
            $dry_run || mkdir -p "$dir"
        fi
        log "LINK: $name -> $dest"
        $dry_run || ln -s "$dest" "$name"
    done < "$tmp/jobs"
fi

# Copy jobs: overwrite the destination with the source contents.
if [ -s "$tmp/copy-names" ]; then
    paste "$tmp/copy-names" "$tmp/copy-srcs" > "$tmp/copy-jobs"
    while IFS="$(printf '\t')" read -r name src; do
        dir="${name%/*}"
        if [ ! -d "$dir" ]; then
            log "MKDIRS: $dir"
            $dry_run || mkdir -p "$dir"
        fi
        log "COPY: $name <- $src"
        # Remove first so an existing symlink or directory is replaced, not
        # written through or treated as a copy destination.
        $dry_run || { rm -rf "$name"; cp "$src" "$name"; }
    done < "$tmp/copy-jobs"
fi
