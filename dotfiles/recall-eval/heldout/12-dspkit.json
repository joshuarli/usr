   "project": "dspkit",
   "harness": "claude",
   "age_days": 61,
   "turns": [
    {
     "user": "Compressor release stage eats the CPU on quiet passages."
    },
    {
     "tool": {
      "cmd": "perf record -g ./bench_comp --quiet && perf report --stdio | head -n 12",
      "output": "    71.2%  bench_comp  [.] Compressor::process\n     3.0%  bench_comp  [.] fftw_execute",
      "exit": 0
     }
    },
    {
     "assistant": "Same cause as the other filters: denormals in the feedback path. engine_init sets _MM_SET_FLUSH_ZERO_MODE only for the main thread; the worker threads need to call it as well on thread start."
    },
    {
     "tool": {
      "cmd": "./bench_comp --quiet",
      "output": "comp: 2.4% cpu (quiet)",
      "exit": 0
     }
    }
   ],
