{
  "name": "pi-muse-subscription",
  "version": "0.1.0",
  "description": "Meta Muse models in pi through the Muse Code SDK on your Muse Code subscription, with pi's own agent loop, tools and prompt.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "provider",
    "muse",
    "muse-code",
    "meta"
  ],
  "license": "MIT",
  "author": "Jarno Keskikangas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkeskikangas/pi-muse-subscription.git"
  },
  "homepage": "https://github.com/jkeskikangas/pi-muse-subscription#readme",
  "bugs": {
    "url": "https://github.com/jkeskikangas/pi-muse-subscription/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-timeout 20000 test/unit.test.ts test/prompt.test.ts",
    "test:host": "node --experimental-strip-types --test --test-concurrency=1 --test-timeout 120000 --test-force-exit test/host.test.ts",
    "test:e2e": "node --experimental-strip-types test/pi-e2e.ts",
    "test:live": "PI_MUSE_SDK_LIVE=1 node --experimental-strip-types --test --test-force-exit --test-timeout 300000 test/live.test.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@muse-code/sdk": "1.4.14"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^26.6.4",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2"
  }
}
