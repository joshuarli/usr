#!/bin/sh
case $1 in *playlist*) echo "Use mpdl for playlists." ;; esac

exec uvx --refresh-package yt-dlp --from 'yt-dlp@git+https://github.com/yt-dlp/yt-dlp' yt-dlp --ignore-config \
    --remote-components 'ejs:github' \
    --js-runtimes node:/opt/homebrew/bin/node \
    -f 'ba' \
    --add-metadata \
    -o '%(title)s [%(id)s].%(ext)s' "$@"
